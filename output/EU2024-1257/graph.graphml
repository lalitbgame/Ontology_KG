      <data key="d73">Regulation (EC) No 595/2009</data>
      <data key="d74">Regulation (EC) No 715/2007 is repealed with effect from 1 July 2030. Regulation (EC) No 595/2009 is repealed with effect from 1 July 2031.</data>
      <data key="d75">direct</data>
    </edge>
    <edge source="EU2024-1257.ART-20.1" target="EU2024-1257/EXT:EC.REG.595-2009" id="1">
