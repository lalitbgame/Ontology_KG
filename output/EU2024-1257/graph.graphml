    <edge source="EU2024-1257.ANNEX-III" target="EU2024-1257/EXT:UNR-168" id="1">
      <data key="d71">CITES</data>
      <data key="d72">requirement_source</data>
      <data key="d73">UN Regulation No 168</data>
      <data key="d74">For RDE tests conducted on the road, UN Regulation No 168 (**) shall apply, with emissions evaluation fulfilled with respect to the 4-phase WLTP.</data>
      <data key="d75">table</data>
    </edge>
