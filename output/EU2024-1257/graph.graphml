    <edge source="EU2024-1257.ART-4.3" target="EU2024-1257/EXT:UNR-168" id="0">
      <data key="d71">CITES</data>
      <data key="d72">cites</data>
      <data key="d73">UN Regulation No 168 (25)</data>
      <data key="d74">Where applicable, when manufacturers, national authorities, Commission or recognised third parties are verifying compliance with the exhaust emission limits, where the testing is performed in extended driving conditions, the emissions shall be divided by the extended driving divider set out in UN Regulation No 168 (25).</data>
      <data key="d75">direct</data>
    </edge>
