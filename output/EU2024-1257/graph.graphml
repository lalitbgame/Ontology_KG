      <data key="d71">CITES</data>
      <data key="d72">requirement_source</data>
      <data key="d73">paragraph 7.2.1. of Annex 4 to UN Regulation No 49 (24)</data>
      <data key="d74">‘WHTC’ means the worldwide harmonised transient driving cycle in accordance with paragraph 7.2.1. of Annex 4 to UN Regulation No 49 (24);</data>
      <data key="d75">direct</data>
    </edge>
    <edge source="EU2024-1257.ART-3.PT-23" target="EU2024-1257/EXT:UNR-49" id="0">
