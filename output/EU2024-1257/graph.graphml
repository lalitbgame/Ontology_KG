    <edge source="EU2024-1257.ART-3.PT-75" target="EU2024-1257/EXT:UNR-117" id="0">
      <data key="d71">CITES</data>
      <data key="d72">cites</data>
      <data key="d73">UN Regulation No 117</data>
      <data key="d74">‘ice grip tyre’ means a C1 class snow tyre for use in severe snow conditions, that is additionally designed to be used on road surfaces covered with ice and that fulfils the requirements provided for in UN Regulation No 117;</data>
      <data key="d75">direct</data>
    </edge>
