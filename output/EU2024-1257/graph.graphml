    <edge source="EU2024-1257.RECITAL-8" target="EU2024-1257/EXT:EU.REG.2018-858#ANNEX-II" id="0">
      <data key="d71">CITES</data>
      <data key="d72">cites</data>
      <data key="d73">Annex II to Regulation (EU) 2018/858</data>
      <data key="d74">This Regulation is a separate regulatory act for the purposes of the EU type-approval procedure laid down in Annex II to Regulation (EU) 2018/858.</data>
      <data key="d75">direct</data>
    </edge>
    <edge source="EU2024-1257.RECITAL-8" target="EU2024-1257/EXT:EU.REG.2018-858" id="0">
      <data key="d71">CITES</data>
      <data key="d72">cites</data>
      <data key="d73">Regulation (EU) 2018/858</data>
      <data key="d74">The administrative provisions of Regulation (EU) 2018/858, including the provisions on penalties, as well as its robust compliance enforcement mechanism, are fully applicable.</data>
      <data key="d75">direct</data>
    </edge>
