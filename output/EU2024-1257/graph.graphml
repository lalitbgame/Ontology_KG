      <data key="d72">cites</data>
      <data key="d73">Regulation (EU) 2019/2144</data>
      <data key="d74">Regulation (EU) 2019/2144 of the European Parliament and of the Council (11) regulates gear shift indicators (GSI), whose main purpose is to minimise fuel consumption of a vehicle when a driver follows its indications.</data>
      <data key="d75">direct</data>
    </edge>
