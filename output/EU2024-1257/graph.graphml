      <data key="d17">Point</data>
      <data key="d18">point</data>
      <data key="d19">EU2024-1257.ART-3</data>
      <data key="d20">18</data>
      <data key="d21">3</data>
      <data key="d22">9</data>
      <data key="d23">9</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">‘total hydrocarbons’ or ‘THC’ means the total hydrocarbons emitted from the tailpipe;</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Point", "Paragraph"]</data>
      <data key="d27">18</data>
      <data key="d29">ART-3</data>
    </node>
    <node id="EU2024-1257.ART-3.PT-19">
      <data key="d0">Point</data>
      <data key="d1">EU2024-1257</data>
      <data key="d17">Point</data>
      <data key="d18">point</data>
      <data key="d19">EU2024-1257.ART-3</data>
      <data key="d20">19</data>
      <data key="d21">3</data>
      <data key="d22">9</data>
      <data key="d23">9</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">‘non-methane hydrocarbons’ or ‘NMHC’ means the total hydrocarbons, excluding methane, emitted from the tailpipe;</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Point", "Paragraph"]</data>
      <data key="d27">19</data>
      <data key="d29">ART-3</data>
    </node>
    <node id="EU2024-1257.ART-3.PT-20">
