      <data key="d71">CITES</data>
      <data key="d72">requirement_source</data>
      <data key="d73">paragraph 7.2.2. of Annex 4 to UN Regulation No 49</data>
      <data key="d74">‘WHSC’ means the worldwide harmonised steady state driving cycle in accordance with paragraph 7.2.2. of Annex 4 to UN Regulation No 49;</data>
      <data key="d75">direct</data>
