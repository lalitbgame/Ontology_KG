    <edge source="EU2024-1257.ART-3.PT-38" target="EU2024-1257/EXT:EU.REG.2018-858#ART-3.PT-49" id="0">
      <data key="d71">CITES</data>
      <data key="d72">definition_source</data>
      <data key="d73">Article 3, point 49, of Regulation (EU) 2018/858</data>
      <data key="d74">‘on-board diagnostic system’ or ‘OBD system’ means a system on board a vehicle that can generate vehicle on-board diagnostic (OBD) information, as defined in Article 3, point 49, of Regulation (EU) 2018/858 and is capable of communicating that information off-board;</data>
      <data key="d75">direct</data>
    </edge>
