    <edge source="EU2024-1257.RECITAL-41" target="EU2024-1257/EXT:EU.REG.2016-679" id="0">
      <data key="d71">CITES</data>
      <data key="d72">requirement_source</data>
      <data key="d73">Regulations (EU) 2016/679 (21)</data>
      <data key="d74">Whenever the measures provided for in this Regulation entail the processing of personal data, that processing should be carried out in accordance with Regulations (EU) 2016/679 (21) and (EU) 2018/1725 (22) of the European Parliament and of the Council, as well as the relevant national law in accordance with those Regulations.</data>
