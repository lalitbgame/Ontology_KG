    <edge source="EU2024-1257.RECITAL-3" target="EU2024-1257/EXT:EU.REG.2018-858" id="0">
      <data key="d71">CITES</data>
      <data key="d72">cites</data>
      <data key="d73">Regulation (EU) 2018/858</data>
      <data key="d74">To that end, Regulation (EU) 2018/858 of the European Parliament and of the Council (8) introduced a comprehensive type-approval and market surveillance system for motor vehicles and trailers, and for systems, components and separate technical units intended for such vehicles.</data>
      <data key="d75">direct</data>
    </edge>
    <edge source="EU2024-1257.RECITAL-3" target="EU2024-1257/EXT:EU.REG.2018-858" id="1">
