    <node id="EU2024-1257.DEF:ART-3.PT-1">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">emission type-approval</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">an EU type-approval complying with the administrative provisions and technical requirements of this Regulation as regards CO2 and pollutant emissions, fuel and electric energy consumption and battery durability;</data>
      <data key="d34">EU2024-1257.ART-3.PT-1</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-2">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">granting type-approval authority</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the approval authority that grants the emission type approval;</data>
      <data key="d34">EU2024-1257.ART-3.PT-2</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-3">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">conformity of production</data>
      <data key="d31">CoP</data>
      <data key="d32">means</data>
      <data key="d33">the activities carried out on new vehicles, separate technical units or components selected at the manufacturer’s premises to ensure that the products placed on the market comply with the requirements set out in this Regulation;</data>
      <data key="d34">EU2024-1257.ART-3.PT-3</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-4">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">in-service conformity</data>
      <data key="d31">ISC</data>
      <data key="d32">means</data>
      <data key="d33">the activities carried out on vehicles in circulation, systems, separate technical units or components with the purpose of verifying compliance with the durability requirements set out in this Regulation;</data>
      <data key="d34">EU2024-1257.ART-3.PT-4</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-5">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">engine</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the internal combustion engine of a vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-5</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-6">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the exhaust and non-exhaust emissions of a motor vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-6</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-7">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">exhaust emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the emission from the tailpipe of the motor vehicle or engine of all of the following: CO2, gaseous, solid, liquid compounds and crankcase emissions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-7</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-8">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">gaseous pollutants</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the emissions of gaseous chemical species, excluding CO2;</data>
      <data key="d34">EU2024-1257.ART-3.PT-8</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-9">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">CO2</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the carbon dioxide emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-9</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-10">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">nitrogen oxides</data>
      <data key="d31">NOx</data>
      <data key="d32">means</data>
      <data key="d33">the sum of nitric oxide (NO) and nitrogen dioxide (NO2) emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-10</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-11">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">nitrous oxide</data>
      <data key="d31">N2O</data>
      <data key="d32">means</data>
      <data key="d33">nitrous oxide emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-11</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-12">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">particulate matter</data>
      <data key="d31">PM</data>
      <data key="d32">means</data>
      <data key="d33">any material emitted from the tailpipe or the brakes and collected on a filter media;</data>
      <data key="d34">EU2024-1257.ART-3.PT-12</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-13">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">particulate matter less than 10 μm</data>
      <data key="d31">PM10</data>
      <data key="d32">means</data>
      <data key="d33">the particulate matter with a diameter of less than 10 μm;</data>
      <data key="d34">EU2024-1257.ART-3.PT-13</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-14">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">particle number</data>
      <data key="d31">PN</data>
      <data key="d32">means</data>
      <data key="d33">the total number of solid particles emitted from the tailpipe or the brakes;</data>
      <data key="d34">EU2024-1257.ART-3.PT-14</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-15">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">PN10</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the total number of solid particles emitted from the tailpipe or the brakes that have a diameter larger or equal to 10 nm;</data>
      <data key="d34">EU2024-1257.ART-3.PT-15</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-16">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">carbon monoxide</data>
      <data key="d31">CO</data>
      <data key="d32">means</data>
      <data key="d33">the carbon monoxide emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-16</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-17">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">methane</data>
      <data key="d31">CH4</data>
      <data key="d32">means</data>
      <data key="d33">the methane emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-17</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-18">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">total hydrocarbons</data>
      <data key="d31">THC</data>
      <data key="d32">means</data>
      <data key="d33">the total hydrocarbons emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-18</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-19">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">non-methane hydrocarbons</data>
      <data key="d31">NMHC</data>
      <data key="d32">means</data>
      <data key="d33">the total hydrocarbons, excluding methane, emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-19</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-20">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">non-methane organic gases</data>
      <data key="d31">NMOG</data>
      <data key="d32">means</data>
      <data key="d33">the sum of non-oxygenated and oxygenated hydrocarbons, excluding methane, emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-20</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-21">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">ammonia</data>
      <data key="d31">NH3</data>
      <data key="d32">means</data>
      <data key="d33">the ammonia emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-21</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-22">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">formaldehyde</data>
      <data key="d31">HCHO</data>
      <data key="d32">means</data>
      <data key="d33">the formaldehyde emitted from the tailpipe;</data>
      <data key="d34">EU2024-1257.ART-3.PT-22</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-23">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">WHTC</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the worldwide harmonised transient driving cycle in accordance with paragraph 7.2.1. of Annex 4 to UN Regulation No 49 (24);</data>
      <data key="d34">EU2024-1257.ART-3.PT-23</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-24">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">WHSC</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the worldwide harmonised steady state driving cycle in accordance with paragraph 7.2.2. of Annex 4 to UN Regulation No 49;</data>
      <data key="d34">EU2024-1257.ART-3.PT-24</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-25">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">electric energy consumption</data>
      <data key="d31" />
      <data key="d32">is</data>
      <data key="d33">the rate at which a vehicle uses electric energy from its traction battery or batteries under specified conditions of use;</data>
      <data key="d34">EU2024-1257.ART-3.PT-25</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-26">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">fuel consumption</data>
      <data key="d31" />
      <data key="d32">is</data>
      <data key="d33">the rate at which a vehicle uses fuel under specified conditions of use;</data>
      <data key="d34">EU2024-1257.ART-3.PT-26</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-27">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">vehicle energy consumption calculation tool</data>
      <data key="d31">VECTO</data>
      <data key="d32">means</data>
      <data key="d33">a simulation tool used in determining CO2 emissions, fuel consumption, electric energy consumption and the electric range from heavy-duty vehicles;</data>
      <data key="d34">EU2024-1257.ART-3.PT-27</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-28">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">evaporative emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the hydrocarbon vapours emitted from the fuel system of a vehicle, excluding those from exhaust emissions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-28</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-29">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">crankcase emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the gaseous pollutants from the spaces in, or external to, an engine which are connected to the oil sump by internal or external ducts;</data>
      <data key="d34">EU2024-1257.ART-3.PT-29</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-30">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">brake particle emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the particles emitted from the brake system of a vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-30</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-31">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">tyre abrasion</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the mass of material lost from the tyre due to the abrasion process and emitted into the environment;</data>
      <data key="d34">EU2024-1257.ART-3.PT-31</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-32">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">non-exhaust emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">evaporative, tyre abrasion and brake emissions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-32</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-33">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">pollutant emissions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">exhaust and non-exhaust emissions other than CO2 emissions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-33</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-34">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">pollution control device</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a device of a vehicle that controls or limits pollutant emissions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-34</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-35">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">pollution control systems</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the pollution control devices installed in a vehicle, including all control units and software that govern their use;</data>
      <data key="d34">EU2024-1257.ART-3.PT-35</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-36">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">original pollution control systems</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a pollution control system or an assembly of such systems covered by the type-approval granted for the vehicle concerned;</data>
      <data key="d34">EU2024-1257.ART-3.PT-36</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-37">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">replacement pollution control systems</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a pollution control system or an assembly of such systems which is intended to replace an original pollution control system and which can be approved as a separate technical unit;</data>
      <data key="d34">EU2024-1257.ART-3.PT-37</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-38">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">on-board diagnostic system</data>
      <data key="d31">OBD system</data>
      <data key="d32">means</data>
      <data key="d33">a system on board a vehicle that can generate vehicle on-board diagnostic (OBD) information, as defined in Article 3, point 49, of Regulation (EU) 2018/858 and is capable of communicating that information off-board;</data>
      <data key="d34">EU2024-1257.ART-3.PT-38</data>
      <data key="d35">True</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-39">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">on-board monitoring system</data>
      <data key="d31">OBM system</data>
      <data key="d32">means</data>
      <data key="d33">a system on board a vehicle that is capable of monitoring exhaust emissions, detecting exhaust emission exceedances and capable of communicating that information together with the state-of-health information off-board;</data>
      <data key="d34">EU2024-1257.ART-3.PT-39</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-40">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">on-board fuel and electric energy consumption monitoring device</data>
      <data key="d31">OBFCM device</data>
      <data key="d32">means</data>
      <data key="d33">any software or hardware on board a vehicle that detects and uses vehicle, engine, fuel or electric energy and payload/mass parameters to determine and store in the vehicle the fuel and electric energy consumption data and other parameters relevant in determining the fuel or electric energy consumption and energy efficiency of the vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-40</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-41">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">manipulation device</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">any element of design that results in a vehicle not complying with the requirements of this Regulation when driven but not under a regulatory test, despite it resulting in the vehicle appearing to be compliant when tested, or that manipulates data related to sensors, fuel or electric energy consumption, electric range or battery durability;</data>
      <data key="d34">EU2024-1257.ART-3.PT-41</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-42">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">manipulation strategy</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a strategy that results in a vehicle not complying with the requirements of this Regulation when driven but not under regulatory test, despite it resulting in the vehicle appearing to be compliant when tested, or that manipulates data related to sensors, fuel or electric energy consumption, electric range or battery durability;</data>
      <data key="d34">EU2024-1257.ART-3.PT-42</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-43">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">real-driving emissions</data>
      <data key="d31">RDE</data>
      <data key="d32">means</data>
      <data key="d33">the emissions of a vehicle under the conditions specified in Tables 1 and 2 of Annex III;</data>
      <data key="d34">EU2024-1257.ART-3.PT-43</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-44">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">odometer</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">an instrument indicating the total distance driven by the vehicle since its production;</data>
      <data key="d34">EU2024-1257.ART-3.PT-44</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-45">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">tampering</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the inactivation, or modification of the engine or electric motor, vehicle pollution control devices and system, propulsion system, traction battery, odometer, OBFCM device, OBD or OBM system, including any software or other logical control elements of those systems and their data, resulting in the vehicle not complying with this Regulation;</data>
      <data key="d34">EU2024-1257.ART-3.PT-45</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-46">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">own production facility</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a manufacturing or assembly plant used by the manufacturer for the purpose of manufacturing or assembling new vehicles for that manufacturer, including, where relevant, vehicles which are intended for export;</data>
      <data key="d34">EU2024-1257.ART-3.PT-46</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-47">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">own design centre</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a facility in which the whole vehicle is designed and developed, and which is under the control and use of the manufacturer;</data>
      <data key="d34">EU2024-1257.ART-3.PT-47</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-48">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">small-volume manufacturer</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a manufacturer of fewer than 10 000 new motor vehicles of category M_1, or 22 000 new motor vehicles of category N_1, or 450 new motor vehicles of categories M2 and M3 combined, or 6 000 new motor vehicles of categories N2 and N3 combined, that are registered in the Union each calendar year, and which: (a) is not part of a group of connected manufacturers; or (b) is part of a group of connected manufacturers that is responsible in total for fewer than 10 000 new motor vehicles of category M1, or 22 000 new motor vehicles of category N1, or 450 new motor vehicles of categories M2 and M3 combined, or 6 000 new motor vehicles of categories N2 and N3 combined, that are registered in the Union each calendar year; or (c) is part of a group of connected manufacturers but operates its own production facilities and own design centre;</data>
      <data key="d34">EU2024-1257.ART-3.PT-48</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-49">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">ultra-small-volume manufacturer</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a small-volume manufacturer that produces fewer than 1 000 new motor vehicles of category M1 or fewer than 1 000 new motor vehicles of category N1 that are registered in the Union in the previous calendar year;</data>
      <data key="d34">EU2024-1257.ART-3.PT-49</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-50">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">pure internal combustion engine vehicle</data>
      <data key="d31">ICEV</data>
      <data key="d32">means</data>
      <data key="d33">a vehicle where all of the propulsion energy converters are internal combustion engines, including hydrogen powered ones;</data>
      <data key="d34">EU2024-1257.ART-3.PT-50</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-51">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">pure electric vehicle</data>
      <data key="d31">PEV</data>
      <data key="d32">means</data>
      <data key="d33">a vehicle equipped with a powertrain containing exclusively electric machines as propulsion energy converters and exclusively rechargeable electric energy storage systems as propulsion energy storage systems;</data>
      <data key="d34">EU2024-1257.ART-3.PT-51</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-52">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">fuel cell</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">an energy converter transforming chemical energy (input) into electrical energy (output) or vice versa;</data>
      <data key="d34">EU2024-1257.ART-3.PT-52</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-53">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">fuel cell vehicle</data>
      <data key="d31">FCV</data>
      <data key="d32">means</data>
      <data key="d33">a vehicle equipped with a powertrain containing exclusively fuel cell(s) and electric machine(s) as propulsion energy converter(s);</data>
      <data key="d34">EU2024-1257.ART-3.PT-53</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-54">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">fuel cell hybrid vehicle</data>
      <data key="d31">FCHV</data>
      <data key="d32">means</data>
      <data key="d33">a fuel cell vehicle equipped with a powertrain containing at least one fuel storage system and at least one rechargeable electric energy storage system as propulsion energy storage systems;</data>
      <data key="d34">EU2024-1257.ART-3.PT-54</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-55">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">hybrid vehicle</data>
      <data key="d31">HV</data>
      <data key="d32">means</data>
      <data key="d33">a vehicle equipped with a powertrain containing at least two different categories of propulsion energy converters and at least two different categories of propulsion energy storage systems;</data>
      <data key="d34">EU2024-1257.ART-3.PT-55</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-56">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">hybrid electric vehicle</data>
      <data key="d31">HEV</data>
      <data key="d32">means</data>
      <data key="d33">a hybrid vehicle where one of the propulsion energy converters is an electric machine;</data>
      <data key="d34">EU2024-1257.ART-3.PT-56</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-57">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">off-vehicle charging hybrid electric vehicle</data>
      <data key="d31">OVC-HEV</data>
      <data key="d32">means</data>
      <data key="d33">a hybrid electric vehicle that can be charged from an external source;</data>
      <data key="d34">EU2024-1257.ART-3.PT-57</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-58">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">not off-vehicle charging hybrid electric vehicle</data>
      <data key="d31">NOVC-HEV</data>
      <data key="d32">means</data>
      <data key="d33">a vehicle with at least two different energy converters and two different energy storage systems that are used for the purpose of vehicle propulsion and that cannot be charged from an external source;</data>
      <data key="d34">EU2024-1257.ART-3.PT-58</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-59">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">geofencing technologies</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">technologies that do not allow a hybrid vehicle to run with the use of the internal combustion engine, i.e. to enable zero-emission mode, when driven inside a specific geographic area;</data>
      <data key="d34">EU2024-1257.ART-3.PT-59</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-60">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">zero-emission mode</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a selectable mode, whereby a hybrid vehicle is driven without the use of the internal combustion engine;</data>
      <data key="d34">EU2024-1257.ART-3.PT-60</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-61">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">mass in running order</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the mass of the vehicle, with its fuel tank(s) filled to at least 90 per cent of their capacities, including the mass of the driver, fuel and liquids, fitted with the standard equipment in accordance with the manufacturer’s specifications and, when they are fitted, the mass of the bodywork, the cabin, the coupling and the spare wheels as well as the tools;</data>
      <data key="d34">EU2024-1257.ART-3.PT-61</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-62">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">traction battery</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a battery system that stores energy with the main purpose of propelling the vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-62</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-63">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">electric range</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the distance travelled in charge-depleting operation condition until the traction battery is depleted;</data>
      <data key="d34">EU2024-1257.ART-3.PT-63</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-64">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">zero-emission range</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the maximum distance a vehicle can travel with zero exhaust emissions, which for PEVs corresponds to the electric range;</data>
      <data key="d34">EU2024-1257.ART-3.PT-64</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-65">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">durability</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the ability of a system or device, component or any part of the vehicle to maintain its required performance over a given time;</data>
      <data key="d34">EU2024-1257.ART-3.PT-65</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-66">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">battery durability</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">in-vehicle durability of a traction battery measured in terms of its state of health;</data>
      <data key="d34">EU2024-1257.ART-3.PT-66</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-67">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">state of health</data>
      <data key="d31">SOH</data>
      <data key="d32">means</data>
      <data key="d33">the measured or estimated state of a specific performance metric of a vehicle or traction battery at a specific point in its lifetime, expressed as a percentage of the performance that was determined when certified or new;</data>
      <data key="d34">EU2024-1257.ART-3.PT-67</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-68">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">environmental vehicle passport</data>
      <data key="d31">EVP</data>
      <data key="d32">means</data>
      <data key="d33">a record in digital form that contains information on the environmental performance of a vehicle at the moment of registration, including the level of pollutant emission limits, CO2 emissions, fuel consumption, electric energy consumption, electric range and engine or electric motor power, and battery durability and other related values;</data>
      <data key="d34">EU2024-1257.ART-3.PT-68</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-69">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">excess exhaust emissions driver warning system</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a system designed, constructed and installed in a vehicle to provide information to the user about excess exhaust emissions and to ensure repairs before further use;</data>
      <data key="d34">EU2024-1257.ART-3.PT-69</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-70">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">low-reagent driver warning system</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a system designed, constructed and installed in a vehicle to warn the user of the low level of the consumable reagent and to ensure the use of the reagent;</data>
      <data key="d34">EU2024-1257.ART-3.PT-70</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-71">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">declaration of compliance</data>
      <data key="d31">declaration</data>
      <data key="d32">means</data>
      <data key="d33">a declaration by the manufacturer that a specific type or group of vehicles, component or separate technical unit is in compliance with the requirements of this Regulation;</data>
      <data key="d34">EU2024-1257.ART-3.PT-71</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-72">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">energy efficiency of a trailer</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">the performance of a trailer with regard to its influence on the CO2 emissions, fuel and electric energy consumption, zero-emission range, electric range and engine or electric motor power of a towing motor vehicle;</data>
      <data key="d34">EU2024-1257.ART-3.PT-72</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-73">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">snow tyre</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a tyre whose tread pattern, tread compound or construction is primarily designed to achieve in mud and snow conditions a performance better than that of a normal tyre with regard to its ability to initiate and control vehicle motion;</data>
      <data key="d34">EU2024-1257.ART-3.PT-73</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-74">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">tyre for use in severe snow conditions</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a snow tyre or a special use tyre whose tread pattern, tread compound or structure is specifically designed to be used in severe snow conditions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-74</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-75">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">ice grip tyre</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a C1 class snow tyre for use in severe snow conditions, that is additionally designed to be used on road surfaces covered with ice and that fulfils the requirements provided for in UN Regulation No 117;</data>
      <data key="d34">EU2024-1257.ART-3.PT-75</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-76">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">special use tyre</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a tyre intended for mixed use both on- and off-road or for other special duty and that is primarily designed to initiate and maintain the vehicle in motion in off-road conditions;</data>
      <data key="d34">EU2024-1257.ART-3.PT-76</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
    <node id="EU2024-1257.DEF:ART-3.PT-77">
      <data key="d0">Definition</data>
      <data key="d1">EU2024-1257</data>
      <data key="d30">option</data>
      <data key="d31" />
      <data key="d32">means</data>
      <data key="d33">a set of additional requirements laid down in this Regulation, which manufacturers may choose to comply with in order to be able to use the corresponding designation for the vehicles they manufacture.</data>
      <data key="d34">EU2024-1257.ART-3.PT-77</data>
      <data key="d35">False</data>
      <data key="d36">EU2024-1257.ART-3</data>
      <data key="d28">True</data>
    </node>
