    <edge source="EU2024-1257.ART-14.7" target="EU2024-1257/EXT:EU.REG.2017-1151" id="0">
      <data key="d71">CITES</data>
      <data key="d72">requirement_source</data>
      <data key="d73">Regulation (EU) 2017/1151</data>
      <data key="d74">For implementing acts referred to in paragraphs 3 and 4 of this Article, as regards categories M1 and N1, the methods for measuring pollutant exhaust emissions and evaporative emissions shall reflect those laid down in Regulation (EU) 2017/1151, as applicable at the moment of adoption of the relevant implementing act.</data>
