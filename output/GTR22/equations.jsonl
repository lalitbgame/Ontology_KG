{"region_id": "p17-r1", "unit_id": "GTR22.BODY.6.3.2", "page": 17, "bbox": [192.1, 677.3, 349.1, 703.0], "source": "text_layer", "inline": false, "context_before": "per cent.", "condition": null, "glossary": [], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "SOCE_measured=(UBE_measured)/(UBE_certified)*100", "latex": "SOCE_{measured}=\\frac{UBE_{measured}}{UBE_{certified}} \\cdot 100", "lhs": "SOCE_measured", "symbols": ["SOCE_measured", "UBE_measured", "UBE_certified"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑆𝑂𝐶𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑 ∗100", "id": "GTR22.BODY.6.3.2.EQ-1", "image_path": "equations/GTR22.BODY.6.3.2.EQ-1.png", "depends_on": ["GTR22.ANNEX-3.2.1.2.EQ-1", "GTR22.ANNEX-3.3.1.1.EQ-1", "GTR22.ANNEX-3.3.1.2.EQ-1"]}
{"region_id": "p17-r2", "unit_id": "GTR22.BODY.6.3.2", "page": 17, "bbox": [187.1, 715.1, 353.9, 740.8], "source": "text_layer", "inline": false, "context_before": "UBE_certified ∗100", "condition": null, "glossary": [], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "SOCR_measured=(Range_measured)/(Range_certified)*100", "latex": "SOCR_{measured}=\\frac{Range_{measured}}{Range_{certified}} \\cdot 100", "lhs": "SOCR_measured", "symbols": ["SOCR_measured", "Range_measured", "Range_certified"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑆𝑂𝐶𝑅𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= 𝑅𝑎𝑛𝑔𝑒𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 ∗100 𝑅𝑎𝑛𝑔𝑒𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑", "id": "GTR22.BODY.6.3.2.EQ-2", "image_path": "equations/GTR22.BODY.6.3.2.EQ-2.png", "depends_on": []}
{"region_id": "p18-r1", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [170.1, 269.7, 301.5, 284.3], "source": "text_layer", "inline": false, "context_before": "calculated:", "condition": null, "glossary": [{"symbol": "SOC_read,i", "symbol_text": "SOC_read,i", "description": "the on-board SOCR/SOCE read from the vehicle i ; and", "unit": null}, {"symbol": "SOC_measured,i", "symbol_text": "SOC_measured,i", "description": "the measured SOCR/SOCE of the vehicle i.", "unit": null}], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "equation", "linear": "x_i=SOC_{read,i}-SOC_{measured,i}", "latex": "x_{i}=SOC_{read,i}-SOC_{measured,i}", "lhs": "x_i", "symbols": ["x_i", "SOC_read,i", "SOC_measured,i"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑥𝑖= 𝑆𝑂𝐶𝑟𝑒𝑎𝑑,𝑖−𝑆𝑂𝐶𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑,𝑖", "id": "GTR22.BODY.6.3.3.EQ-1", "image_path": "equations/GTR22.BODY.6.3.3.EQ-1.png", "depends_on": []}
{"region_id": "p18-r2", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [254.8, 387.5, 397.2, 412.2], "source": "text_layer", "inline": false, "context_before": "x_1, x_2, ... x_N, the average X_tests and the standard deviation s shall be determined:", "condition": null, "glossary": [], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "equation", "linear": "X_tests=((x_1+ x_2+ x_3+ ...+ x_N))/(N)", "latex": "X_{tests}=\\frac{(x_{1}+ x_{2}+ x_{3}+ \\dots + x_{N})}{N}", "lhs": "X_tests", "symbols": ["X_tests", "x_1", "x_2", "x_3", "x_N", "N"], "outcome": null, "parse_status": "parsed", "raw_text": "(𝑥1 + 𝑥2 + 𝑥3 + ⋯+ 𝑥𝑁) 𝑋𝑡𝑒𝑠𝑡𝑠= 𝑁", "id": "GTR22.BODY.6.3.3.EQ-2", "image_path": "equations/GTR22.BODY.6.3.3.EQ-2.png", "depends_on": []}
{"region_id": "p18-r3", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [170.1, 439.2, 407.4, 466.6], "source": "text_layer", "inline": false, "context_before": "and", "condition": null, "glossary": [], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "equation", "linear": "s=sqrt(((x_1-X_tests)^{2}+ (x_2-X_tests)^{2}+. . . +(x_N-X_tests)^{2})/(N-1))", "latex": "s=\\sqrt{\\frac{(x_{1}-X_{tests})^{2}+ (x_{2}-X_{tests})^{2}+. . . +(x_{N}-X_{tests})^{2}}{N-1}}", "lhs": "s", "symbols": ["s", "x_1-X_tests", "x_2-X_tests", "x_N-X_tests", "N"], "outcome": null, "parse_status": "partial", "raw_text": "𝑠= √(𝑥1 −𝑋𝑡𝑒𝑠𝑡𝑠)2 + (𝑥2 −𝑋𝑡𝑒𝑠𝑡𝑠)2+. . . +(𝑥𝑁−𝑋𝑡𝑒𝑠𝑡𝑠)2 𝑁−1", "id": "GTR22.BODY.6.3.3.EQ-3", "image_path": "equations/GTR22.BODY.6.3.3.EQ-3.png", "depends_on": []}
{"region_id": "p18-r4", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [198.4, 506.8, 402.4, 519.3], "source": "text_layer", "inline": false, "context_before": "(a)", "condition": null, "glossary": [], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "decision_rule", "linear": "X_tests<=A-(t_{P1,N}+ t_{P2,N}) *s", "latex": "X_{tests} \\le A-(t_{P1,N}+ t_{P2,N}) \\cdot s", "lhs": null, "symbols": ["X_tests", "A", "t_P1,N", "t_P2,N", "s"], "outcome": "pass", "parse_status": "parsed", "raw_text": "Pass the family if 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴−(𝑡𝑃1,𝑁+ 𝑡𝑃2,𝑁) ∙𝑠", "id": "GTR22.BODY.6.3.3.EQ-4", "image_path": "equations/GTR22.BODY.6.3.3.EQ-4.png", "depends_on": ["GTR22.BODY.6.3.3.EQ-2", "GTR22.BODY.6.3.3.EQ-3"]}
{"region_id": "p18-r5", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [198.4, 532.2, 390.4, 544.6], "source": "text_layer", "inline": false, "context_before": "(b)", "condition": null, "glossary": [], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "decision_rule", "linear": "X_tests> A+ (t_{F1,N}-t_F2) *s", "latex": "X_{tests}> A+ (t_{F1,N}-t_{F2}) \\cdot s", "lhs": null, "symbols": ["X_tests", "A", "t_F1,N", "t_F2", "s"], "outcome": "fail", "parse_status": "parsed", "raw_text": "Fail the family if 𝑋𝑡𝑒𝑠𝑡𝑠> 𝐴+ (𝑡𝐹1,𝑁−𝑡𝐹2) ∙𝑠", "id": "GTR22.BODY.6.3.3.EQ-5", "image_path": "equations/GTR22.BODY.6.3.3.EQ-5.png", "depends_on": ["GTR22.BODY.6.3.3.EQ-2", "GTR22.BODY.6.3.3.EQ-3"]}
{"region_id": "p18-r6", "unit_id": "GTR22.BODY.6.3.3", "page": 18, "bbox": [213.4, 569.7, 441.1, 582.2], "source": "text_layer", "inline": false, "context_before": "Take another measurement if:", "condition": null, "glossary": [], "normative": true, "uses_table_caption": "Table 3.", "label": null, "kind": "decision_rule", "linear": "A-(t_{P1,N}+ t_{P2,N}) *s< X_tests<=A+ (t_{F1,N}-t_F2) *s", "latex": "A-(t_{P1,N}+ t_{P2,N}) \\cdot s< X_{tests} \\le A+ (t_{F1,N}-t_{F2}) \\cdot s", "lhs": null, "symbols": ["A", "t_P1,N", "t_P2,N", "s", "X_tests", "t_F1,N", "t_F2"], "outcome": "continue", "parse_status": "parsed", "raw_text": "𝐴−(𝑡𝑃1,𝑁+ 𝑡𝑃2,𝑁) ∙𝑠< 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴+ (𝑡𝐹1,𝑁−𝑡𝐹2) ∙𝑠", "id": "GTR22.BODY.6.3.3.EQ-6", "image_path": "equations/GTR22.BODY.6.3.3.EQ-6.png", "depends_on": ["GTR22.BODY.6.3.3.EQ-2", "GTR22.BODY.6.3.3.EQ-3"]}
{"region_id": "p27-r3", "unit_id": "GTR22.ANNEX-3.2.1.2", "page": 27, "bbox": [188.6, 615.4, 504.8, 626.6], "source": "text_layer", "inline": false, "context_before": "vehicle at certification:", "condition": null, "glossary": [{"symbol": "UBE_measured", "symbol_text": "UBE_measured", "description": "the measured usable battery energy according to GTR15 Annex", "unit": null}], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "UBE_certified= UBE_measured*AF_PER UBE_certified= UBE_measured*AF_PER", "latex": "UBE_{certified}= UBE_{measured} \\cdot AF_{PER}UBE_{certified}= UBE_{measured} \\cdot AF_{PER}", "lhs": "UBE_certified", "symbols": ["UBE_certified", "UBE_measured", "AF_PER", "AF_PER_UBE_certified"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑∗𝐴𝐹𝑃𝐸𝑅 𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑∗𝐴𝐹𝑃𝐸𝑅", "id": "GTR22.ANNEX-3.2.1.2.EQ-1", "image_path": "equations/GTR22.ANNEX-3.2.1.2.EQ-1.png", "depends_on": ["GTR22.ANNEX-3.3.1.1.EQ-1"]}
{"region_id": "p28-r5", "unit_id": "GTR22.ANNEX-3.3.1.1", "page": 28, "bbox": [281.8, 534.9, 464.1, 547.2], "source": "text_layer", "inline": false, "context_before": "UBEmeasured shall be the usable battery energy calculated as follows:", "condition": null, "glossary": [{"symbol": "UBE_measured,nc", "symbol_text": "UBEmeasured,nc", "description": "the non-corrected usable battery energy of the charge-depleting test, Wh; ∆E_REESS,CC_ave is the average electric energy change of the confirmation cycle, Wh; CC means confirmation cycle as defined in GTR15 Annex 8, paragraph 3.2.4.4..", "unit": null}], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "UBE_measured= UBE_{measured,nc}-ΔE_{REESS,CC}_ave", "latex": "UBE_{measured}= UBE_{measured,nc}-\\Delta E_{REESS,CC}_{ave}", "lhs": "UBE_measured", "symbols": ["UBE_measured", "UBE_measured,nc", "Delta_E_REESS,CC_ave"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑈BE𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= UBE𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑,𝑛𝑐−∆𝐸𝑅𝐸𝐸𝑆𝑆,CC𝑎𝑣𝑒", "id": "GTR22.ANNEX-3.3.1.1.EQ-1", "image_path": "equations/GTR22.ANNEX-3.3.1.1.EQ-1.png", "depends_on": ["GTR22.ANNEX-3.3.1.1.EQ-2"]}
{"region_id": "p29-r2", "unit_id": "GTR22.ANNEX-3.3.1.1", "page": 29, "bbox": [311.6, 299.4, 429.5, 330.6], "source": "text_layer", "inline": false, "context_before": "The required input parameter UBEmeasured,nc is calculated as follows:", "condition": null, "glossary": [{"symbol": "Delta_E_REESS,i", "symbol_text": "∆E_REESS,i", "description": "the measured electric energy change of battery i, Wh", "unit": "Wh"}, {"symbol": "i", "symbol_text": "i", "description": "the index number of the considered battery", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the total number of batteries", "unit": null}], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "UBE_{measured,nc}=sum_{i=1}^{n} ΔE_{REESS,i}", "latex": "UBE_{measured,nc}=\\sum_{i=1}^{n} \\Delta E_{REESS,i}", "lhs": "UBE_measured,nc", "symbols": ["UBE_measured,nc", "sum_i=1", "n", "Delta_E_REESS,i"], "outcome": null, "parse_status": "parsed", "raw_text": "n UBEmeasured,nc = ∑∆EREESS,i i=1", "id": "GTR22.ANNEX-3.3.1.1.EQ-2", "image_path": "equations/GTR22.ANNEX-3.3.1.1.EQ-2.png", "depends_on": ["GTR22.ANNEX-3.3.1.1.EQ-3"]}
{"region_id": "p29-r3", "unit_id": "GTR22.ANNEX-3.3.1.1", "page": 29, "bbox": [276.5, 407.7, 467.3, 443.4], "source": "text_layer", "inline": false, "context_before": "and:", "condition": null, "glossary": [{"symbol": "U(t)_REESS,i", "symbol_text": "U(t)_REESS,i", "description": "the voltage of battery i, V", "unit": "V"}, {"symbol": "I(t)_REESS,i", "symbol_text": "I(t)_REESS,i", "description": "the electric current of battery i, A", "unit": "A"}, {"symbol": "t0", "symbol_text": "t0", "description": "the time at the beginning of the charge-depleting test, s", "unit": "s"}, {"symbol": "t_end", "symbol_text": "tend", "description": "the time at the end of the confirmation cycle of the chargedepleting test, s", "unit": "s"}], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "ΔE_{REESS,i}=(1)/(3600)*int_{t_0}^{t_end} U(t)_{REESS,i}* I(t)_{REESS,i}dt", "latex": "\\Delta E_{REESS,i}=\\frac{1}{3600} \\cdot \\int_{t_{0}}^{t_{end}} U(t)_{REESS,i} \\cdot I(t)_{REESS,i}dt", "lhs": "Delta_E_REESS,i", "symbols": ["Delta_E_REESS,i", "int_t_0", "t_end", "U(t)_REESS,i", "I(t)_REESS,i", "int_t_0^t_end_U"], "outcome": null, "parse_status": "partial", "raw_text": "tend 1 3600 × ∫U(t)REESS,i × I(t)REESS,i dt ∆EREESS,i = t0", "id": "GTR22.ANNEX-3.3.1.1.EQ-3", "image_path": "equations/GTR22.ANNEX-3.3.1.1.EQ-3.png", "depends_on": []}
{"region_id": "p29-r5", "unit_id": "GTR22.ANNEX-3.3.1.1", "page": 29, "bbox": [304.9, 565.9, 440.0, 597.1], "source": "text_layer", "inline": false, "context_before": "The required input parameter ∆E_REESS,CC,ave is calculated as follows:", "condition": null, "glossary": [{"symbol": "Delta_E_REESS,avg,i,CC", "symbol_text": "∆EREESS,avg,i,CC", "description": "the average of the measured electric energy change of battery i during the confirmation cycle, Wh", "unit": "Wh"}, {"symbol": "i", "symbol_text": "i", "description": "the index number of considered battery", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the total number of batteries", "unit": null}], "normative": true, "uses_table_caption": null, "label": null, "kind": "equation", "linear": "ΔE_{REESS.CC,ave}=sum_{i=1}^{n} ΔE_{REESS,avg,i,CC}", "latex": "\\Delta E_{REESS.CC,ave}=\\sum_{i=1}^{n} \\Delta E_{REESS,avg,i,CC}", "lhs": "Delta_E_REESS.CC,ave", "symbols": ["Delta_E_REESS.CC,ave", "sum_i=1", "n", "Delta_E_REESS,avg,i,CC", "1^n_Delta_E_REESS,avg,i,CC"], "outcome": null, "parse_status": "parsed", "raw_text": "𝑛 ∆𝐸𝑅𝐸𝐸𝑆𝑆.𝐶𝐶,𝑎𝑣𝑒= ∑Δ𝐸𝑅𝐸𝐸𝑆𝑆,𝑎𝑣𝑔,𝑖,𝐶𝐶 𝑖=1", "id": "GTR22.ANNEX-3.3.1.1.EQ-5", "image_path": "equations/GTR22.ANNEX-3.3.1.1.EQ-5.png", "depends_on": ["GTR22.ANNEX-3.3.1.1.EQ-6"]}
