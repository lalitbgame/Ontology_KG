    <edge source="GTR22.ANNEX-3.2.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/11" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/11 Step no.1</data>
      <data key="d93">Parameters Explanation UBEcertfied Shortened Test Procedure (STP) Consecutive Cycle Procedure (CCP) UBEcertified is the adjusted measured usable battery energy (UBE) of the vehicle at certification: UBE_certified= UBE_measured∗AF_PER where: UBE_measured is the measured usable battery energy according to GTR15 Annex 8, Table A8/11 Step no.1 at certification.</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.2.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/11.STEP-6" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15, Annex 8, Table A8/11 Step no. 6.</data>
      <data key="d93">AF_PER is the adjustment factor determined according to GTR15, Annex 8, Table A8/11 Step no. 6.</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.2.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/10" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/10 Step no.1</data>
      <data key="d93">UBEcertified is the adjusted measured usable battery energy (UBE) of the vehicle at certification: UBE_certified= UBE_measured∗AF_PER where: UBE_measured is the measured usable battery energy according to GTR15 Annex 8, Table A8/10 Step no.1 at certification.</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.2.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/10.STEP-7" id="0">
