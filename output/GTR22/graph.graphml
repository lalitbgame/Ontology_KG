      <data key="d20">2</data>
      <data key="d21">0</data>
      <data key="d22">26</data>
      <data key="d23">26</data>
      <data key="d28">True</data>
      <data key="d8">Values to be read from vehicles:</data>
      <data key="d24" />
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Annex"]</data>
      <data key="d27">2</data>
      <data key="d29">ANNEX-2</data>
    </node>
