    <edge source="GTR22.ANNEX-3.3.2.1" target="GTR22/EXT:UNGTR-15#ANNEX-8.4.4.4.1.g/km" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15, Annex 8, Paragraph 4.4.4.1., g/km</data>
      <data key="d93">Parameters Explanation Rangemeasured Rangemeasured is the measured equivalent all-electric range as defined in the equation below: EAER_measured= ( M_CO2,CS − M_CO2,CD,avg MCO2,CS ) × R_cdc where: MCO2,CD,avg is the arithmetic average charge-depleting CO2 mass emission according to GTR15, Annex 8, Paragraph 4.4.4.1., g/km;</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.2.1" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/5.STEP-5" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15, Annex 8, Table A8/5 Step no. 5, g/km</data>
      <data key="d93">MCO2,CS is the charge-sustaining CO2 mass emission according to GTR15, Annex 8, Table A8/5 Step no. 5, g/km;</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.2.1" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/8.STEP-3" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15, Annex 8, Table A8/8, Step no. 3, km</data>
      <data key="d93">RCDC is the measured length of the charge-depleting test according to GTR15, Annex 8, Table A8/8, Step no. 3, km;</data>
      <data key="d94">table</data>
    </edge>
