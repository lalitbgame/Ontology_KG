    <edge source="GTR22.ANNEX-3.3.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/8.STEP-14" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/8, Step no. 14</data>
      <data key="d93">At the option of the Contracting Party, one out of the following two adjustment factors shall be selected: - Adjustment factor 1: AF_OVC−HEV= EC^measured ECcertified where: ECcertified is the electric energy consumption ECAC.CD according to GTR15 Annex 8, Table A8/8, Step no. 14 at certification, Wh/km;</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/8.STEP-13" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/8, Step no. 13</data>
      <data key="d93">EC_measured is the measured electric energy consumption ECAC,CD according to GTR15 Annex 8, Table A8/8, Step no. 13 at certification.</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/9.STEP-8" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/9, Step no. 8</data>
      <data key="d93">Wh/km. - Adjustment factor 2: AF_OVC.HEV= EC^measured ECcertified where: EC_certified is EC according to GTR15 Annex 8, Table A8/9, Step no. 8 at certification, Wh/km;</data>
      <data key="d94">table</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.1.2" target="GTR22/EXT:UNGTR-15#ANNEX-8.TABLE-A8/9.STEP-7" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">GTR15 Annex 8, Table A8/9, Step no. 7</data>
      <data key="d93">EC_measured is measured EC according to GTR15 Annex 8, Table A8/9, Step no. 7 at certification.</data>
      <data key="d94">table</data>
    </edge>
