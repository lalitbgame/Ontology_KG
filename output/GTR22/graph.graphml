    <node id="GTR22.ANNEX-2.4">
      <data key="d0">Clause</data>
      <data key="d1">GTR22</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">GTR22.ANNEX-2</data>
      <data key="d20">4</data>
      <data key="d27">4</data>
      <data key="d21">1</data>
