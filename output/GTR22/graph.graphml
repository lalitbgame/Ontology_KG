      <data key="d75">equations/GTR22.BODY.5.2.EQ-1.png</data>
    </node>
    <node id="GTR22.BODY.6.3.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p17-r1</data>
      <data key="d45">GTR22.BODY.6.3.2</data>
      <data key="d22">17</data>
      <data key="d61">[192.1, 677.3, 349.1, 703.0]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">per cent.</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">SOCE_measured=(UBE_measured)/(UBE_certified)*100</data>
      <data key="d57">SOCE_{measured}=\frac{UBE_{measured}}{UBE_{certified}} \cdot 100</data>
      <data key="d70">SOCE_measured</data>
      <data key="d71">["SOCE_measured", "UBE_measured", "UBE_certified"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑆𝑂𝐶𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑 ∗100</data>
      <data key="d75">equations/GTR22.BODY.6.3.2.EQ-1.png</data>
    </node>
    <node id="GTR22.BODY.6.3.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p17-r2</data>
      <data key="d45">GTR22.BODY.6.3.2</data>
      <data key="d22">17</data>
      <data key="d61">[187.1, 715.1, 353.9, 740.8]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">UBE_certified ∗100</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">SOCR_measured=(Range_measured)/(Range_certified)*100</data>
      <data key="d57">SOCR_{measured}=\frac{Range_{measured}}{Range_{certified}} \cdot 100</data>
      <data key="d70">SOCR_measured</data>
      <data key="d71">["SOCR_measured", "Range_measured", "Range_certified"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑆𝑂𝐶𝑅𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= 𝑅𝑎𝑛𝑔𝑒𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 ∗100 𝑅𝑎𝑛𝑔𝑒𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑</data>
      <data key="d75">equations/GTR22.BODY.6.3.2.EQ-2.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r1</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[170.1, 269.7, 301.5, 284.3]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">calculated:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "SOC_read,i", "symbol_text": "SOC_read,i", "description": "the on-board SOCR/SOCE read from the vehicle i ; and", "unit": null}, {"symbol": "SOC_measured,i", "symbol_text": "SOC_measured,i", "description": "the measured SOCR/SOCE of the vehicle i.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">x_i=SOC_{read,i}-SOC_{measured,i}</data>
      <data key="d57">x_{i}=SOC_{read,i}-SOC_{measured,i}</data>
      <data key="d70">x_i</data>
      <data key="d71">["x_i", "SOC_read,i", "SOC_measured,i"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑥𝑖= 𝑆𝑂𝐶𝑟𝑒𝑎𝑑,𝑖−𝑆𝑂𝐶𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑,𝑖</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-1.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r2</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[254.8, 387.5, 397.2, 412.2]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">x_1, x_2, ... x_N, the average X_tests and the standard deviation s shall be determined:</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">X_tests=((x_1+ x_2+ x_3+ ...+ x_N))/(N)</data>
      <data key="d57">X_{tests}=\frac{(x_{1}+ x_{2}+ x_{3}+ \dots + x_{N})}{N}</data>
      <data key="d70">X_tests</data>
      <data key="d71">["X_tests", "x_1", "x_2", "x_3", "x_N", "N"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">(𝑥1 + 𝑥2 + 𝑥3 + ⋯+ 𝑥𝑁) 𝑋𝑡𝑒𝑠𝑡𝑠= 𝑁</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-2.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-3">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r3</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[170.1, 439.2, 407.4, 466.6]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">and</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">s=sqrt(((x_1-X_tests)^{2}+ (x_2-X_tests)^{2}+. . . +(x_N-X_tests)^{2})/(N-1))</data>
      <data key="d57">s=\sqrt{\frac{(x_{1}-X_{tests})^{2}+ (x_{2}-X_{tests})^{2}+. . . +(x_{N}-X_{tests})^{2}}{N-1}}</data>
      <data key="d70">s</data>
      <data key="d71">["s", "x_1-X_tests", "x_2-X_tests", "x_N-X_tests", "N"]</data>
      <data key="d72" />
      <data key="d73">partial</data>
      <data key="d74">𝑠= √(𝑥1 −𝑋𝑡𝑒𝑠𝑡𝑠)2 + (𝑥2 −𝑋𝑡𝑒𝑠𝑡𝑠)2+. . . +(𝑥𝑁−𝑋𝑡𝑒𝑠𝑡𝑠)2 𝑁−1</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-3.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-4">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r4</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[198.4, 506.8, 402.4, 519.3]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">(a)</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">decision_rule</data>
      <data key="d69">X_tests&lt;=A-(t_{P1,N}+ t_{P2,N}) *s</data>
      <data key="d57">X_{tests} \le A-(t_{P1,N}+ t_{P2,N}) \cdot s</data>
      <data key="d70" />
      <data key="d71">["X_tests", "A", "t_P1,N", "t_P2,N", "s"]</data>
      <data key="d72">pass</data>
      <data key="d73">parsed</data>
      <data key="d74">Pass the family if 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴−(𝑡𝑃1,𝑁+ 𝑡𝑃2,𝑁) ∙𝑠</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-4.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-5">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r5</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[198.4, 532.2, 390.4, 544.6]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">(b)</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">decision_rule</data>
      <data key="d69">X_tests&gt; A+ (t_{F1,N}-t_F2) *s</data>
      <data key="d57">X_{tests}&gt; A+ (t_{F1,N}-t_{F2}) \cdot s</data>
      <data key="d70" />
      <data key="d71">["X_tests", "A", "t_F1,N", "t_F2", "s"]</data>
      <data key="d72">fail</data>
      <data key="d73">parsed</data>
      <data key="d74">Fail the family if 𝑋𝑡𝑒𝑠𝑡𝑠&gt; 𝐴+ (𝑡𝐹1,𝑁−𝑡𝐹2) ∙𝑠</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-5.png</data>
    </node>
    <node id="GTR22.BODY.6.3.3.EQ-6">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p18-r6</data>
      <data key="d45">GTR22.BODY.6.3.3</data>
      <data key="d22">18</data>
      <data key="d61">[213.4, 569.7, 441.1, 582.2]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">Take another measurement if:</data>
      <data key="d64" />
      <data key="d65">[]</data>
      <data key="d28">True</data>
      <data key="d66">Table 3.</data>
      <data key="d67" />
      <data key="d68">decision_rule</data>
      <data key="d69">A-(t_{P1,N}+ t_{P2,N}) *s&lt; X_tests&lt;=A+ (t_{F1,N}-t_F2) *s</data>
      <data key="d57">A-(t_{P1,N}+ t_{P2,N}) \cdot s&lt; X_{tests} \le A+ (t_{F1,N}-t_{F2}) \cdot s</data>
      <data key="d70" />
      <data key="d71">["A", "t_P1,N", "t_P2,N", "s", "X_tests", "t_F1,N", "t_F2"]</data>
      <data key="d72">continue</data>
      <data key="d73">parsed</data>
      <data key="d74">𝐴−(𝑡𝑃1,𝑁+ 𝑡𝑃2,𝑁) ∙𝑠&lt; 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴+ (𝑡𝐹1,𝑁−𝑡𝐹2) ∙𝑠</data>
      <data key="d75">equations/GTR22.BODY.6.3.3.EQ-6.png</data>
    </node>
    <node id="GTR22.ANNEX-3.2.1.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p27-r3</data>
      <data key="d45">GTR22.ANNEX-3.2.1.2</data>
      <data key="d22">27</data>
      <data key="d61">[188.6, 615.4, 504.8, 626.6]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">vehicle at certification:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "UBE_measured", "symbol_text": "UBE_measured", "description": "the measured usable battery energy according to GTR15 Annex", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">UBE_certified= UBE_measured*AF_PER UBE_certified= UBE_measured*AF_PER</data>
      <data key="d57">UBE_{certified}= UBE_{measured} \cdot AF_{PER}UBE_{certified}= UBE_{measured} \cdot AF_{PER}</data>
      <data key="d70">UBE_certified</data>
      <data key="d71">["UBE_certified", "UBE_measured", "AF_PER", "AF_PER_UBE_certified"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑∗𝐴𝐹𝑃𝐸𝑅 𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑∗𝐴𝐹𝑃𝐸𝑅</data>
      <data key="d75">equations/GTR22.ANNEX-3.2.1.2.EQ-1.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p28-r5</data>
      <data key="d45">GTR22.ANNEX-3.3.1.1</data>
      <data key="d22">28</data>
      <data key="d61">[281.8, 534.9, 464.1, 547.2]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">UBEmeasured shall be the usable battery energy calculated as follows:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "UBE_measured,nc", "symbol_text": "UBEmeasured,nc", "description": "the non-corrected usable battery energy of the charge-depleting test, Wh; ∆E_REESS,CC_ave is the average electric energy change of the confirmation cycle, Wh; CC means confirmation cycle as defined in GTR15 Annex 8, paragraph 3.2.4.4..", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">UBE_measured= UBE_{measured,nc}-ΔE_{REESS,CC}_ave</data>
      <data key="d57">UBE_{measured}= UBE_{measured,nc}-\Delta E_{REESS,CC}_{ave}</data>
      <data key="d70">UBE_measured</data>
      <data key="d71">["UBE_measured", "UBE_measured,nc", "Delta_E_REESS,CC_ave"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑈BE𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= UBE𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑,𝑛𝑐−∆𝐸𝑅𝐸𝐸𝑆𝑆,CC𝑎𝑣𝑒</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.1.EQ-1.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.1.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p29-r2</data>
      <data key="d45">GTR22.ANNEX-3.3.1.1</data>
      <data key="d22">29</data>
      <data key="d61">[311.6, 299.4, 429.5, 330.6]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">The required input parameter UBEmeasured,nc is calculated as follows:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "Delta_E_REESS,i", "symbol_text": "∆E_REESS,i", "description": "the measured electric energy change of battery i, Wh", "unit": "Wh"}, {"symbol": "i", "symbol_text": "i", "description": "the index number of the considered battery", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the total number of batteries", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">UBE_{measured,nc}=sum_{i=1}^{n} ΔE_{REESS,i}</data>
      <data key="d57">UBE_{measured,nc}=\sum_{i=1}^{n} \Delta E_{REESS,i}</data>
      <data key="d70">UBE_measured,nc</data>
      <data key="d71">["UBE_measured,nc", "sum_i=1", "n", "Delta_E_REESS,i"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">n UBEmeasured,nc = ∑∆EREESS,i i=1</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.1.EQ-2.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.1.EQ-3">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p29-r3</data>
      <data key="d45">GTR22.ANNEX-3.3.1.1</data>
      <data key="d22">29</data>
      <data key="d61">[276.5, 407.7, 467.3, 443.4]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">and:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "U(t)_REESS,i", "symbol_text": "U(t)_REESS,i", "description": "the voltage of battery i, V", "unit": "V"}, {"symbol": "I(t)_REESS,i", "symbol_text": "I(t)_REESS,i", "description": "the electric current of battery i, A", "unit": "A"}, {"symbol": "t0", "symbol_text": "t0", "description": "the time at the beginning of the charge-depleting test, s", "unit": "s"}, {"symbol": "t_end", "symbol_text": "tend", "description": "the time at the end of the confirmation cycle of the chargedepleting test, s", "unit": "s"}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">ΔE_{REESS,i}=(1)/(3600)*int_{t_0}^{t_end} U(t)_{REESS,i}* I(t)_{REESS,i}dt</data>
      <data key="d57">\Delta E_{REESS,i}=\frac{1}{3600} \cdot \int_{t_{0}}^{t_{end}} U(t)_{REESS,i} \cdot I(t)_{REESS,i}dt</data>
      <data key="d70">Delta_E_REESS,i</data>
      <data key="d71">["Delta_E_REESS,i", "int_t_0", "t_end", "U(t)_REESS,i", "I(t)_REESS,i", "int_t_0^t_end_U"]</data>
      <data key="d72" />
      <data key="d73">partial</data>
      <data key="d74">tend 1 3600 × ∫U(t)REESS,i × I(t)REESS,i dt ∆EREESS,i = t0</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.1.EQ-3.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.1.EQ-5">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p29-r5</data>
      <data key="d45">GTR22.ANNEX-3.3.1.1</data>
      <data key="d22">29</data>
      <data key="d61">[304.9, 565.9, 440.0, 597.1]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">The required input parameter ∆E_REESS,CC,ave is calculated as follows:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "Delta_E_REESS,avg,i,CC", "symbol_text": "∆EREESS,avg,i,CC", "description": "the average of the measured electric energy change of battery i during the confirmation cycle, Wh", "unit": "Wh"}, {"symbol": "i", "symbol_text": "i", "description": "the index number of considered battery", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the total number of batteries", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">ΔE_{REESS.CC,ave}=sum_{i=1}^{n} ΔE_{REESS,avg,i,CC}</data>
      <data key="d57">\Delta E_{REESS.CC,ave}=\sum_{i=1}^{n} \Delta E_{REESS,avg,i,CC}</data>
      <data key="d70">Delta_E_REESS.CC,ave</data>
      <data key="d71">["Delta_E_REESS.CC,ave", "sum_i=1", "n", "Delta_E_REESS,avg,i,CC", "1^n_Delta_E_REESS,avg,i,CC"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑛 ∆𝐸𝑅𝐸𝐸𝑆𝑆.𝐶𝐶,𝑎𝑣𝑒= ∑Δ𝐸𝑅𝐸𝐸𝑆𝑆,𝑎𝑣𝑔,𝑖,𝐶𝐶 𝑖=1</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.1.EQ-5.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.1.EQ-6">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p29-r6</data>
      <data key="d45">GTR22.ANNEX-3.3.1.1</data>
      <data key="d22">29</data>
      <data key="d61">[255.3, 680.1, 502.4, 729.1]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">and</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "U_REESS,i(t)", "symbol_text": "U_REESS,i(t)", "description": "the voltage of battery i, in V", "unit": null}, {"symbol": "I_REESS,i(t)", "symbol_text": "I_REESS,i(t)", "description": "the current of battery i, in A", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">ΔE_{REESS,avg,i,CC}=(1)/(3600_t)*int_{t}^{*} _{start,CC}(1)/(_{end,CC}t_{end,CC}_t_{end,CC}-t_{start,CC})int_{t} _{start,CC}U_{REESS,i}(t) * I_{REESS,i}(t)dt dt</data>
      <data key="d57">\Delta E_{REESS,avg,i,CC}=\frac{1}{3600_{t}} \cdot \int_{t}^{\cdot} _{start,CC}\frac{1}{_{end,CC}t_{end,CC}_{t}_{end,CC}-t_{start,CC}}\int_{t} _{start,CC}U_{REESS,i}(t) \cdot I_{REESS,i}(t)dt dt</data>
      <data key="d70">Delta_E_REESS,avg,i,CC</data>
      <data key="d71">["Delta_E_REESS,avg,i,CC", "int_t", "CC", "t_end,CC_t", "t_start,CC", "U_REESS,i(t)", "I_REESS,i(t)", "end,CCt_end,CC_t_end,CC", "int_t__start,CCU_REESS,i"]</data>
      <data key="d72" />
      <data key="d73">partial</data>
      <data key="d74">1 1 ΔEREESS,avg,i,CC = 3600 × tend,CC −tstart,CC tend,𝐶𝐶 tend,𝐶𝐶 UREESS,𝑖(t) × IREESS,𝑖(t)𝑑𝑡 𝑑𝑡 × ∫ ∫ tstart,CC tstart,𝐶𝐶</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.1.EQ-6.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p30-r4</data>
      <data key="d45">GTR22.ANNEX-3.3.1.2</data>
      <data key="d22">30</data>
      <data key="d61">[288.9, 295.3, 450.1, 306.5]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">certification:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "UBE_measured", "symbol_text": "UBE_measured", "description": "the measured usable battery energy according to paragraph 3.1.1. of this annex, Wh", "unit": "Wh"}, {"symbol": "AF_OVC-HEV", "symbol_text": "AF_OVC−HEV", "description": "the adjustment factor determined as described below.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">UBE_certified= UBE_measured*AF_{OVC-HEV}</data>
      <data key="d57">UBE_{certified}= UBE_{measured} \cdot AF_{OVC-HEV}</data>
      <data key="d70">UBE_certified</data>
      <data key="d71">["UBE_certified", "UBE_measured", "AF_OVC-HEV"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑈𝐵𝐸𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑= 𝑈𝐵𝐸𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑∗𝐴𝐹𝑂𝑉𝐶−𝐻𝐸𝑉</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.2.EQ-1.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p30-r5</data>
      <data key="d45">GTR22.ANNEX-3.3.1.2</data>
      <data key="d22">30</data>
      <data key="d61">[203.0, 408.7, 299.0, 431.8]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">- Adjustment factor 1:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "EC_certified", "symbol_text": "ECcertified", "description": "the electric energy consumption ECAC.CD according to GTR15 Annex 8, Table A8/8, Step no. 14 at certification, Wh/km", "unit": "Wh/km"}, {"symbol": "EC_measured", "symbol_text": "EC_measured", "description": "the measured electric energy consumption ECAC,CD according to GTR15 Annex 8, Table A8/8, Step no. 13 at certification. Wh/km.", "unit": null}, {"symbol": "-_Adjustment_factor_2:", "symbol_text": "- Adjustment factor 2:", "description": null, "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">AF_{OVC-HEV}=(EC_measured)/(EC_certified)</data>
      <data key="d57">AF_{OVC-HEV}=\frac{EC_{measured}}{EC_{certified}}</data>
      <data key="d70">AF_OVC-HEV</data>
      <data key="d71">["AF_OVC-HEV", "EC_measured", "EC_certified"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝐴𝐹𝑂𝑉𝐶−𝐻𝐸𝑉= 𝐸𝐶𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 𝐸𝐶𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.2.EQ-2.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.1.2.EQ-3">
      <data key="d0">Equation</data>
      <data key="d1">GTR22</data>
      <data key="d60">p30-r6</data>
      <data key="d45">GTR22.ANNEX-3.3.1.2</data>
      <data key="d22">30</data>
      <data key="d61">[203.0, 519.0, 295.7, 542.1]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">- Adjustment factor 2:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "EC_certified", "symbol_text": "EC_certified", "description": "EC according to GTR15 Annex 8, Table A8/9, Step no. 8 at certification, Wh/km; EC_measured is measured EC according to GTR15 Annex 8, Table A8/9, Step no. 7 at certification. Wh/km.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">AF_{OVC.HEV}=(EC_measured)/(EC_certified)</data>
      <data key="d57">AF_{OVC.HEV}=\frac{EC_{measured}}{EC_{certified}}</data>
      <data key="d70">AF_OVC.HEV</data>
      <data key="d71">["AF_OVC.HEV", "EC_measured", "EC_certified"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝐴𝐹𝑂𝑉𝐶.𝐻𝐸𝑉= 𝐸𝐶𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑 𝐸𝐶𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.1.2.EQ-3.png</data>
    </node>
    <node id="GTR22.ANNEX-3.3.2.1.EQ-1">
