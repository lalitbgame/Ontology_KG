      <data key="d92">GTR15 Annex 8</data>
      <data key="d93">CC means confirmation cycle as defined in GTR15 Annex 8, paragraph</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="GTR22.ANNEX-3.3.1.1" target="GTR22/EXT:UNGTR-15#ANNEX-8.3.2.4.4" id="0">
      <data key="d90">CITES</data>
      <data key="d91">definition_source</data>
      <data key="d92">GTR15 Annex 8, paragraph 3.2.4.4.</data>
      <data key="d93">CC means confirmation cycle as defined in GTR15 Annex 8, paragraph 3.2.4.4.. The correction with the average electric energy change in the confirmation cycle is required as the break-off criterion, according to GTR 15 Annex 8, paragraph 3.2.4.5., allows a toggling around the absolute reference level.</data>
      <data key="d94">table</data>
    </edge>
