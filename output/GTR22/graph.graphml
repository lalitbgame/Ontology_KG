      <data key="d61">[273.2, 166.9, 472.5, 190.5]</data>
      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">equation below:</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "M_CO2,CD,avg", "symbol_text": "MCO2,CD,avg", "description": "the arithmetic average charge-depleting CO2 mass emission according to GTR15, Annex 8, Paragraph 4.4.4.1., g/km", "unit": "g/km"}, {"symbol": "M_CO2,CS", "symbol_text": "MCO2,CS", "description": "the charge-sustaining CO2 mass emission according to GTR15, Annex 8, Table A8/5 Step no. 5, g/km", "unit": "g/km"}, {"symbol": "R_cdc", "symbol_text": "RCDC", "description": "the measured length of the charge-depleting test according to GTR15, Annex 8, Table A8/8, Step no. 3, km", "unit": "km"}]</data>
      <data key="d28">True</data>
      <data key="d66" />
      <data key="d67" />
      <data key="d68">equation</data>
      <data key="d69">EAER_measured= ((M_{CO2,CS}- M_{CO2,CD,avg})/(M_{CO2,CS})) * R_cdc</data>
      <data key="d57">EAER_{measured}= (\frac{M_{CO2,CS}- M_{CO2,CD,avg}}{M_{CO2,CS}}) \cdot R_{cdc}</data>
      <data key="d70">EAER_measured</data>
      <data key="d71">["EAER_measured", "M_CO2,CS", "M_CO2,CD,avg", "R_cdc"]</data>
      <data key="d72" />
      <data key="d73">parsed</data>
      <data key="d74">𝑴𝑪𝑶𝟐,𝑪𝑺 − 𝑴𝑪𝑶𝟐,𝑪𝑫,𝒂𝒗𝒈 ) × 𝑹𝒄𝒅𝒄 𝑬𝑨𝑬𝑹𝒎𝒆𝒂𝒔𝒖𝒓𝒆𝒅= ( 𝑴𝑪𝑶𝟐,𝑪𝑺</data>
      <data key="d75">equations/GTR22.ANNEX-3.3.2.1.EQ-1.png</data>
    </node>
