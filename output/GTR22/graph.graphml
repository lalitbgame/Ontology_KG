      <data key="d41">text_layer</data>
      <data key="d62">False</data>
      <data key="d63">reported by each vehicle.</data>
      <data key="d64" />
      <data key="d65">[{"symbol": "worst_case_certified_energy_consumption_of_PART_B_family", "symbol_text": "worst case certified energy consumption of Part B family", "description": "the worst case certified energy consumption of a Part B family which needs to be provided according to Annex 2.", "unit": null}]</data>
