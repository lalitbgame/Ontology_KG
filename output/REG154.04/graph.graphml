      <data key="d22">463</data>
      <data key="d23">463</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Calculations for hybrid electric, pure electric and compressed hydrogen fuel cell vehicles</data>
      <data key="d25" />
