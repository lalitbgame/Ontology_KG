      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">torque meter method shall be calculated using the following equations:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "w_1", "symbol_text": "w_1", "description": "the wind resistance correction for the coastdown method, N", "unit": "N"}, {"symbol": "f_2", "symbol_text": "f_2", "description": "the coefficient of the aerodynamic term determined according to paragraph 4.3.1.4.4. of this annex", "unit": null}, {"symbol": "v_w_in_the_case_that_wind_speed", "symbol_text": "v_w in the case that wind speed", "description": "measured at only one point, v w is the arithmetic average vector component of the wind speed parallel to the test road during all valid run pairs, m/s", "unit": null}, {"symbol": "v_w_in_the_case_that_the_wind_speed", "symbol_text": "v_w in the case that the wind speed", "description": "measured at two points, v_w is the lower of the two arithmetic average vector components of the wind speed parallel to the test road during all valid run pairs, m/s", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">or:w w^{1}=_2=3.6 3.6^{2}_2* f* c^{2}* v_2* v^{w}^{2}_w_2</data>
      <data key="d56">or:w w^{1}=_{2}=3.6 3.6^{2}_{2} \cdot f \cdot c^{2} \cdot v_{2} \cdot v^{w}^{2}_{w}_{2}</data>
