      <data key="d60">[258.3, 702.3, 397.4, 749.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">nitrogen, the following calculations apply:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">KH=1 -0.0329 *1(H -10.71)</data>
