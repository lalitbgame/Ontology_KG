      <data key="d44">REG154.04.ANNEX-B7.3.2.3.2.2.3.3</data>
      <data key="d22">434</data>
      <data key="d60">[256.8, 640.3, 395.7, 689.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">equipment and body shapes:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "C_D", "symbol_text": "C_D", "description": "the aerodynamic drag coefficient", "unit": null}, {"symbol": "A_f", "symbol_text": "A_f", "description": "the frontal area of the vehicle, m", "unit": "m"}, {"symbol": "n", "symbol_text": "n", "description": "the number of items of optional equipment on the vehicle that are different between an individual vehicle and test vehicle L", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δ(C_D* A_f)_ind=^{n}sum_{i=1} Δ(C_D* A_f)_i</data>
      <data key="d56">\Delta (C_{D} \cdot A_{f})_{ind}=^{n}\sum_{i=1} \Delta (C_{D} \cdot A_{f})_{i}</data>
      <data key="d69" />
      <data key="d70">["Delta", "C_D", "A_f", "n", "sum_i=1"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">n ∆(CD × Af)ind = ∑∆(CD × Af)i i=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.3.2.2.3.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.3.2.2.4.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p435-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.3.2.2.4</data>
      <data key="d22">435</data>
      <data key="d60">[257.6, 501.1, 400.5, 566.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">follows:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_L(v) = f_{0,L}^{*}+ f_{1,H}* v + f_{*}_{2,L}^{*}and* v f_{2,L}^{2}</data>
      <data key="d56">F_{L}(v) = f_{0,L}^{\cdot}+ f_{1,H} \cdot v + f_{\cdot}_{2,L}^{\cdot}and \cdot v f_{2,L}^{2}</data>
      <data key="d69">F_L(v)</data>
      <data key="d70">["F_L(v)", "f_0,L", "f_1,H", "v", "f_*_2,L", "f_2,L"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">FL(v) = f0,L + f1,H × v + f2,L × v 2 ∗ ∗ ∗ and f2,L</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.3.2.2.4.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.3.2.2.4.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p435-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.3.2.2.4</data>
      <data key="d22">435</data>
      <data key="d60">[218.5, 591.2, 437.5, 642.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">interpolation family shall be calculated using the following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_{0,ind}= f_{0,H}-Δf_0*(TM((TM^{H}* RR* RR^{H}-TM^{ind}* RR* RR_ind))/(H H L L)-TM)</data>
      <data key="d56">f_{0,ind}= f_{0,H}-\Delta f_{0} \cdot (TM\frac{(TM^{H} \cdot RR \cdot RR^{H}-TM^{ind} \cdot RR \cdot RR_{ind})}{H H L L}-TM)</data>
      <data key="d69">f_0,ind</data>
      <data key="d70">["f_0,ind", "f_0,H", "Delta_f_0", "TM", "H", "RR", "RR_ind", "L"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">(TMH × RRH −TMind × RRind) f0,ind = f0,H −∆f0 × (TMH × RRH −TML × RRL)</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.3.2.2.4.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.3.2.2.4.EQ-3">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p435-r3</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.3.2.2.4</data>
      <data key="d22">435</data>
      <data key="d60">[223.8, 655.0, 429.8, 740.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">apply:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_{2,ind}= f_{2,H}-Δf f_2_{0,ind}(Δ[C(D* A(Δ[C^{f}^{LH}* A]^{d}* A)^{f}^{ind})/(D f LH)f_{1,ind}=f=_{0,H}f_{1,H}-Δf]_0-Δ[C])</data>
      <data key="d56">f_{2,ind}= f_{2,H}-\Delta f f_{2}_{0,ind}(\Delta [C\frac{D \cdot A(\Delta [C^{f}^{LH} \cdot A]^{d} \cdot A)^{f}^{ind}}{D f LH}f_{1,ind}=f=_{0,H}f_{1,H}-\Delta f]_{0}-\Delta [C])</data>
      <data key="d69">f_2,ind</data>
