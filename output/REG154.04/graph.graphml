      <data key="d62">accordance with paragraph 2.5.1. of Annex B4, kg;</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "P_OVERRUN,1", "symbol_text": "P_OVERRUN,1", "description": "the initial overrun power, kW", "unit": "kW"}, {"symbol": "PRATED", "symbol_text": "PRATED", "description": "the rated engine power, kW.", "unit": "kW"}]</data>
