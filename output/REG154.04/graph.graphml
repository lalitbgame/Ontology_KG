      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Gas density of hydrogen is determined by the following equation.</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "ρ(p,_T)", "symbol_text": "ρ(p, T)", "description": "the gas density at the given pressure and temperature, g/m", "unit": null}, {"symbol": "p", "symbol_text": "p", "description": "the pressure of the hydrogen tank at the end of the constant speed segment, MPa", "unit": null}, {"symbol": "T", "symbol_text": "T", "description": "hydrogen gas temperature of the hydrogen tank. 283,15 (15 °C) in K at the end of the constant speed segment.", "unit": null}, {"symbol": "R", "symbol_text": "R", "description": "the gas constant, 8.314472x 10^-6in m MPa K^−1 mol^−1", "unit": null}, {"symbol": "M", "symbol_text": "M", "description": "the molar mass of hydrogen, 2.01588, g/mol", "unit": null}, {"symbol": "Z(p,T)", "symbol_text": "Z(p,T)", "description": "the compressibility factor.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">ρ(p, T) =pM RT(Z(p, T)1)</data>
      <data key="d56">\rho (p, T) =pM RT(Z(p, T)1)</data>
      <data key="d69" />
      <data key="d70">["ρ", "p", "T", "pM", "RT", "Z"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">𝑝𝑀 1 𝜌(𝑝, 𝑇) = 𝑅𝑇( 𝑍(𝑝, 𝑇))</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.APP7.3.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B8.APP7.3.3.2.EQ-1">
