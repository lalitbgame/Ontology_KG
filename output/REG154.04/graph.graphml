      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "UFj", "symbol_text": "UF_j", "description": "utility factor for period j", "unit": null}, {"symbol": "dj", "symbol_text": "d_j", "description": "measured distance driven at the end of period j, km", "unit": "km"}, {"symbol": "C_i", "symbol_text": "C_i", "description": "i^th coefficient (see Table A8.App5/1)", "unit": null}, {"symbol": "dnx", "symbol_text": "dnx", "description": "dnea, dneb, dnec, normalised distance (see Table A8.App5/1)", "unit": null}, {"symbol": "k", "symbol_text": "k", "description": "number of terms and coefficients in the exponent", "unit": null}, {"symbol": "j", "symbol_text": "j", "description": "number of period considered", "unit": null}, {"symbol": "i", "symbol_text": "i", "description": "number of considered term/coefficient", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">UFj(dj)= 1 - exp {-(^{k}sum_{i=1} C_i* ((d^{j}))/(nx)d^{i})} -^{j-1}sum_{l=1} UF_l</data>
      <data key="d56">UFj(dj)= 1 - exp {-(^{k}\sum_{i=1} C_{i} \cdot (\frac{d^{j})}{nx}d^{i})} -^{j-1}\sum_{l=1} UF_{l}</data>
      <data key="d69">UFj(dj)</data>
      <data key="d70">["UFj", "dj", "k", "sum_i=1", "C_i", "j", "nx", "i", "sum_l=1", "UF_l"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">dj j−1 k i UFj(dj) = 1 − exp {−(∑Ci × ( ) )} − ∑UFl dnx i=1 l=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.APP5.2.EQ-1.png</data>
