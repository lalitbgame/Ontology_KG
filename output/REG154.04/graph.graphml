      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">and:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">PM=V(V^{mix}* d^{e})/(ep)* P</data>
      <data key="d56">PM=V\frac{V^{mix} \cdot d^{e}}{ep} \cdot P</data>
      <data key="d69">PM</data>
      <data key="d70">["PM", "V", "e", "ep", "P"]</data>
