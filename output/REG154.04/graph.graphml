  <graph edgedefault="directed">
    <node id="REG154.04.STANDARD">
      <data key="d0">Standard</data>
      <data key="d1">REG154.04</data>
      <data key="d2">UN Regulation No. 154 (WLTP), 04 series of amendments (GRPE working document)</data>
      <data key="d3">154</data>
      <data key="d4">UNECE 1958 Agreement Contracting Parties</data>
