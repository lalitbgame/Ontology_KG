      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Declared value CO2_AF = Phase combined value (CO2aveL × DL) + (CO2aveM × DM) + (CO2aveH × DH) + (CO2aveexH × DexH) Phase combined value = DL + DM + DH + DexH</data>
      <data key="d74">equations/REG154.04.ANNEX-B6.1.2.4.1.1.EQ-1.png</data>
    </node>
