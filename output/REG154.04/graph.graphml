      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "t_i", "symbol_text": "t_i", "description": "the time at which the i^th data set was sampled, s.", "unit": "s"}]</data>
