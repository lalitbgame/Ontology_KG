    <node id="REG154.04.ANNEX-B7.3.3.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p441-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.3.1.1</data>
