      <data key="d20">6.4</data>
      <data key="d27">6.4</data>
      <data key="d21">2</data>
      <data key="d22">444</data>
      <data key="d23">444</data>
      <data key="d28">True</data>
      <data key="d8">(Reserved)</data>
      <data key="d24" />
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Subsection"]</data>
      <data key="d29">ANNEX-B7</data>
    </node>
    <node id="REG154.04.ANNEX-B7.6.5">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B7.6</data>
      <data key="d20">6.5</data>
      <data key="d27">6.5</data>
      <data key="d21">2</data>
      <data key="d22">444</data>
      <data key="d23">444</data>
      <data key="d28">True</data>
      <data key="d8">For a vehicle with a positive ignition engine fuelled with petrol (E10/E10H)</data>
      <data key="d24">[EQ:REG154.04.ANNEX-B7.6.5.EQ-1]</data>
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Subsection"]</data>
