      <data key="d62">using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "PM_weighted", "symbol_text": "PM_weighted", "description": "the utility factor-weighted particulate matter emission, mg/km", "unit": "mg/km"}, {"symbol": "UF_c", "symbol_text": "UF_c", "description": "the utility factor of cycle c according to Appendix 5 to this annex", "unit": null}, {"symbol": "PM_CD,c", "symbol_text": "PM_CD,c", "description": "the charge-depleting particulate matter emission during cycle c determined according to paragraph 3.3. of Annex B7 for the charge-depleting Type 1 test, mg/km", "unit": "mg/km"}, {"symbol": "PM_CS", "symbol_text": "PM_CS", "description": "the particulate matter emission of the charge-sustaining Type 1 test according to paragraph 4.1.1. of this annex, mg/km", "unit": "mg/km"}, {"symbol": "c", "symbol_text": "c", "description": "the index number of the cycle considered", "unit": null}, {"symbol": "n_c", "symbol_text": "n_c", "description": "the number of applicable WLTP test cycles driven until the end of the transition cycle n according to paragraph 3.2.4.4. of this annex.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">PM_weighted=sum_{c=1} (UF_c* PM_{CD,c}) + (1 -sum_{c=1} UF_c) * PM_CS</data>
      <data key="d56">PM_{weighted}=\sum_{c=1} (UF_{c} \cdot PM_{CD,c}) + (1 -\sum_{c=1} UF_{c}) \cdot PM_{CS}</data>
