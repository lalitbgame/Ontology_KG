      <data key="d20">4.1.5</data>
      <data key="d27">4.1.5</data>
      <data key="d21">3</data>
      <data key="d22">347</data>
      <data key="d23">347</data>
      <data key="d28">True</data>
      <data key="d8">Recommended system descriptions</data>
      <data key="d24" />
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Provision"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.5.1">
      <data key="d0">Clause</data>
