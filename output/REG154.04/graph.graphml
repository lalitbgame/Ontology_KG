    <node id="REG154.04.ANNEX-B7.3.2.4.1.1.2.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p439-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.4.1.1.2.3</data>
      <data key="d22">439</data>
      <data key="d60">[170.4, 68.7, 442.9, 138.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">3.2.4.1.1.2.3. Calculating the weighed mean of the rolling resistances</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">x RR_x=(RR_{x,FA}* mp_{x,FA}) + (RR_{x,RA}* (1 -mp_{x,FA}))</data>
      <data key="d56">x RR_{x}=(RR_{x,FA} \cdot mp_{x,FA}) + (RR_{x,RA} \cdot (1 -mp_{x,FA}))</data>
      <data key="d69" />
      <data key="d70">["x", "RR_x", "RR_x,FA", "mp_x,FA", "RR_x,RA"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">RRx = (RRx,FA × mpx,FA) + (RRx,RA × (1 −mpx,FA)) x</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.4.1.1.2.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.5.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
