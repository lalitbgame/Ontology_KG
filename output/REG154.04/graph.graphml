      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">2)</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Fdj", "symbol_text": "Fdj", "description": "the initial chassis dynamometer setting load, N", "unit": "N"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">A B C_d_{*}_d_d_{*}_{*}== C=B A_d_d_d=+ A+ C+ B(A_t_t_t_d-B-C-A+ A_s_s_s_t-A_s)+(B_d+ B_t-B_s)v_j+(C_d+ C_t-C_s)v_j</data>
      <data key="d56">A B C_{d}_{\cdot}_{d}_{d}_{\cdot}_{\cdot}== C=B A_{d}_{d}_{d}=+ A+ C+ B(A_{t}_{t}_{t}_{d}-B-C-A+ A_{s}_{s}_{s}_{t}-A_{s})+(B_{d}+ B_{t}-B_{s})v_{j}+(C_{d}+ C_{t}-C_{s})v_{j}</data>
      <data key="d69" />
      <data key="d70">["A", "B", "C_d_*", "C", "A_d_d", "A_t_t", "A_s_s", "A_s", "B_d", "B_t-B_s", "v_j", "C_d", "C_t-C_s"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">= (Ad + At −As) + (Bd + Bt−Bs)vj + (Cd + Ct −Cs)vj Ad ∗= Ad + At −As Bd ∗= Bd + Bt −Bs Cd ∗= Cd + Ct −Cs</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.4.EQ-2.png</data>
    </node>
