      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">FE_{ind ,p}=(E-E)/(1/FE_{L,p}+ ((E^{3,p}-E^{1,p})/(2,p 1,p)) * (1/FE_{H,p}-1/FE_{L,p}))</data>
      <data key="d56">FE_{ind ,p}=\frac{E-E}{1/FE_{L,p}+ (\frac{E^{3,p}-E^{1,p}}{2,p 1,p}) \cdot (1/FE_{H,p}-1/FE_{L,p})}</data>
