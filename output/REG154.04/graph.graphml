      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">at velocity v_j, seconds, s, given by the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65">Table A4/4.</data>
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δt_jai and Δt_jbi Δt_ji=(1 2 1)/((Δtjai)+ (Δtjbi))</data>
      <data key="d56">\Delta t_{jai}and\Delta t_{jbi}\Delta t_{ji}=\frac{1 2 1}{(\Delta tjai)+ (\Delta tjbi)}</data>
