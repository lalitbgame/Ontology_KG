    <edge source="REG154.04.ANNEX-B8.1.4.1.2" target="REG154.04/EXT:UNR-85" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">Regulation No. 85</data>
      <data key="d93">For PEVs, the downscaling procedure, according to paragraphs 8.2.3. and 8.3. of Annex B1, may be applied on the test cycles according to paragraph 3.3. of Annex B1 by replacing the rated power with maximum net power according to Regulation No. 85 or peak power according to UN Regulation No. 177 in the case of multiple electric machines.</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-B8.1.4.1.2" target="REG154.04/EXT:UNR-177" id="0">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">UN Regulation No. 177</data>
      <data key="d93">For PEVs, the downscaling procedure, according to paragraphs 8.2.3. and 8.3. of Annex B1, may be applied on the test cycles according to paragraph 3.3. of Annex B1 by replacing the rated power with maximum net power according to Regulation No. 85 or peak power according to UN Regulation No. 177 in the case of multiple electric machines.</data>
      <data key="d94">direct</data>
    </edge>
