      <data key="d20">1.4</data>
      <data key="d27">1.4</data>
      <data key="d21">2</data>
      <data key="d22">597</data>
      <data key="d23">597</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">This paragraph is applicable to Level 1A only: As an alternative to the requirements of paragraph 1.3., the vehicle manufacturer may declare the compliance defined in paragraphs 1.1. and 1.2. during Type Approval.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Subsection", "Paragraph"]</data>
      <data key="d29">ANNEX-C1</data>
    </node>
