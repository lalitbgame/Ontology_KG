      <data key="d61">False</data>
      <data key="d62">using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "P_wot", "symbol_text": "P_wot", "description": "the power available at nk at full load condition from the full load power curve", "unit": null}, {"symbol": "SM", "symbol_text": "SM", "description": "a safety margin accounting for the difference between the stationary full load condition power curve and the power available during transition conditions. SM shall be set to 10 per cent", "unit": null}, {"symbol": "ASM", "symbol_text": "ASM", "description": "an additional power safety margin which may be applied at the request of the manufacturer.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">P_{available_k}= P_wot(n_k) *(1 -(SM + ASM))</data>
      <data key="d56">P_{available_k}= P_{wot}(n_{k}) \cdot (1 -(SM + ASM))</data>
