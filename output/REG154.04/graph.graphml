      <data key="d64">[{"symbol": "Q_s", "symbol_text": "Q_s", "description": "the air flow rate at standard conditions (101.325 kPa, 273.15 K (0 °C)), m/s", "unit": null}, {"symbol": "Qreference", "symbol_text": "Qreference", "description": "the air flow rate of the calibration flow meter at standard conditions (101.325 kPa, 273.15 K (0 °C)), m/s", "unit": null}, {"symbol": "K_v", "symbol_text": "K_v", "description": "the calibration coefficient. For UFM systems without a heat exchanger, K_v shall be plotted as a function of Tact. The maximum variation in K_v shall not exceed 0.3 per cent of the arithmetic average K_v value of all the measurements taken at the different temperatures.", "unit": null}]</data>
