      <data key="d20">2.1.1</data>
      <data key="d27">2.1.1</data>
      <data key="d21">3</data>
      <data key="d22">599</data>
      <data key="d23">599</data>
      <data key="d28">True</data>
      <data key="d8">Measured UBE values for PEVs</data>
      <data key="d24">[TABLE:REG154.04.ANNEX-C1.APP3.2.1.1.TABLE-U1]</data>
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Provision"]</data>
      <data key="d29">ANNEX-C1.APP3</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.2.1.2">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-C1.APP3.2.1</data>
      <data key="d20">2.1.2</data>
