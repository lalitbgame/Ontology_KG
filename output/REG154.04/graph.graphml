      <data key="d20">4.1.4</data>
      <data key="d27">4.1.4</data>
      <data key="d21">3</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">Analysers</data>
      <data key="d24" />
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Provision"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.1">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.1</data>
      <data key="d27">4.1.4.1</data>
      <data key="d21">4</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">General requirements for gas analysis</data>
      <data key="d24" />
      <data key="d25" />
      <data key="d26">False</data>
      <data key="d7">["Provision"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.1.1">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4.1</data>
      <data key="d20">4.1.4.1.1</data>
      <data key="d27">4.1.4.1.1</data>
      <data key="d21">5</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">The analysers shall have a measuring range compatible with the accuracy required to measure the concentrations of the exhaust gas sample compounds.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.1.2">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4.1</data>
      <data key="d20">4.1.4.1.2</data>
      <data key="d27">4.1.4.1.2</data>
      <data key="d21">5</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">If not defined otherwise, measurement errors shall not exceed ±2 per cent (intrinsic error of analyser) disregarding the reference value for the calibration gases.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.1.3">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4.1</data>
      <data key="d20">4.1.4.1.3</data>
      <data key="d27">4.1.4.1.3</data>
      <data key="d21">5</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">The ambient air sample shall be measured on the same analyser with the same range.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.1.4">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4.1</data>
      <data key="d20">4.1.4.1.4</data>
      <data key="d27">4.1.4.1.4</data>
      <data key="d21">5</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">No gas drying device shall be used before the analysers unless it is shown to have no effect on the content of the compound in the gas stream.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.2">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.2</data>
      <data key="d27">4.1.4.2</data>
      <data key="d21">4</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">Carbon monoxide (CO) and carbon dioxide (CO2) analysis</data>
      <data key="d24">The analysers shall be of the non-dispersive infrared (NDIR) absorption type.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.3">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.3</data>
      <data key="d27">4.1.4.3</data>
      <data key="d21">4</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">Hydrocarbons (HC) analysis for all fuels other than diesel fuel</data>
      <data key="d24">The analyser shall be of the flame ionization (FID) type calibrated with propane gas expressed in equivalent carbon atoms (C1).</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.4">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.4</data>
      <data key="d27">4.1.4.4</data>
      <data key="d21">4</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">Hydrocarbons (HC) analysis for diesel fuel and optionally for other fuels</data>
      <data key="d24">The analyser shall be of the heated flame ionization type with detector, valves, pipework, etc., heated to 190 °C •10 °C. It shall be calibrated with propane gas expressed equivalent to carbon atoms (C1).</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.5">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.5</data>
      <data key="d27">4.1.4.5</data>
      <data key="d21">4</data>
      <data key="d22">346</data>
      <data key="d23">346</data>
      <data key="d28">True</data>
      <data key="d8">Methane (CH4) analysis</data>
      <data key="d24">The analyser shall be either a gas chromatograph combined with a flame ionization detector (FID), or a flame ionization detector (FID) combined with a non-methane cutter (NMC-FID), calibrated with methane or propane gas expressed equivalent to carbon atoms (C1).</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.4.6">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.4</data>
      <data key="d20">4.1.4.6</data>
      <data key="d27">4.1.4.6</data>
      <data key="d21">4</data>
      <data key="d22">347</data>
      <data key="d23">347</data>
      <data key="d28">True</data>
      <data key="d8">Nitrogen oxides (NOx) analysis</data>
      <data key="d24">The analysers shall be of chemiluminescent (CLA) or non-dispersive ultraviolet resonance absorption (NDUV) types.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
