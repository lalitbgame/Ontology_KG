      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">UN Regulation No. 85</data>
      <data key="d93">"Rated engine power" (P_rated) means maximum net power of the engine or motor in kW as per the requirements of UN Regulation No. 85 or system power as per the requirement of UN Regulation No. 177 if applicable.</data>
      <data key="d94">direct</data>
    </edge>
