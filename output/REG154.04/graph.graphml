      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">UN Regulation No. 85</data>
      <data key="d93">Deviation of the linear interpolation from the full load power curve according to UN Regulation No. 85 shall not exceed 2 per cent.</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-B2.2" target="REG154.04/EXT:UNR-85" id="1">
      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">UN Regulation No. 85</data>
      <data key="d93">The full load power at engine speeds not covered by UN Regulation No. 85 shall be determined according to the method described in UN Regulation No. 85;</data>
      <data key="d94">direct</data>
    </edge>
