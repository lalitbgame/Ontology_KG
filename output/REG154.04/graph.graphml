    <node id="REG154.04.ANNEX-B4.8.1.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p322-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.3.1</data>
      <data key="d22">322</data>
      <data key="d60">[170.4, 483.8, 268.3, 518.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">coefficient, A_t, B_t and C_t, for each reference speed, v_j:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_tj=A_t+ B_t v_j+ C_t v_j^{2}</data>
      <data key="d56">F_{tj}=A_{t}+ B_{t}v_{j}+ C_{t}v_{j}^{2}</data>
      <data key="d69">F_tj</data>
