    <edge source="REG154.04.BODY" target="REG154.04/EXT:UNR-83" id="0">
      <data key="d90">CITES</data>
      <data key="d91">replaces</data>
      <data key="d92">UN Regulation No. 83</data>
      <data key="d93">The WLTP Type 1 test replaces both the current Type 1 test in UN Regulation No. 83 and UN Regulation No. 101, whilst the updated Evaporative Emissions test procedure (Type 4 test) replaces that currently in UN Regulation No 83.</data>
      <data key="d94">direct</data>
    </edge>
