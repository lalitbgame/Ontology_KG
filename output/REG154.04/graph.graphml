      <data key="d62">calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "FC_CD", "symbol_text": "FC_CD", "description": "the utility factor weighted charge-depleting fuel consumption, l/100 km in the case of OVC-HEVs and kg/100km in the case of OVC-FCHVs", "unit": null}, {"symbol": "FC_CD_,j", "symbol_text": "FC_CD ,j", "description": "the fuel consumption for phase j of the charge-depleting Type 1 test, determined according to paragraph 6. of Annex B7, l/100 km in the case of OVC-HEVs and kg/100km in the case of OVC-FCHVs", "unit": null}, {"symbol": "UF_j", "symbol_text": "UF_j", "description": "the utility factor of phase j according to Appendix 5 to this annex", "unit": null}, {"symbol": "j", "symbol_text": "j", "description": "the index number for the considered phase", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">FC_CD=sum (j=1sum k j UF CD ,j)/(j=1 j)^{k}(UF*FC)</data>
      <data key="d56">FC_{CD}=\sum \frac{j=1\sum k j UF CD ,j}{j=1 j}^{k}(UF \cdot FC)</data>
