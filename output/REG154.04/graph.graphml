      <data key="d61">False</data>
      <data key="d62">for which C_j̅ satisfies the precision ρ_j according to the following equation:</data>
      <data key="d63">for which C_j̅ satisfies the precision ρ_j according to the following equation:</data>
      <data key="d64">[{"symbol": "n", "symbol_text": "n", "description": "the number pairs of measurements for C_jm", "unit": null}, {"symbol": "C_j̅", "symbol_text": "C_j̅", "description": "the running resistance at the speed v_j, Nm, given by the equation:", "unit": null}]</data>
