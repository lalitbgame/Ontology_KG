      <data key="d56">D_{aero}=(_{1}_{2}) \cdot \rho \cdot A D_{aero}=_{f}( \cdot v^{1}_{2}) \cdot \rho \cdot A_{r}_{2}(a_{0}+ a_{f}_{1} \cdot v Y + a_{r}_{2}Y_{2}+ a_{3}Y_{3}+ a_{4}Y_{4})</data>
