      <data key="d44">REG154.04.ANNEX-B4.4.4.3.1</data>
      <data key="d22">302</data>
      <data key="d60">[170.4, 409.5, 382.5, 579.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">v k C C_ji_ji_js v C^{jm}_jm==sum_{1 ksum k i=1} sum^{1 k k i=1} v C^{ji}_ji- C_js</data>
      <data key="d56">v k C C_{ji}_{ji}_{js}v C^{jm}_{jm}==\sum_{1 k\sum k i=1} \sum^{1 k k i=1} v C^{ji}_{ji}- C_{js}</data>
      <data key="d69" />
      <data key="d70">["v", "k", "C", "C_ji_ji", "jm", "sum_1_ksum_k_i=1", "i", "ji", "C_js", "sum_1_ksum_k_i"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">k ∑ vji vjm = 1 k i=1 k∑ Cjm = Cji − Cjs 1 k i=1 vji k Cji Cjs</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.4.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.4.3.1.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p302-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.4.4.3.1</data>
      <data key="d22">302</data>
      <data key="d60">[170.4, 573.9, 365.1, 667.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">m_st(1sum^{C} k js C)/(k i=1 ji)C_js=(m_st+ m_r)* α_j r_j.</data>
      <data key="d56">m_{st}\frac{1\sum^{C} k js C}{k i=1 ji}C_{js}=(m_{st}+ m_{r}) \cdot α_{j}r_{j}.</data>
      <data key="d69" />
      <data key="d70">["m_st", "C", "k", "js", "i", "ji", "C_js", "m_r", "α_j", "r_j."]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Cjs = (mst + mr) × αjrj. Cjs 1 k ∑ k Cji i=1 mst</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.4.3.1.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.4.3.1.EQ-3">
