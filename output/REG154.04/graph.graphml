      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">where:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">D D D_mech_aero_grav== (= D m * g * (_1_2) ρC_tyre+ D_D(Y)A dh ds_f+ D_f)v_r_2_r;;</data>
      <data key="d56">D D D_{mech}_{aero}_{grav}== (= D m \cdot g \cdot (_{1}_{2}) \rho C_{tyre}+ D_{D}(Y)A dh ds_{f}+ D_{f})v_{r}_{2}_{r};;</data>
      <data key="d69">D_D_D_mech_aero_grav</data>
      <data key="d70">["D_mech_aero", "m", "g", "ρC_tyre", "D_D", "Y", "A", "dh", "ds_f", "D_f", "v_r_2", "D_D_D_mech_aero_grav"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Dmech = Dtyre + Df + Dr; 2) ρCD(Y)Afvr Daero = (1 2; Dgrav = m × g × (dh ds)</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.2.5.1.EQ-2.png</data>
    </node>
