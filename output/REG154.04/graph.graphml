    <node id="REG154.04.ANNEX-B4.6.6.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p315-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.6.6.3</data>
      <data key="d22">315</data>
      <data key="d60">[205.8, 625.7, 450.0, 685.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">as fj.</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "c1", "symbol_text": "c1", "description": "the tyre rolling resistance fraction of f_jDyno", "unit": null}, {"symbol": "c2", "symbol_text": "c2", "description": "a chassis dynamometer-specific radius correction factor", "unit": null}, {"symbol": "f_jDyno", "symbol_text": "fjDyno", "description": "the force calculated in paragraph 6.5.2.3.3. of this annex for each reference speed j, N", "unit": "N"}, {"symbol": "R_Wheel", "symbol_text": "RWheel", "description": "one-half of the nominal design tyre diameter, m", "unit": "m"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_j= f_jDyno* c1 * √(1)/((R R_Wheel)/(Dyno)* c2 + 1)+ f_jDyno* (1 -c1)</data>
      <data key="d56">f_{j}= f_{jDyno} \cdot c1 \cdot √\frac{1}{\frac{R R_{Wheel}}{Dyno} \cdot c2 + 1}+ f_{jDyno} \cdot (1 -c1)</data>
      <data key="d69">f_j</data>
      <data key="d70">["f_j", "f_jDyno", "c1", "R", "R_Wheel", "Dyno", "c2"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">1 fj = fjDyno × c1 × √ + fjDyno × (1 −c1) RWheel RDyno × c2 + 1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.6.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.6.3.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p316-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.6.6.3</data>
      <data key="d22">316</data>
      <data key="d60">[258.3, 139.3, 395.1, 198.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">As an alternative the following conservative equation may be used:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_j= f_jDyno* √(1)/((R R_Wheel)/(Dyno)* 0.2 + 1)</data>
      <data key="d56">f_{j}= f_{jDyno} \cdot √\frac{1}{\frac{R R_{Wheel}}{Dyno} \cdot 0.2 + 1}</data>
      <data key="d69">f_j</data>
      <data key="d70">["f_j", "f_jDyno", "R", "R_Wheel", "Dyno"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">1 fj = fjDyno × √ RWheel RDyno × 0.2 + 1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.6.3.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p316-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.1</data>
      <data key="d22">316</data>
      <data key="d60">[170.4, 288.6, 413.9, 392.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">be corrected to reference conditions using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F f_j_Dj F_Dj=(f_j(1 -K_1)) * (1 + K_0(T -293))</data>
      <data key="d56">F f_{j}_{Dj}F_{Dj}=(f_{j}(1 -K_{1})) \cdot (1 + K_{0}(T -293))</data>
      <data key="d69" />
      <data key="d70">["F", "f_j_Dj", "F_Dj", "f_j", "K_1", "K_0", "T"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">FDj = (fj(1 −K1)) × (1 + K0(T −293)) FDj fj</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.2.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p316-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.2.1</data>
      <data key="d22">316</data>
      <data key="d60">[256.1, 586.7, 382.4, 624.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">calculated using the equation below.</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "(C_D_×_A_f_)_j", "symbol_text": "(C_D × A_f )_j", "description": "the product of the drag coefficient and frontal area measured in the wind tunnel at a certain reference speed point j, if applicable, m2", "unit": null}, {"symbol": "ρ_0", "symbol_text": "ρ_0", "description": "the dry air density defined in paragraph 3.2.10. of this Regulation, kg/m3", "unit": null}, {"symbol": "F_w", "symbol_text": "F_w", "description": "the aerodynamic force calculated at wind speed w, N", "unit": "N"}, {"symbol": "v_w", "symbol_text": "v_w", "description": "the applicable wind speed, km/h.", "unit": "km/h"}, {"symbol": "w", "symbol_text": "w", "description": "the reference to the applicable wind speed \"0wind\", \"low\" and \"high\"", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_Aw= (C_D* A_f)_w*^{ρ}_2^{0}*_{3.6}^{v}^{2}^{w}_2</data>
      <data key="d56">F_{Aw}= (C_{D} \cdot A_{f})_{w} \cdot ^{\rho}_{2}^{0} \cdot _{3.6}^{v}^{2}^{w}_{2}</data>
      <data key="d69">F_Aw</data>
      <data key="d70">["F_Aw", "C_D", "A_f", "ρ", "v", "w"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">FAw = (CD × Af )w × 2 × 2 ρ0 vw 3.62</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.2.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.2.1.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p317-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.2.1</data>
      <data key="d22">317</data>
      <data key="d60">[170.4, 50.7, 199.9, 120.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">"high";</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">expression</data>
      <data key="d68">F F F_0wind_low_high</data>
      <data key="d56">F F F_{0wind}_{low}_{high}</data>
      <data key="d69" />
      <data key="d70">["F", "F_0wind_low", "F_F_F_0wind_low_high"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">F0wind Flow Fhigh</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.2.1.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.2.1.EQ-3">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p317-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.2.1</data>
      <data key="d22">317</data>
      <data key="d60">[306.4, 148.3, 399.7, 183.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">below:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F =f_1a* v + f_2a* v^{2}</data>
      <data key="d56">F =f_{1a} \cdot v + f_{2a} \cdot v^{2}</data>
      <data key="d69">F</data>
      <data key="d70">["F", "f_1a", "v", "f_2a"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">F = f1a × v + f2a × v 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.2.1.EQ-3.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.2.1.EQ-4">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p317-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.2.1</data>
      <data key="d22">317</data>
      <data key="d60">[301.1, 220.3, 404.6, 255.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">aerodynamic force shall be applied for the reference speed points concerned.</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_Aj= f_1a* v_j+ f_2a* v_j^{2}</data>
      <data key="d56">F_{Aj}= f_{1a} \cdot v_{j}+ f_{2a} \cdot v_{j}^{2}</data>
      <data key="d69">F_Aj</data>
      <data key="d70">["F_Aj", "f_1a", "v_j", "f_2a"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">FAj = f1a × vj + f2a × vj 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.2.1.EQ-4.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.2.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p317-r4</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.2.2</data>
      <data key="d22">317</data>
      <data key="d60">[170.4, 324.7, 359.9, 397.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">points concerned.</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_Aj F_Aj= (C_D* A_f)_j*^{ρ}_2^{0}*_{3.6}^{v}^{2}^{j}_2</data>
      <data key="d56">F_{Aj}F_{Aj}= (C_{D} \cdot A_{f})_{j} \cdot ^{\rho}_{2}^{0} \cdot _{3.6}^{v}^{2}^{j}_{2}</data>
      <data key="d69" />
      <data key="d70">["F_Aj", "C_D", "A_f", "ρ", "v", "j"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">FAj = (CD × Af )j × 2 × 2 vj ρ0 3.62 FAj</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.2.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.7.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p317-r5</data>
      <data key="d44">REG154.04.ANNEX-B4.6.7.3</data>
      <data key="d22">317</data>
      <data key="d60">[296.6, 521.4, 359.9, 556.2]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">annex shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_j^{*}=F_Dj+ F_Aj</data>
      <data key="d56">F_{j}^{\cdot}=F_{Dj}+ F_{Aj}</data>
      <data key="d69" />
      <data key="d70">["F_j", "F_Dj", "F_Aj"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Fj ∗= FDj + FAj</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.7.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.8.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p318-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.6.8</data>
      <data key="d22">318</data>
      <data key="d60">[260.6, 194.1, 395.2, 241.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">fulfilled:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "F_Dj,R", "symbol_text": "FDj,R", "description": "the corrected resistance of vehicle R measured on the flat belt or chassis dynamometer at reference speed j calculated according to paragraph 6.7.1. of this annex, N", "unit": "N"}, {"symbol": "F_Dj,N", "symbol_text": "F_Dj,N", "description": "the corrected resistance of vehicle N measured on the flat belt or chassis dynamometer at reference speed j calculated according to paragraph 6.7.1. of this annex, N", "unit": "N"}, {"symbol": "N", "symbol_text": "n", "description": "the total number of speed points.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">inequality</data>
      <data key="d68">|1 nsum ^{n}_{j=1}(F_{Dj,R}-F_{Dj,N})| &lt;=25 N</data>
      <data key="d56">|1 n\sum ^{n}_{j=1}(F_{Dj,R}-F_{Dj,N})| \le 25 N</data>
      <data key="d69">|1_nsum_^n_j</data>
      <data key="d70">["n", "j", "F_Dj,R", "F_Dj,N", "N"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">|1 n n∑ (FDj,R −FDj,N) | ≤25 N j=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.8.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.8.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p318-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.6.8.1</data>
      <data key="d22">318</data>
      <data key="d60">[170.4, 449.3, 319.3, 581.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">The delta road load shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F F F_{Dj,Delta}_{Dj,N}_{Dj,R}F_{Dj,Delta}=F_{Dj,N}-F_{Dj,R}</data>
      <data key="d56">F F F_{Dj,Delta}_{Dj,N}_{Dj,R}F_{Dj,Delta}=F_{Dj,N}-F_{Dj,R}</data>
      <data key="d69">F_F_F_Dj,Delta_Dj,N_Dj,RF_Dj,Delta</data>
      <data key="d70">["F", "F_Dj,Delta_Dj,N", "Dj", "R", "F_Dj,Delta", "F_Dj,N", "F_Dj,R", "F_F_F_Dj,Delta_Dj,N_Dj,RF_Dj,Delta"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">FDj,Delta = FDj,N −FDj,R FDj,Delta FDj,N FDj,R</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.8.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.6.8.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p318-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.6.8.2</data>
      <data key="d22">318</data>
      <data key="d60">[280.1, 694.0, 362.1, 765.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f f f_{0,N}_{1,N}_{2,N}===f f f_{0,R}_{1,R}_{2,R}+ f+ f+ f_{0,Delta}_{1,Delta}_{2,Delta}</data>
      <data key="d56">f f f_{0,N}_{1,N}_{2,N}===f f f_{0,R}_{1,R}_{2,R}+ f+ f+ f_{0,Delta}_{1,Delta}_{2,Delta}</data>
      <data key="d69" />
      <data key="d70">["f", "f_0,N_1,N", "N", "f_0,R_1,R", "R", "f_0,Delta_1,Delta", "Delta", "f_0,Delta_1,Delta_2,Delta"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">f0,N = f0,R + f0,Delta f1,N = f1,R + f1,Delta f2,N = f2,R + f2,Delta</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.6.8.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.7.3.4.3.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p321-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.7.3.4.3.3</data>
      <data key="d22">321</data>
      <data key="d60">[170.4, 278.9, 287.8, 350.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">according to the following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f f f_0a_1a_2a== f=f f_1_0_2+ B+ A+ C_{d_alt}_{d_alt}_{d_alt}-B-C-A_{d_WLTC}_{d_WLTC}_{d_WLTC}</data>
      <data key="d56">f f f_{0a}_{1a}_{2a}== f=f f_{1}_{0}_{2}+ B+ A+ C_{d_alt}_{d_alt}_{d_alt}-B-C-A_{d_WLTC}_{d_WLTC}_{d_WLTC}</data>
      <data key="d69" />
      <data key="d70">["f", "f_0a_1a", "f_1_0", "B", "A", "C_d_alt_d_alt", "d_alt", "C", "A_d_WLTC_d_WLTC", "d_WLTC", "C_d_alt_d_alt_d_alt", "A_d_WLTC_d_WLTC_d_WLTC"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">f0a = f0 + Ad_alt −Ad_WLTC f1a = f1 + Bd_alt −Bd_WLTC f2a = f2 + Cd_alt −Cd_WLTC</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.7.3.4.3.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p321-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.1</data>
      <data key="d22">321</data>
      <data key="d60">[283.9, 742.1, 387.7, 776.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">A_d, B_d and C_d, of the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_d= A_d+ B_d v + C_d v^{2}</data>
      <data key="d56">F_{d}= A_{d}+ B_{d}v + C_{d}v^{2}</data>
      <data key="d69">F_d</data>
      <data key="d70">["F_d", "A_d", "B_d", "v", "C_d"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">Fd = Ad + Bdv + Cdv 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.1.EQ-1.png</data>
