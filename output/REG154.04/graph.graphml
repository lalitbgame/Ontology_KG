      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">determined by the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "D_k", "symbol_text": "D_k", "description": "the average distance of the valid tests after the run-in, km", "unit": "km"}, {"symbol": "Dj", "symbol_text": "Dj", "description": "the system odometer setting of the CoP test vehicle, km", "unit": "km"}, {"symbol": "MCO2,j", "symbol_text": "MCO2,j", "description": "the mass CO2 emission measured on the CoP test vehicle, g/km", "unit": "g/km"}]</data>
      <data key="d28">True</data>
