      <data key="d1">REG154.04</data>
      <data key="d59">p295-r6</data>
      <data key="d44">REG154.04.ANNEX-B4.4.3.1.4.4</data>
      <data key="d22">295</data>
      <data key="d60">[297.4, 733.0, 356.2, 776.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">velocity v_j, seconds, s, given by:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δt_j=(1+2 1)/(Δtja Δtjb)</data>
      <data key="d56">\Delta t_{j}=\frac{1+2 1}{\Delta tja\Delta tjb}</data>
      <data key="d69">Delta_t_j</data>
      <data key="d70">["Delta_t_j", "Delta_tja", "Delta_tjb", "Delta_tja_Delta_tjb"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">∆tj = 2 1 + 1 ∆tja ∆tjb</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.4.EQ-3.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.1.4.4.EQ-4">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p296-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.4.3.1.4.4</data>
      <data key="d22">296</data>
      <data key="d60">[294.4, 104.0, 358.1, 162.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">given by the following two equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δt_ja=(sum)/(n i=1(t 1)/(jai))n</data>
      <data key="d56">\Delta t_{ja}=\frac{\sum}{n i=1\frac{t 1}{jai}}n</data>
      <data key="d69">Delta_t_ja</data>
      <data key="d70">["Delta_t_ja", "n", "i", "t"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">n ∆tja = 1 ∑ tjai n i=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.4.EQ-4.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.1.4.4.EQ-5">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
