    <node id="REG154.04.ANNEX-B7.3.3.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p441-r5</data>
      <data key="d44">REG154.04.ANNEX-B7.3.3.2</data>
      <data key="d22">441</data>
      <data key="d60">[291.4, 492.1, 364.4, 526.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Calculation of PM using the double dilution method</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "V_ep", "symbol_text": "V_ep", "description": "the volume of diluted exhaust gas flowing through the particulate sample filter under standard conditions", "unit": null}, {"symbol": "V_set", "symbol_text": "V_set", "description": "the volume of the double diluted exhaust gas passing through the particulate sampling filters under standard conditions", "unit": null}, {"symbol": "V_ssd", "symbol_text": "V_ssd", "description": "the volume of the secondary dilution air under standard conditions.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">V_ep= V_set-V_ssd</data>
      <data key="d56">V_{ep}= V_{set}-V_{ssd}</data>
      <data key="d69">V_ep</data>
      <data key="d70">["V_ep", "V_set-V_ssd"]</data>
