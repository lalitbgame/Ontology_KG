      <data key="d67">inequality</data>
      <data key="d68">ρ_j=(√n * C)/(j)h * s&lt;=0.030</data>
      <data key="d56">\rho _{j}=\frac{√n \cdot C}{j}h \cdot s \le 0.030</data>
