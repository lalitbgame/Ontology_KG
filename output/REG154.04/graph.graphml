    <edge source="REG154.04.BODY.8.1.6" target="REG154.04/EXT:ISO.31000" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">ISO 31000:2018</data>
      <data key="d93">For Level 1A and Level 2 only: The manufacturers arrangements and documented control plans shall be based on a risk assessment methodology consistent with the international standard ISO 31000:2018 — Risk Management — Principles and guidelines.</data>
      <data key="d97">2018</data>
      <data key="d94">direct</data>
