      <data key="d23">348</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Heated sample probe in the dilution tunnel located in the same vertical plane as the particulate and, if applicable, particle sample probes.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
