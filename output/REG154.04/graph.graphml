      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">ΔE E_{fuel,CS}_{REESS ,CS}c=|ΔE(E^{REESS,CS})/(fuel,CS)|</data>
      <data key="d56">\Delta E E_{fuel,CS}_{REESS ,CS}c=|\Delta E\frac{E^{REESS,CS}}{fuel,CS}|</data>
