      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">ΔE_{REESS,avg,i,CC}ΔE_{REESS.CC,ave}=^{n}sum_{i=1} ΔE_{REESS,avg,i,CC}</data>
      <data key="d56">\Delta E_{REESS,avg,i,CC}\Delta E_{REESS.CC,ave}=^{n}\sum_{i=1} \Delta E_{REESS,avg,i,CC}</data>
      <data key="d69">Delta_E_REESS,avg,i,CCDelta_E_REESS.CC,ave</data>
      <data key="d70">["Delta_E_REESS,avg,i,CC", "Delta_E_REESS.CC,ave", "n", "sum_i=1", "Delta_E_REESS,avg,i,CCDelta_E_REESS.CC,ave", "1_Delta_E_REESS,avg,i,CC"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">𝑛 ∆𝐸𝑅𝐸𝐸𝑆𝑆.𝐶𝐶,𝑎𝑣𝑒= ∑Δ𝐸𝑅𝐸𝐸𝑆𝑆,𝑎𝑣𝑔,𝑖,𝐶𝐶 𝑖=1 ∆𝐸𝑅𝐸𝐸𝑆𝑆,𝑎𝑣𝑔,𝑖,𝐶𝐶</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.3.1.1.EQ-5.png</data>
    </node>
