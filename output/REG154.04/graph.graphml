    <node id="REG154.04.ANNEX-B7.1.4.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p421-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.1.4</data>
      <data key="d22">421</data>
      <data key="d60">[313.9, 172.3, 427.8, 253.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Calculation of combined cycle values:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Mi/CO2,c,2", "symbol_text": "Mi/CO2,c,2", "description": "the emission results over the total cycle; d_p are the driven distances of the cycle phases, p.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{CO2,c,2}M_{i,c,2}=sum_{=} (psum i,p,1 d* d_p)/(sum p M_{CO2,p,1}^{p}^{p}* d)(sum d^{p})/(p p)M</data>
      <data key="d56">M_{CO2,c,2}M_{i,c,2}=\sum_{=} \frac{p\sum i,p,1 d \cdot d_{p}}{\sum p M_{CO2,p,1}^{p}^{p} \cdot d}\frac{\sum d^{p}}{p p}M</data>
      <data key="d69" />
      <data key="d70">["M_CO2,c,2", "M_i,c,2", "sum_=", "i", "p", "d_p", "M_CO2,p,1", "M"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∑Mi,p,1 × dp Mi,c,2 = p ∑dp p ∑MCO2,p,1 × dp MCO2,c,2 = p ∑dp p</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.1.4.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.1.4.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p422-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.1.4</data>
      <data key="d22">422</data>
      <data key="d60">[316.1, 96.5, 429.7, 189.2]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">the combined cycle value:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{CO2,p,4}AF_Ki==M M(M^{CO2,c,4a})/(CO2,c,3)^{CO2,p,3}* AF_Ki</data>
      <data key="d56">M_{CO2,p,4}AF_{Ki}==M M\frac{M^{CO2,c,4a}}{CO2,c,3}^{CO2,p,3} \cdot AF_{Ki}</data>
      <data key="d69" />
      <data key="d70">["M_CO2,p,4", "AF_Ki", "M", "CO2", "c", "p"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">MCO2,p,4 = MCO2,p,3 × AFKi MCO2,c,4a AFKi = MCO2,c,3</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.1.4.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.2.2.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
