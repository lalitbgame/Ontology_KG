      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">The general form of the equation of motion is as follows:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">-m_e(dv dt) =D_mech+ D_aero+ D_grav</data>
      <data key="d56">-m_{e}(dv dt) =D_{mech}+ D_{aero}+ D_{grav}</data>
      <data key="d69" />
      <data key="d70">["m_e", "dv", "D_mech", "D_aero", "D_grav"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">−me (dv dt) = Dmech + Daero + Dgrav</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.2.5.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.2.5.1.EQ-2">
