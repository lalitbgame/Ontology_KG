      <data key="d22">425</data>
      <data key="d60">[303.4, 281.1, 353.1, 315.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">The volume shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "V", "symbol_text": "V", "description": "the volume of the diluted gas, in litres per test (prior to correction)", "unit": null}, {"symbol": "V_0", "symbol_text": "V0", "description": "the volume of gas delivered by the positive displacement pump in testing conditions, litres per pump revolution", "unit": null}, {"symbol": "N", "symbol_text": "N", "description": "the number of revolutions per test.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">V =V_0* N</data>
      <data key="d56">V =V_{0} \cdot N</data>
      <data key="d69">V</data>
      <data key="d70">["V", "V_0", "N"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">V = V0 × N</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.2.2.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.2.2.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p425-r3</data>
      <data key="d44">REG154.04.ANNEX-B7.2.2.1.1</data>
      <data key="d22">425</data>
      <data key="d60">[170.4, 430.5, 393.7, 595.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">according to the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">P P T_B_1_p K_1 V=_mix 101.325 (kPa)= V * K 273.15 (K)_1* (P(^{B}T^{1}))/(p)=-P 2.6961</data>
      <data key="d56">P P T_{B}_{1}_{p}K_{1}V=_{mix}101.325 (kPa)= V \cdot K 273.15 (K)_{1} \cdot (P\frac{^{B}T^{1})}{p}=-P 2.6961</data>
      <data key="d69" />
      <data key="d70">["P", "T_B_1", "K_1", "V", "kPa", "K", "B", "T", "p"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Vmix = V × K1 × (PB −P1 ) Tp 273.15 (K) K1 = 101.325 (kPa) = 2.6961 PB P1 Tp</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.2.2.1.1.EQ-1.png</data>
    </node>
