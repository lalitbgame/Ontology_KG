    </node>
    <node id="REG154.04.ANNEX-C1.APP3.2.2">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-C1.APP3.2</data>
      <data key="d20">2.2</data>
      <data key="d27">2.2</data>
      <data key="d21">2</data>
      <data key="d22">600</data>
      <data key="d23">605</data>
      <data key="d28">True</data>
      <data key="d8">Range for PEVs</data>
      <data key="d24">In the case that the fuel system contains more than one carbon canister, all references to the term "carbon canister" in this annex will apply to each carbon canister.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Subsection", "Paragraph"]</data>
      <data key="d29">ANNEX-C1.APP3</data>
    </node>
