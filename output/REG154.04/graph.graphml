      <data key="d73">Ftj = At + Btvj + Ctvj 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.3.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p322-r4</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.3.2</data>
      <data key="d22">322</data>
      <data key="d60">[227.5, 596.4, 372.6, 636.4]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">The measured road load shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Delta_v", "symbol_text": "Δv", "description": "5 km/h", "unit": null}, {"symbol": "F_mj", "symbol_text": "Fmj", "description": "the measured road load for each reference speed vj, N", "unit": "N"}, {"symbol": "TM", "symbol_text": "TM", "description": "the test mass of the vehicle, kg", "unit": "kg"}, {"symbol": "m_r", "symbol_text": "m_r", "description": "the equivalent effective mass of rotating components according to paragraph 2.5.1. of this annex, kg", "unit": "kg"}, {"symbol": "Delta_t_j", "symbol_text": "∆t_j", "description": "the coastdown time corresponding to speed v_j, s.", "unit": "s"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_mj=_{3.6}^{1}* (TM+ m_r) *(2 * Δv Δt)/(j)</data>
      <data key="d56">F_{mj}=_{3.6}^{1} \cdot (TM+ m_{r}) \cdot \frac{2 \cdot \Delta v\Delta t}{j}</data>
      <data key="d69">F_mj</data>
      <data key="d70">["F_mj", "TM", "m_r", "Delta_v", "Delta_t", "j"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">3.6 × (TM + mr) × Fmj = 1 2 × ∆v ∆tj</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.3.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.3.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p323-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.3.3</data>
      <data key="d22">323</data>
      <data key="d60">[259.1, 92.7, 396.7, 127.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">regression analysis:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_s= A_s+ (B_s* v) + (C_s* v^{2})</data>
      <data key="d56">F_{s}= A_{s}+ (B_{s} \cdot v) + (C_{s} \cdot v^{2})</data>
      <data key="d69">F_s</data>
      <data key="d70">["F_s", "A_s", "B_s", "v", "C_s"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">Fs = As + (Bs × v) + (Cs × v 2)</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.3.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.3.3.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p323-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.3.3</data>
      <data key="d22">323</data>
      <data key="d60">[256.8, 135.2, 398.9, 179.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">the following equation, using the calculated A_s, B_s and C_s:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_sj=A_s+ (B_s*^{v}_j^{) +}^{(C}_s*_v^{2}_j)</data>
      <data key="d56">F_{sj}=A_{s}+ (B_{s} \cdot ^{v}_{j}^{) +}^{(C}_{s} \cdot _{v}^{2}_{j})</data>
      <data key="d69">F_sj</data>
      <data key="d70">["F_sj", "A_s", "B_s", "v", "C"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Fsj = As + (Bs × vj) + (Cs × vj 2)</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.3.3.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.3.4.1.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p323-r3</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.3.4.1.2</data>
      <data key="d22">323</data>
      <data key="d60">[270.3, 387.7, 383.6, 499.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">using the following equations:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "At,_Bt_and_Ct", "symbol_text": "At, Bt and Ct", "description": "the target road load parameters", "unit": null}, {"symbol": "A_s_n,_B_s_nand_C_s_n", "symbol_text": "A_s_n, B_s_nand C_s_n", "description": "the simulated road load coefficients of the n^th run", "unit": null}, {"symbol": "A_d_n,_B_d_nand_C_d_n", "symbol_text": "A_d_n, B_d_nand C_d_n", "description": "the dynamometer setting coefficients of the n^th run", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the index number of coastdowns including the first stabilisation run.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">A B C== B= C A_t_t_t-sum_{--} (n=2 s 3 n d n)/(sum ^{4}(B-B))(n=2 s 3 n d n)/(sum 4 n=2(C s-C d))^{4}(A 3_n-A_n)</data>
      <data key="d56">A B C== B= C A_{t}_{t}_{t}-\sum_{--} \frac{n=2 s 3 n d n}{\sum ^{4}(B-B)}\frac{n=2 s 3 n d n}{\sum 4 n=2(C s-C d)}^{4}(A 3_{n}-A_{n})</data>
      <data key="d69" />
      <data key="d70">["A", "B", "C", "A_t_t", "sum_--", "n", "s", "A_n"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∑ (Asn −Adn) 4 A = At − n=2 3 ∑ (Bsn −Bdn) 4 B = Bt − n=2 3 ∑ (𝐶sn −𝐶dn) 4 C = Ct − n=2 3</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.3.4.1.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.4.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p323-r4</data>
      <data key="d44">REG154.04.ANNEX-B4.8.1.4</data>
      <data key="d22">323</data>
      <data key="d60">[175.0, 719.5, 482.3, 774.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_dj^{*}= F= (A_dj-F_d_j+ B= F_d v_dj_j+ C-F_d_sj v+ F_j_2) -(A_tj_s+ B_s v_j+ C_s v_j_2) + (A_t+ B_t v_j+ C_t v_j_2)</data>
      <data key="d56">F_{dj}^{\cdot}= F= (A_{dj}-F_{d}_{j}+ B= F_{d}v_{dj}_{j}+ C-F_{d}_{sj}v+ F_{j}_{2}) -(A_{tj}_{s}+ B_{s}v_{j}+ C_{s}v_{j}_{2}) + (A_{t}+ B_{t}v_{j}+ C_{t}v_{j}_{2})</data>
      <data key="d69" />
      <data key="d70">["F_dj", "F", "A_dj-F_d", "B", "F_d", "v_dj_j", "C", "F_d_sj", "v", "F_j_2", "A_tj_s", "B_s", "v_j", "C_s", "v_j_2", "A_t", "B_t", "C_t"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Fdj ∗= Fdj −Fj = Fdj −Fsj + Ftj = (Ad + Bdvj + Cdvj 2) −(As + Bsvj + Csvj 2) + (At + Btvj + Ctvj 2)</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.8.1.4.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.8.1.4.EQ-2">
