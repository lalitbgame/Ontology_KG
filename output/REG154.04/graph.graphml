      <data key="d70">["Delta_t_jai", "Delta_t_jbi", "Delta_t_ji", "Delta_tjai", "Delta_tjbi", "Delta_t_jai_and_Delta_t_jbi_Delta_t_ji"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∆tji = 2 1 1 ( )+ ( ) ∆tjai ∆tjbi ∆tjai and ∆tjbi</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.2.EQ-3.png</data>
    </node>
