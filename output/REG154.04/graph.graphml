      <data key="d62">calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "t", "symbol_text": "t", "description": "the time duration of the applicable test cycle, s", "unit": "s"}, {"symbol": "f", "symbol_text": "f", "description": "the data logging frequency of the particle counter, Hz.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">n = t * f</data>
      <data key="d56">n = t \cdot f</data>
      <data key="d69">n</data>
      <data key="d70">["n", "t", "f"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">n = t × f</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.4.EQ-3.png</data>
    </node>
