      <data key="d90">CITES</data>
      <data key="d91">requirement_source</data>
      <data key="d92">ISO 10521-1:2006</data>
      <data key="d93">Before the coastdown, the anemometer shall be calibrated for speed and yaw offset as specified in ISO 10521-1:2006(E) Annex A.</data>
      <data key="d97">2006</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-B4.4.3.2.1.4" target="REG154.04/EXT:ISO.10521-1" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">ISO 10521-1:2006</data>
      <data key="d93">Anemometer blockage shall be corrected for in the calibration procedure as described in ISO 10521-1:2006(E) Annex A in order to minimise its effect.</data>
      <data key="d97">2006</data>
      <data key="d94">direct</data>
    </edge>
