      <data key="d67">equation</data>
      <data key="d68">FC= 0.024 *V d* ( 1 C(Z)/(1)* MW*p(T^{1})/(1)^{O}-(Z)/(2)1*(MW)/(CO)p(T^{2}))/(2)(MW)/(CO_2)</data>
      <data key="d56">FC= 0.024 \cdot V d \cdot ( 1 C\frac{Z}{1} \cdot MW \cdot p\frac{T^{1}}{1}^{O}-\frac{Z}{2}1 \cdot \frac{MW}{CO}p\frac{T^{2})}{2}\frac{MW}{CO_{2}}</data>
