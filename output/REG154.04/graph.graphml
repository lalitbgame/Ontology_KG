    <node id="REG154.04.ANNEX-B1.1">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B1</data>
      <data key="d20">1</data>
      <data key="d27">1</data>
      <data key="d21">1</data>
      <data key="d22">192</data>
      <data key="d23">192</data>
      <data key="d28">True</data>
      <data key="d8">General requirements</data>
      <data key="d24">The cycle to be driven depends on the ratio of the test vehicle’s rated power to mass in running order minus 75 kg, W/kg, and its maximum velocity, v_max (as defined in paragraph 3.7.2. of this Regulation). The cycle resulting from the requirements described in this annex shall be referred to in other parts of this Regulation as the "applicable cycle".</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Section", "Paragraph"]</data>
      <data key="d29">ANNEX-B1</data>
    </node>
