      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">- Adjustment factor 2:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">EC AF_certified_{OVC.HEV}=EC(EC^{measured@TA})/(certified)</data>
      <data key="d56">EC AF_{certified}_{OVC.HEV}=EC\frac{EC^{measured@TA}}{certified}</data>
      <data key="d69">EC_AF_certified_OVC.HEV</data>
      <data key="d70">["EC", "AF_certified_OVC.HEV", "TA", "EC_AF_certified_OVC.HEV"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">𝐴𝐹𝑂𝑉𝐶.𝐻𝐸𝑉= 𝐸𝐶𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑@𝑇𝐴 𝐸𝐶𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑 𝐸𝐶𝑐𝑒𝑟𝑡𝑖𝑓𝑖𝑒𝑑</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.3.1.2.EQ-3.png</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.3.2.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p603-r3</data>
      <data key="d44">REG154.04.ANNEX-C1.APP3.3.2.1</data>
      <data key="d22">603</data>
      <data key="d60">[276.4, 209.9, 470.1, 255.2]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">equation below:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "MCO2,CD,avg", "symbol_text": "MCO2,CD,avg", "description": "the arithmetic average charge-depleting CO2 mass emission according to Annex B8, Paragraph 4.4.4.1., g/km", "unit": "g/km"}, {"symbol": "MCO2,CS", "symbol_text": "MCO2,CS", "description": "the charge-sustaining CO2 mass emission according to Annex B8, Table A8/5 Step no. 5, g/km", "unit": "g/km"}, {"symbol": "R_cdc", "symbol_text": "RCDC", "description": "the measured length of the charge-depleting test according to Annex B8, Table A8/8, Step no. 3, km", "unit": "km"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">EAER_measured= (M(^{CO2,CS}M^{CO2,CD,avg})/(CO2,CS)- M) * R_cdc</data>
      <data key="d56">EAER_{measured}= (M\frac{^{CO2,CS}M^{CO2,CD,avg}}{CO2,CS}- M) \cdot R_{cdc}</data>
      <data key="d69">EAER_measured</data>
      <data key="d70">["EAER_measured", "M", "CO2", "CS", "CD", "R_cdc"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">𝑀𝐶𝑂2,𝐶𝑆 − 𝑀𝐶𝑂2,𝐶𝐷,𝑎𝑣𝑔 𝐸𝐴𝐸𝑅𝑚𝑒𝑎𝑠𝑢𝑟𝑒𝑑= ( ) × 𝑅𝑐𝑑𝑐 𝑀𝐶𝑂2,𝐶𝑆</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.3.2.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.5.2.5.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p615-r1</data>
      <data key="d44">REG154.04.ANNEX-C1.APP3.5.2.5</data>
      <data key="d22">615</data>
      <data key="d60">[262.8, 284.9, 354.6, 319.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">significant digits using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">PF=HC_20w- HC_3W</data>
      <data key="d56">PF=HC_{20w}- HC_{3W}</data>
      <data key="d69">PF</data>
      <data key="d70">["PF", "HC_20w-", "HC_3W"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">PF = HC20w − HC3W</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.5.2.5.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.6.6.1.5.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p623-r1</data>
      <data key="d44">REG154.04.ANNEX-C1.APP3.6.6.1.5.1</data>
      <data key="d22">623</data>
      <data key="d60">[170.4, 264.6, 429.5, 361.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">separate test or during the preconditioning drive.</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Vol_Pcycle Vol_max=Vol_Pcycle*Vol(^{tank}Dist)/(Pcycle)* 0.85 *(FC 100)/(Pcycle)</data>
      <data key="d56">Vol_{Pcycle}Vol_{max}=Vol_{Pcycle} \cdot Vol\frac{^{tank}Dist}{Pcycle} \cdot 0.85 \cdot \frac{FC 100}{Pcycle}</data>
      <data key="d69">Vol_Pcycle_Vol_max</data>
      <data key="d70">["Vol_Pcycle", "Vol_max", "Vol", "Dist", "Pcycle", "FC", "Vol_Pcycle_Vol_max", "^tankDist"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">100 Voltank × 0.85 × FCPcycle Volmax = VolPcycle × DistPcycle VolPcycle</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.6.6.1.5.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.7.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p626-r2</data>
      <data key="d44">REG154.04.ANNEX-C1.APP3.7.1</data>
      <data key="d22">626</data>
      <data key="d60">[170.4, 640.7, 404.2, 679.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">The following equation shall be used:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "M_HC", "symbol_text": "MHC", "description": "the mass of hydrocarbons, grams", "unit": null}, {"symbol": "M_HC,out", "symbol_text": "M_HC,out", "description": "the mass of hydrocarbons exiting the enclosure in the case of fixed volume enclosures for diurnal emission testing, grams", "unit": null}, {"symbol": "M_HC,in", "symbol_text": "M_HC,in", "description": "the mass of hydrocarbon entering the enclosure in the case of fixed volume enclosures for diurnal emission testing, grams", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_HC=k * V * ((C HCf T*P f)/(f)-(C HCi T*P i)/(i)) + M_{HC,out}-M_{HC,in}</data>
      <data key="d56">M_{HC}=k \cdot V \cdot (\frac{C HCf T \cdot P f}{f}-\frac{C HCi T \cdot P i}{i}) + M_{HC,out}-M_{HC,in}</data>
      <data key="d69">M_HC</data>
      <data key="d70">["M_HC", "k", "V", "C", "HCf", "T", "P", "f", "HCi", "i", "M_HC,out", "M_HC,in"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">MHC= k × V × (CHCf×Pf ) + MHC,out −MHC,in − CHCi×Pi Tf Ti</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.7.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-C1.APP3.7.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p627-r1</data>
      <data key="d44">REG154.04.ANNEX-C1.APP3.7.1.1</data>
      <data key="d22">627</data>
      <data key="d60">[170.4, 357.7, 310.3, 397.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">manufacturer:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "M_HC", "symbol_text": "MHC", "description": "the mass of hydrocarbons, grams", "unit": null}, {"symbol": "CHC", "symbol_text": "CHC", "description": "the measured hydrocarbon concentration in the enclosure, ppm volume in C1 equivalent; V is the net enclosure volume corrected for the volume of the vehicle with the windows and the luggage compartment open, m . If the volume of the vehicle is not known, a volume of 1.42 m shall be subtracted", "unit": null}, {"symbol": "Ti", "symbol_text": "Ti", "description": "the initial ambient chamber temperature, K", "unit": "K"}, {"symbol": "Pi", "symbol_text": "Pi", "description": "the initial barometric pressure, kPa", "unit": null}, {"symbol": "H/C", "symbol_text": "H/C", "description": "the hydrogen to carbon ratio", "unit": null}, {"symbol": "H/C", "symbol_text": "H/C", "description": "taken to be 2.33 for puff loss overflow measurement in SHED and diurnal test losses; H/C is taken to be 2.20 for hot soak losses; H/C is taken to be 2.67 for calibration; k is 1.2 × 10^-4 × (12 + H/C), (g × K/(m3 × kPa)); i is the initial reading; f is the final reading.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_HC=k * V *(P T i)/(i)(C_HCf- C_HCi)</data>
      <data key="d56">M_{HC}=k \cdot V \cdot \frac{P T i}{i}(C_{HCf}- C_{HCi})</data>
      <data key="d69">M_HC</data>
      <data key="d70">["M_HC", "k", "V", "P", "T", "i", "C_HCf-", "C_HCi"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">(CHCf − CHCi) MHC= k × V × Pi Ti</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.7.1.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-C4.7.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p634-r1</data>
      <data key="d44">REG154.04.ANNEX-C4.7.1</data>
      <data key="d22">634</data>
      <data key="d60">[299.6, 642.2, 353.8, 691.4]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">each pollutant as follows:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">D. E. F. =Mi(Mi^{2})/(1)</data>
      <data key="d56">D. E. F. =Mi\frac{Mi^{2}}{1}</data>
      <data key="d69" />
      <data key="d70">["E", "F", "Mi"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Mi2 D. E. F. = Mi1</data>
      <data key="d74">equations/REG154.04.ANNEX-C4.7.1.EQ-1.png</data>
    </node>
