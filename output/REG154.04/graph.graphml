      <data key="d23">347</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Two sampling probes for continuous sampling of the dilution air and of the diluted exhaust gas/air mixture.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
