      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_CO_2_{-ind,p}=M_CO_2_{-L,p}+ (E(E^{3,p}-E-E^{1,p})/(2,p 1,p)) * (M_CO_2_{-H,p}-M_CO_2_{-L,p})</data>
