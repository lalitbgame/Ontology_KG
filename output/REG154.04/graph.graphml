      <data key="d68">E HV FC_{fuel,CS}_{CS,nb}E_{fuel,CS}= 10 * HV * FC_{CS,nb}* d_CS</data>
      <data key="d56">E HV FC_{fuel,CS}_{CS,nb}E_{fuel,CS}= 10 \cdot HV \cdot FC_{CS,nb} \cdot d_{CS}</data>
      <data key="d69">E_HV_FC_fuel,CS_CS,nbE_fuel,CS</data>
      <data key="d70">["E", "HV", "FC_fuel,CS_CS,nb", "E_fuel,CS", "FC_CS,nb", "d_CS", "E_HV_FC_fuel,CS_CS,nbE_fuel,CS"]</data>
      <data key="d71" />
