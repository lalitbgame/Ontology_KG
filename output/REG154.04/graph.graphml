    </node>
    <node id="REG154.04.ANNEX-B8.APP2.3.2.2.3.4">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B8.APP2.3.2.2.3</data>
      <data key="d20">3.2.2.3.4</data>
