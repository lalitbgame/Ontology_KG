      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">𝑀𝐶𝑂2,𝑗 = 𝑀𝐶𝑂2 ,𝑅𝐶𝐵,𝑗 x 𝑑𝑚,𝑗 𝑡𝑗 𝑀𝐶𝑂2,𝑗 𝑀𝐶𝑂2,𝑅𝐶𝐵,𝑗</data>
      <data key="d74">equations/REG154.04.ANNEX-B6b.3.5.EQ-1.png</data>
