      <data key="d56">∝_{j}=3.6 1 \cdot k\frac{k \cdot ^{i=1}\sum ^{i}_{k}^{ji}-t_{2}-[^{i=1}\sum _{k}^{i}^{i=1}t]_{2}^{ji}}{i=1 i i=1 i}\sum ^{k}t v\sum ^{k}t\sum ^{k}v</data>
      <data key="d69" />
      <data key="d70">["k", "i", "ji", "t_2-", "t", "v", "sum_^kt_vsum_^ktsum_^kv"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">k ∑ tivji −∑ ti ∑ vji 1 k k k ∝j= 3.6 × i=1 i=1 i=1 2 −[∑ k × ∑ ti ] ti 2 k k i=1 i=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.4.3.1.EQ-4.png</data>
    </node>
