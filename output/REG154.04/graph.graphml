      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">Pavailable_k = Pwot (nk) × (1 −(SM + ASM))</data>
      <data key="d74">equations/REG154.04.ANNEX-B2.3.4.EQ-1.png</data>
    </node>
