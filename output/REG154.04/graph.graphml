      <data key="d44">REG154.04.ANNEX-B6b.3.14</data>
      <data key="d22">418</data>
      <data key="d60">[170.4, 561.1, 358.4, 656.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following the equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M M M_{CO2,j,2b}_{CO2,j,2b}_{CO2,j,k}= (ΔCO_{2,j}+M_{CO2,j,k}x(d m,j t)/(j)) x t_j/d_{i,j}</data>
      <data key="d56">M M M_{CO2,j,2b}_{CO2,j,2b}_{CO2,j,k}= (\Delta CO_{2,j}+M_{CO2,j,k}x\frac{d m,j t}{j}) x t_{j}/d_{i,j}</data>
      <data key="d69" />
      <data key="d70">["M", "M_CO2,j,2b_CO2,j,2b", "CO2", "j", "k", "Delta_CO_2,j", "M_CO2,j,k", "x", "m", "t", "t_j", "d_i,j"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">𝑀𝐶𝑂2,𝑗,2𝑏 = (∆CO2,j +𝑀𝐶𝑂2,𝑗,𝑘 x 𝑡𝑗) x 𝑡𝑗/𝑑𝑖,𝑗 𝑑𝑚,𝑗 𝑀𝐶𝑂2,𝑗,2𝑏 𝑀𝐶𝑂2,𝑗,𝑘</data>
