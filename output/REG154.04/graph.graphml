    </node>
    <node id="REG154.04.ANNEX-B8.4.1">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B8.4</data>
      <data key="d20">4.1</data>
      <data key="d27">4.1</data>
      <data key="d21">2</data>
      <data key="d22">463</data>
      <data key="d23">463</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Calculations of gaseous emission compounds, particulate matter emission and particle number emission</data>
      <data key="d25" />
