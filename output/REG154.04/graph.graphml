      <data key="d73">|∆EREESS,CS| c = Efuel,CS ∆EREESS ,CS Efuel,CS</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.APP2.1.2.EQ-1.png</data>
    </node>
