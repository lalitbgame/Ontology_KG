    <node id="REG154.04.ANNEX-A1.12.10.3.1">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-A1.12.10.3</data>
      <data key="d20">12.10.3.1</data>
