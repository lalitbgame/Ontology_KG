      <data key="d73">𝐹𝑖 = 𝑓0 + 𝑓1 x + 𝑓2 x (𝑉𝑖+ 𝑉𝑖−1) ( 𝑉𝑖+ 𝑉𝑖−1)2 2 4 𝑃𝑖 = 𝐹𝑖 x (𝑉𝑖+ 𝑉𝑖−1) 3,6 x 2 x 0,001 𝐹𝑚𝑖 = 𝑓0 + 𝑓1 x + 𝑓2 x (𝑉𝑚𝑖+ 𝑉𝑚𝑖−1) ( 𝑉𝑚𝑖+ 𝑉𝑚𝑖−1)2 2 4 𝑃𝑚𝑖 = 𝐹𝑚𝑖 x (𝑉𝑚𝑖+ 𝑉𝑚𝑖−1) 3,6 x 2 𝑎𝑖 = (𝑉𝑖− 𝑉𝑖−1) 3,6 x (𝑡𝑖− 𝑡𝑖−1) 𝑎𝑚𝑖 = (𝑉𝑚𝑖− 𝑉𝑚𝑖−1) 3,6 x (𝑡𝑖− 𝑡𝑖−1) 𝐹𝑖 𝐹𝑚𝑖 𝑃𝑖 𝑃𝑚𝑖 𝑓0, 𝑓1, 𝑓2 𝑉𝑖</data>
      <data key="d74">equations/REG154.04.ANNEX-B6b.3.1.EQ-1.png</data>
    </node>
