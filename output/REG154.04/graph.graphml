      <data key="d68">C q C(i)Δt V n_e_VCVS(i)C_e=sum ^{n}^{i=1}q^{VCVS}(i)V* Δt * C(i)</data>
      <data key="d56">C q C(i)\Delta t V n_{e}_{VCVS}(i)C_{e}=\sum ^{n}^{i=1}q^{VCVS}(i)V \cdot \Delta t \cdot C(i)</data>
      <data key="d69">C_q_C(i)Delta_t_V_n_e_VCVS(i)C_e</data>
