      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">1 1 ΔEREESS,avg,i,CC = 3600× tend,CC −tstart,CC tend,𝐶𝐶 t × ∫ (∫ UREESS,𝑖(τ) × IREESS,𝑖(τ)𝑑𝜏 )dt tstart,CC tstart,𝐶𝐶</data>
      <data key="d74">equations/REG154.04.ANNEX-C1.APP3.3.1.1.EQ-7.png</data>
