    <node id="REG154.04.ANNEX-B7.3.1.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p426-r5</data>
      <data key="d44">REG154.04.ANNEX-B7.3.1.3</data>
      <data key="d22">426</data>
      <data key="d60">[243.3, 360.7, 409.7, 418.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">reference fuel with a mean composition of C_XH_YO_Z is as follows:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "ρ_THC", "symbol_text": "ρTHC", "description": "the density of total hydrocarbons and non-methane hydrocarbons, g/l", "unit": null}, {"symbol": "MW_C", "symbol_text": "MW_C", "description": "the molar mass of carbon (12.011 g/mol)", "unit": null}, {"symbol": "MWH", "symbol_text": "MWH", "description": "the molar mass of hydrogen (1.008 g/mol)", "unit": null}, {"symbol": "MWO", "symbol_text": "MWO", "description": "the molar mass of oxygen (15.999 g/mol)", "unit": null}, {"symbol": "VM", "symbol_text": "VM", "description": "the molar volume of an ideal gas at 273.15 K (0° C) and 101.325 kPa (22.413 l/mol)", "unit": null}, {"symbol": "H/C", "symbol_text": "H/C", "description": "the hydrogen to carbon ratio for a specific fuel CXHYOZ", "unit": null}, {"symbol": "O/C", "symbol_text": "O/C", "description": "the oxygen to carbon ratio for a specific fuel CXHYOZ.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">ρ_THC=MW(^{c}C V^{H}C^{O})/(M)+H* MW+ O* MW</data>
      <data key="d56">\rho _{THC}=MW\frac{^{c}C V^{H}C^{O}}{M}+H \cdot MW+ O \cdot MW</data>
      <data key="d69">ρ_THC</data>
      <data key="d70">["ρ_THC", "MW", "c", "C", "V", "H", "O", "M"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">MWc + H C × MWH + O C × MWO ρTHC = VM</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.1.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p426-r6</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1</data>
      <data key="d22">426</data>
      <data key="d60">[214.0, 613.7, 438.7, 663.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">using the following equations:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "M_i", "symbol_text": "M_i", "description": "the mass emission of compound i per test or phase, g/km", "unit": "g/km"}, {"symbol": "V_mix", "symbol_text": "V_mix", "description": "the volume of the diluted exhaust gas per test or phase expressed in litres per test/phase and corrected to standard conditions (273.15 K (0 °C) and 101.325 kPa)", "unit": null}, {"symbol": "ρ_i", "symbol_text": "ρ_i", "description": "the density of compound i in grams per litre at standard temperature and pressure (273.15 K (0 °C) and 101.325 kPa)", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{i,phase}=V(^{mix,phase}^{i}d^{phase}^{i,phase}^{-6})/(phase)* ρ* KH* C* 10</data>
      <data key="d56">M_{i,phase}=V\frac{^{mix,phase}^{i}d^{phase}^{i,phase}^{-6}}{phase} \cdot \rho \cdot KH \cdot C \cdot 10</data>
      <data key="d69">M_i,phase</data>
      <data key="d70">["M_i,phase", "V", "i", "ρ", "KH", "C", "^mix,phase^id^phase^i,phase^"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Vmix,phase × ρi × KHphase × Ci,phase × 10−6 Mi,phase = dphase</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p427-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1</data>
      <data key="d22">427</data>
      <data key="d60">[274.1, 190.3, 380.9, 237.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "C_i", "symbol_text": "C_i", "description": "the concentration of gaseous compound i in the diluted exhaust gas corrected by the amount of gaseous compound i contained in the dilution air, ppm", "unit": null}, {"symbol": "C_e", "symbol_text": "C_e", "description": "the measured concentration of gaseous compound i in the diluted exhaust gas, ppm", "unit": null}, {"symbol": "C_d", "symbol_text": "C_d", "description": "the concentration of gaseous compound i in the dilution air, ppm", "unit": null}, {"symbol": "DF", "symbol_text": "DF", "description": "the dilution factor.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">C_i=C_e-C_d* (1 -DF 1)</data>
      <data key="d56">C_{i}=C_{e}-C_{d} \cdot (1 -DF 1)</data>
      <data key="d69">C_i</data>
      <data key="d70">["C_i", "C_e-C_d", "DF"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">1 Ci = Ce −Cd × (1 − DF)</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p427-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.1</data>
      <data key="d22">427</data>
      <data key="d60">[170.4, 373.5, 375.7, 583.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">fuel (as applicable):</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">DF DF DF DF DF DF DF DF========(C+(C 13 .4+C)*10-4)/(CO2 HC CO)(C+(C 13 .5+C)*10-4)/((C+(C 13 .5+C)*10-4)/(CO2 HC CO)^{CO2}^{HC}^{CO})(C+(C 13 .5+C)*10-4)/(CO2 HC CO)(C+(C 11 .9+C)*10-4)/((C+(C 9.5+C)*10-4)/(CO2 HC CO)^{CO2}^{HC}^{CO})(C+(C 12 .5+C)*10-4)/(CO2 HC 35.03 CO)(C-C+C*10-4)/(H2O H2O-DA H2)for diesel (B5H)</data>
      <data key="d56">DF DF DF DF DF DF DF DF========\frac{C+(C 13 .4+C) \cdot 10-4}{CO2 HC CO}\frac{C+(C 13 .5+C) \cdot 10-4}{\frac{C+(C 13 .5+C) \cdot 10-4}{CO2 HC CO}^{CO2}^{HC}^{CO}}\frac{C+(C 13 .5+C) \cdot 10-4}{CO2 HC CO}\frac{C+(C 11 .9+C) \cdot 10-4}{\frac{C+(C 9.5+C) \cdot 10-4}{CO2 HC CO}^{CO2}^{HC}^{CO}}\frac{C+(C 12 .5+C) \cdot 10-4}{CO2 HC 35.03 CO}\frac{C-C+C \cdot 10-4}{H2O H2O-DA H2}for diesel (B5H)</data>
      <data key="d69" />
      <data key="d70">["DF", "C", "CO2", "HC", "CO", "H2O", "DA", "H2", "B5H", "for_diesel"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">DF = 13 .4 CCO2+(CHC+CCO)×10−4 DF = CCO2+(CHC+CCO)×10−4 for diesel (B5H) 13 .5 DF = 13 .5 CCO2+(CHC+CCO)×10−4 DF = 13 .5 CCO2+(CHC+CCO)×10−4 DF = 11 .9 CCO2+(CHC+CCO)×10−4 DF = 9.5 CCO2+(CHC+CCO)×10−4 DF = 12 .5 CCO2+(CHC+CCO)×10−4 DF = 35.03 CH2O−CH2O−DA+CH2×10−4</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.1.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p428-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.1</data>
      <data key="d22">428</data>
      <data key="d60">[253.1, 49.2, 400.1, 101.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "C_i̅", "symbol_text": "C_i̅", "description": "mean concentration of a gaseous compound", "unit": null}, {"symbol": "Ci,phase", "symbol_text": "Ci,phase", "description": "the concentration of each phase", "unit": null}, {"symbol": "Vmix,phase", "symbol_text": "Vmix,phase", "description": "the Vmix of the corresponding phase", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the number of phases.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">C_i̅=sum (phase=1sum n i,phase V mix,phase)/(phase=1 mix,phase)^{n}(C* V)</data>
      <data key="d56">C_{i}̅=\sum \frac{phase=1\sum n i,phase V mix,phase}{phase=1 mix,phase}^{n}(C \cdot V)</data>
      <data key="d69" />
      <data key="d70">["C_i", "n", "i", "V", "C", "1sum_n_i,phase_V_mix,phase", "1_mix,phase"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∑ (Ci,phase × Vmix,phase) n Ci̅ = phase=1 ∑ Vmix,phase n phase=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.1.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p428-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.2</data>
      <data key="d22">428</data>
      <data key="d60">[250.8, 206.1, 402.0, 308.4]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">fuel with an arithmetic average composition of CxH_yO_z is as follows:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">X DF= 100=(C+(C+ C)* 10^{-4})/(CO2 HC CO)*(x +y+ 3.76 (x + y-z))/(2 4 2)X x</data>
      <data key="d56">X DF= 100=\frac{C+(C+ C) \cdot 10^{-4}}{CO2 HC CO} \cdot \frac{x +y+ 3.76 (x + y-z)}{2 4 2}X x</data>
      <data key="d69" />
      <data key="d70">["X", "DF", "C", "CO2", "HC", "CO", "x", "y", "z"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">X DF = CCO2 + (CHC + CCO) × 10−4 x X = 100 × x + y 2 + 3.76 (x + y 4 −z 2)</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p428-r3</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.3.1</data>
      <data key="d22">428</data>
      <data key="d60">[170.4, 428.3, 397.4, 614.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">C C C Rf_NMHC_THC_CH4_CH4 C_NMHC= C_THC-(Rf_CH4* C_CH4)</data>
      <data key="d56">C C C Rf_{NMHC}_{THC}_{CH4}_{CH4}C_{NMHC}= C_{THC}-(Rf_{CH4} \cdot C_{CH4})</data>
      <data key="d69">C_C_C_Rf_NMHC_THC_CH4_CH4_C_NMHC</data>
      <data key="d70">["C", "Rf_NMHC_THC", "C_NMHC", "C_THC-", "Rf_CH4", "C_CH4", "C_C_C_Rf_NMHC_THC_CH4_CH4_C_NMHC"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">CNMHC = CTHC −(RfCH4 × CCH4) CNMHC CTHC CCH4 RfCH4</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.3.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p429-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.3.2</data>
      <data key="d22">429</data>
      <data key="d60">[226.0, 107.7, 426.3, 191.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">C C_NMHC_CH4==C(^{HC(w/NMC)}Rf*^{HC(w/oNMC)}(E-E)^{E})/(C_{HC(w/oNMC)}^{CH4}*(1 -E^{E}_M)-C^{M}_{HC(w/NMC)})(E-E)/(E M)-C*(1 -E)</data>
      <data key="d56">C C_{NMHC}_{CH4}==C\frac{^{HC(w/NMC)}Rf \cdot ^{HC(w/oNMC)}(E-E)^{E}}{C_{HC(w/oNMC)}^{CH4} \cdot (1 -E^{E}_{M})-C^{M}_{HC(w/NMC)}}\frac{E-E}{E M}-C \cdot (1 -E)</data>
      <data key="d69">C_C_NMHC_CH4</data>
      <data key="d70">["C", "C_NMHC_CH4", "HC", "w", "NMC", "Rf", "oNMC", "E", "C_HC(w/oNMC)", "CH4", "M"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">CHC(w/NMC) −CHC(w/oNMC) × (1 −EE) CCH4 = RfCH4 × (EE −EM) CHC(w/oNMC) × (1 −EM) −CHC(w/NMC) CNMHC = EE −EM</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.3.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.3.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p429-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.3.2</data>
      <data key="d22">429</data>
      <data key="d60">[184.0, 218.8, 469.6, 302.4]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equations:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "C_HC_(w/NMC)", "symbol_text": "C_HC (w/NMC)", "description": "the HC concentration with sample gas flowing through the", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">C C_NMHC_CH4==C(^{HC (w/NMC)}^{CH4}Rf*(^{M}E-E^{HC (w/oNMC)})^{E})/(C_{HC(w/oNMC)}*(1 -E^{CH4}_M)-C_{HC (w/NMC)}^{E}^{M}* Rf_CH4*(1 -E_M))(E-E)/(E M)* Rf*(1 -E)-C*(1 -E)</data>
      <data key="d56">C C_{NMHC}_{CH4}==C\frac{^{HC (w/NMC)}^{CH4}Rf \cdot (^{M}E-E^{HC (w/oNMC)})^{E}}{C_{HC(w/oNMC)} \cdot (1 -E^{CH4}_{M})-C_{HC (w/NMC)}^{E}^{M} \cdot Rf_{CH4} \cdot (1 -E_{M})}\frac{E-E}{E M} \cdot Rf \cdot (1 -E)-C \cdot (1 -E)</data>
      <data key="d69">C_C_NMHC_CH4</data>
      <data key="d70">["C", "C_NMHC_CH4", "HC", "w", "NMC", "CH4", "Rf", "M", "E", "oNMC", "C_HC(w/oNMC)", "C_HC_(w/NMC)", "Rf_CH4", "E_M"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">CHC (w/NMC) × RfCH4 × (1 −EM) −CHC (w/oNMC) × (1 −EE) CCH4 = RfCH4 × (EE −EM) CHC(w/oNMC) × (1 −EM) −CHC (w/NMC) × RfCH4 × (1 −EM) CNMHC = EE −EM</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.1.3.2.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.1.3.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p429-r3</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.1.3.3.1</data>
      <data key="d22">429</data>
      <data key="d60">[279.4, 639.2, 376.4, 689.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">shall be determined using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "C_HC_(w/NMC)", "symbol_text": "C_HC (w/NMC)", "description": "the HC concentration with CH4 flowing through the NMC, ppm C", "unit": null}, {"symbol": "C_HC_(w/oNMC)", "symbol_text": "C_HC (w/oNMC)", "description": "the HC concentration with CH4 bypassing the NMC, ppm C.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">E_M= 1 -(C^{HC (w/NMC)})/(HC(w/oNMC))C</data>
