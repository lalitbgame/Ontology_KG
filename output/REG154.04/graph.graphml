      <data key="d24">[TABLE:REG154.04.ANNEX-C1.APP3.2.1.2.TABLE-U1] [EQ:REG154.04.ANNEX-C1.APP3.2.1.2.EQ-1] [TABLE:REG154.04.ANNEX-C1.APP3.2.1.2.TABLE-U2]</data>
