      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">tests, is defined using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">K EC K_{fuel,FCHV}_{DC ,CS,n}_{fuel,FCHV}=sum (n=1 DC ,CS,nsum n CS(EC DC ,CS,avg- EC CS,nb,n)2 CS,nb,avg)/(n=1 DC ,CS,n DC,CS,avg)^{n}^{CS}((EC- EC) * (FC- FC))</data>
      <data key="d56">K EC K_{fuel,FCHV}_{DC ,CS,n}_{fuel,FCHV}=\sum \frac{n=1 DC ,CS,n\sum n CS(EC DC ,CS,avg- EC CS,nb,n)2 CS,nb,avg}{n=1 DC ,CS,n DC,CS,avg}^{n}^{CS}((EC- EC) \cdot (FC- FC))</data>
      <data key="d69">K_EC_K_fuel,FCHV_DC_,CS,n_fuel,FCHV</data>
      <data key="d70">["K", "EC", "K_fuel,FCHV_DC_,CS,n", "FCHV", "n", "DC", "CS", "nb", "FC", "K_EC_K_fuel,FCHV_DC_,CS,n_fuel,FCHV"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∑ ((ECDC ,CS,n − ECDC ,CS,avg) × (FCCS,nb,n − FCCS,nb,avg)) nCS Kfuel,FCHV = n=1 ∑ (ECDC ,CS,n − ECDC,CS,avg)2 nCS n=1 Kfuel,FCHV ECDC ,CS,n</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.APP2.2.3.1.EQ-1.png</data>
    </node>
