      <data key="d91">cites</data>
      <data key="d92">SAE J1978</data>
      <data key="d93">(b) ISO 15031-4 "Road vehicles – Communication between vehicle and external test equipment for emissions related diagnostics – Part 4: External test equipment", dated 1 June 2005 or SAE J1978 dated 30 April 2002;</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-C5.APP1.6.5.3.2" target="REG154.04/EXT:ISO.15031-3" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">ISO 15031-3</data>
      <data key="d93">(c) ISO 15031-3 "Road vehicles – Communication between vehicle and external test equipment for emissions related diagnostics Part 3: Diagnostic connector and related electrical circuits: specification and use", dated 1 July 2004 or SAE J 1962 dated 26 July 2012;</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-C5.APP1.6.5.3.2" target="REG154.04/EXT:ISO.15031-6" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">ISO 15031-6</data>
      <data key="d93">(d) ISO 15031-6 "Road vehicles – Communication between vehicle and external test equipment for emissions related diagnostics – Part 6: Diagnostic trouble code definitions", dated 13 August 2010 or SAE J2012 dated 07 March 2013;</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-C5.APP1.6.5.3.2" target="REG154.04/EXT:SAE.J2012" id="0">
