      <data key="d93">Standards used for the transmission of OBD relevant information: (a) ISO 15031-5 "Road vehicles - communication between vehicles and external test equipment for emissions-related diagnostics – Part 5: Emissions-related diagnostic services", dated 1 April 2011 or SAE J1979 dated 23 February 2012;</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-C5.APP1.6.5.3.2" target="REG154.04/EXT:ISO.15031-4" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">ISO 15031-4</data>
      <data key="d93">(b) ISO 15031-4 "Road vehicles – Communication between vehicle and external test equipment for emissions related diagnostics – Part 4: External test equipment", dated 1 June 2005 or SAE J1978 dated 30 April 2002;</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.ANNEX-C5.APP1.6.5.3.2" target="REG154.04/EXT:SAE.J1978" id="0">
