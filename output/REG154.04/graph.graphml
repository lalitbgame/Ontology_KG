      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">requirement, for all i and j:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Delta_F_i(v_j)", "symbol_text": "∆F_i(v_j)", "description": "the difference between the calculated road load with all coastdown runs and the calculated road load with the i^th pair of coastdown runs excluded, N", "unit": "N"}, {"symbol": "F(v_j)", "symbol_text": "F(v_j)", "description": "the calculated road load with all coastdown runs included, N", "unit": "N"}, {"symbol": "v_j", "symbol_text": "v_j", "description": "the reference speed, km/h", "unit": "km/h"}, {"symbol": "n", "symbol_text": "n", "description": "the number of pairs of coastdown runs, all valid pairs are included.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">inequality</data>
      <data key="d68">ΔF_i(v_j)/F(v_j) &lt;=^{0.030}_{√n-1}</data>
      <data key="d56">\Delta F_{i}(v_{j})/F(v_{j}) \le ^{0.030}_{√n-1}</data>
      <data key="d69" />
      <data key="d70">["Delta_F_i", "v_j", "F", "n"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∆Fi(vj)/F(vj) ≤ √n−1 0.030</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.2.6.10.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.4.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
