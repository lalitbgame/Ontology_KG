      <data key="d27">4.1.5.2.4</data>
      <data key="d21">5</data>
      <data key="d22">348</data>
      <data key="d23">348</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Quick-acting valves to divert a constant flow of gas samples into the sample bags or to the outside vent.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.5.2.5">
      <data key="d0">Clause</data>
      <data key="d1">REG154.04</data>
      <data key="d17">Clause</data>
      <data key="d18">decimal</data>
      <data key="d19">REG154.04.ANNEX-B5.4.1.5.2</data>
      <data key="d20">4.1.5.2.5</data>
      <data key="d27">4.1.5.2.5</data>
      <data key="d21">5</data>
      <data key="d22">348</data>
      <data key="d23">348</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Gas-tight, quick-lock coupling elements between the quick-acting valves and the sample bags. The coupling shall close automatically on the sampling bag side. As an alternative, other methods of transporting the samples to the analyser may be used (three-way stopcocks, for instance).</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
