      <data key="d68">M_{CO2,CS,c,2}M_{i,CS,c,2}==sum (p i,CS,p,1sum d* d_p)/(sum M^{p}^{p}* d)(^{p}^{CO2,CS,p,1}sum d^{p})/(p p)M</data>
