    <edge source="REG154.04.BODY.5.5" target="REG154.04/EXT:UNECE.AGREEMENT-1958" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">1958 Agreement</data>
      <data key="d93">If the vehicle conforms to a vehicle type approved, under one or more other Regulations annexed to the 1958 Agreement, in the country which has granted approval under this Regulation, the symbol prescribed in paragraph 5.4.1. need not be repeated; in such a case, the Regulation, approval numbers and the additional symbols of all the Regulations under which approval has been granted in the country </data>
      <data key="d94">direct</data>
    </edge>
