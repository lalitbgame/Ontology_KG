      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">n/v ratios shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "n", "symbol_text": "n", "description": "engine speed, min^-1", "unit": null}, {"symbol": "v", "symbol_text": "v", "description": "the vehicle speed, km/h", "unit": "km/h"}, {"symbol": "r_i", "symbol_text": "r_i", "description": "the transmission ratio in gear i", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">(^{n}_v)_i=(r_i* r_axle* 60000)/(U_dyn* 3.6)</data>
      <data key="d56">(^{n}_{v})_{i}=(r_{i} \cdot r_{axle} \cdot 60000)/(U_{dyn} \cdot 3.6)</data>
      <data key="d69" />
      <data key="d70">["n", "r_i", "r_axle", "U_dyn"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">(n v) i = (ri × raxle × 60000)/(Udyn × 3.6)</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.8.EQ-1.png</data>
    </node>
