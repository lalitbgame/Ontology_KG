    <node id="REG154.04.BODY.3.10.11.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p18-r1</data>
      <data key="d44">REG154.04.BODY.3.10.11</data>
      <data key="d22">18</data>
      <data key="d60">[172.7, 80.8, 481.3, 123.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">capacity that is being used (with wide open throttle as 100 per cent);</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">CLV =Peak airflow (at sea level)Current airflow* Atmosp h Barometric pressure eric pressure (at sea level)</data>
      <data key="d56">CLV =Peak airflow (at sea level)Current airflow \cdot Atmosp h Barometric pressure eric pressure (at sea level)</data>
      <data key="d69">CLV</data>
      <data key="d70">["CLV", "Peak", "at", "Current", "Atmosp", "h", "Barometric", "Peak_airflow", "at_sea_level", "Current_airflow", "Atmosp_h_Barometric_pressure_eric_pressure"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">𝑃𝑒𝑎𝑘 𝑎𝑖𝑟𝑓𝑙𝑜𝑤 (𝑎𝑡 𝑠𝑒𝑎 𝑙𝑒𝑣𝑒𝑙) × 𝐴𝑡𝑚𝑜𝑠𝑝ℎ𝑒𝑟𝑖𝑐 𝑝𝑟𝑒𝑠𝑠𝑢𝑟𝑒 (𝑎𝑡 𝑠𝑒𝑎 𝑙𝑒𝑣𝑒𝑙) 𝐶𝑢𝑟𝑟𝑒𝑛𝑡 𝑎𝑖𝑟𝑓𝑙𝑜𝑤 𝐶𝐿𝑉  = 𝐵𝑎𝑟𝑜𝑚𝑒𝑡𝑟𝑖𝑐 𝑝𝑟𝑒𝑠𝑠𝑢𝑟𝑒</data>
      <data key="d74">equations/REG154.04.BODY.3.10.11.EQ-1.png</data>
    </node>
    <node id="REG154.04.APPENDIX-2.2.1.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p66-r1</data>
      <data key="d44">REG154.04.APPENDIX-2.2.1.1</data>
      <data key="d22">66</data>
      <data key="d60">[170.4, 387.7, 414.7, 483.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">determined:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">X VAR=_tests=(x(x_1-X^{1}+ x_tests^{2}+ x)N_2^{3}+ (x+. . . +x_2-X^{N}N-1)_tests)_2+. . . +(x_N-X_tests)_2</data>
      <data key="d56">X VAR=_{tests}=(x(x_{1}-X^{1}+ x_{tests}^{2}+ x)N_{2}^{3}+ (x+. . . +x_{2}-X^{N}N-1)_{tests})_{2}+. . . +(x_{N}-X_{tests})_{2}</data>
      <data key="d69">X_VAR</data>
      <data key="d70">["X", "VAR", "x", "x_1-X", "x_tests", "N_2", "x_2-X", "N", "x_N-X_tests"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">(x1 + x2 + x3+. . . +xN) 𝑋𝑡𝑒𝑠𝑡𝑠= N (𝑥1 −𝑋𝑡𝑒𝑠𝑡𝑠)2 + (𝑥2 −𝑋𝑡𝑒𝑠𝑡𝑠)2+. . . +(𝑥𝑁−𝑋𝑡𝑒𝑠𝑡𝑠)2 𝑉𝐴𝑅= 𝑁−1</data>
      <data key="d74">equations/REG154.04.APPENDIX-2.2.1.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.APPENDIX-2.2.1.1.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p66-r2</data>
      <data key="d44">REG154.04.APPENDIX-2.2.1.1</data>
      <data key="d22">66</data>
      <data key="d60">[255.3, 552.9, 321.9, 587.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">True</data>
      <data key="d62">(i) Pass the family if X_tests&lt; A∙L −</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">decision_rule</data>
      <data key="d68">X_tests&lt; A*L -</data>
      <data key="d56">X_{tests}&lt; A \cdot L -</data>
      <data key="d69" />
      <data key="d70">["X_tests", "A", "L"]</data>
      <data key="d71">pass</data>
