      <data key="d60">[226.8, 213.6, 403.4, 262.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">the following equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">PM=({V^{e})/(ep)P-[(V^{a})/(ap)P* (1 -DF 1)]} *d</data>
      <data key="d56">PM=\frac{{V^{e}}{ep}P-[\frac{V^{a}}{ap}P \cdot (1 -DF 1)]} \cdot d</data>
      <data key="d69">PM</data>
      <data key="d70">["PM", "V", "e", "ep", "P"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">PM = { Pe −[ Pa 1 × (1 − DF)]} × Vep Vap d</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.3.1.1.EQ-1.png</data>
    </node>
