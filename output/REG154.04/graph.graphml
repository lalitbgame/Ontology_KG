      <data key="d70">["w", "f", "c", "v_2", "v"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">w1 = 3.62 × f2 × vw 2 or: w2 = 3.62 × c2 × vw 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.5.3.1.1.EQ-1.png</data>
    </node>
