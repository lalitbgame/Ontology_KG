      <data key="d56">Fail the family if X X_{tests}_{tests}B+ (t B-(t&gt; A+ (t \le A-(t_{F1,i}_{P1,i}-t+ t_{F1,i}_{P1,i}_{F2}_{P2,i}) \cdot s &gt;-t+ t) \cdot s \le X_{F2}_{P2,i}) \cdot s) \cdot s X_{tests}_{tests}</data>
      <data key="d69" />
      <data key="d70">["Fail", "X", "X_tests_tests", "B", "t", "A", "t_F1,i_P1,i", "P2", "i", "s", "X_F2_P2,i", "Fail_the_family_if_X_X_tests_tests_B", "s_X_tests_tests"]</data>
      <data key="d71">pass</data>
      <data key="d72">partial</data>
      <data key="d73">Pass the family if 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴−(𝑡𝑃1,𝑖+ 𝑡𝑃2,𝑖) ∙𝑠 and       𝐵+ (𝑡𝑃1,𝑖+ 𝑡𝑃2,𝑖) ∙𝑠≤ 𝑋𝑡𝑒𝑠𝑡𝑠 Fail the family if 𝑋𝑡𝑒𝑠𝑡𝑠&gt; 𝐴+ (𝑡𝐹1,𝑖−𝑡𝐹2) ∙𝑠 or       𝐵−(𝑡𝐹1,𝑖−𝑡𝐹2) ∙𝑠 &gt; 𝑋𝑡𝑒𝑠𝑡𝑠</data>
      <data key="d74">equations/REG154.04.APPENDIX-2.3.4.EQ-1.png</data>
    </node>
    <node id="REG154.04.APPENDIX-2.3.4.EQ-2">
      <data key="d0">Equation</data>
