      <data key="d21">5</data>
      <data key="d22">557</data>
      <data key="d23">557</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">When conducting a number of consecutive sequences, paragraph 3.2.2.1. shall be omitted.</data>
      <data key="d25" />
