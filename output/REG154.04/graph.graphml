      <data key="d68">UBE AF_{OVC-HEV}_{measured@TA}UBE_certified=UBE_{measured@TA}*AF_{OVC-HEV}</data>
      <data key="d56">UBE AF_{OVC-HEV}_{measured@TA}UBE_{certified}=UBE_{measured@TA} \cdot AF_{OVC-HEV}</data>
