      <data key="d60">[239.6, 47.7, 412.5, 96.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">dilution setting shall be calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_r̅=f^{r}(30nm)+ f^{r}(50nm 3)+ f^{r}(100nm)</data>
      <data key="d56">f_{r}̅=f^{r}(30nm)+ f^{r}(50nm 3)+ f^{r}(100nm)</data>
      <data key="d69" />
      <data key="d70">["f_r", "f", "r"]</data>
