      <data key="d22">504</data>
      <data key="d23">504</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">This paragraph is applicable to Level 1A and Level 2 only: Individual utility factor-weighted charge-depleting CO2 emission for OVC- HEVs The utility factor-weighted charge-depleting CO2 emission for an individual vehicle shall be calculated using the following equation: [EQ:REG154.04.ANNEX-B8.4.5.4.2.EQ-1]</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B8</data>
    </node>
    <node id="REG154.04.ANNEX-B8.4.5.4.3">
