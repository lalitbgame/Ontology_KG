      <data key="d44">REG154.04.APPENDIX-2.3.4</data>
      <data key="d22">75</data>
      <data key="d60">[169.7, 247.4, 474.8, 295.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Take another measurement if:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">decision_rule</data>
      <data key="d68">or B-(t A-(t_{F1,i}_{P1,i}-t+ t_F2_{P2,i}) *s&lt;=X) *s&lt; X_tests_tests&lt;&lt;=A+ (t B+ (t_{P1,i}_{F1,i}+ t-t_{P2,i}_F2) *s) *s</data>
      <data key="d56">or B-(t A-(t_{F1,i}_{P1,i}-t+ t_{F2}_{P2,i}) \cdot s \le X) \cdot s&lt; X_{tests}_{tests}&lt; \le A+ (t B+ (t_{P1,i}_{F1,i}+ t-t_{P2,i}_{F2}) \cdot s) \cdot s</data>
      <data key="d69" />
      <data key="d70">["B", "t", "A", "t_F1,i_P1,i", "t_F2_P2,i", "s", "X", "X_tests_tests", "t_P1,i_F1,i", "t_P2,i_F2", "s&lt;_X_tests_tests&lt;&lt;"]</data>
      <data key="d71">continue</data>
      <data key="d72">partial</data>
      <data key="d73">𝐴−(𝑡𝑃1,𝑖+ 𝑡𝑃2,𝑖) ∙𝑠&lt; 𝑋𝑡𝑒𝑠𝑡𝑠≤𝐴+ (𝑡𝐹1,𝑖−𝑡𝐹2) ∙𝑠 or    𝐵−(𝑡𝐹1,𝑖−𝑡𝐹2) ∙𝑠≤𝑋𝑡𝑒𝑠𝑡𝑠&lt; 𝐵+ (𝑡𝑃1,𝑖+ 𝑡𝑃2,𝑖) ∙𝑠</data>
      <data key="d74">equations/REG154.04.APPENDIX-2.3.4.EQ-2.png</data>
    </node>
    <node id="REG154.04.APPENDIX-3.1.9.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p77-r1</data>
      <data key="d44">REG154.04.APPENDIX-3.1.9</data>
      <data key="d22">77</data>
      <data key="d60">[170.4, 619.7, 317.8, 655.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">before and after the run-in:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "M_CO2,i", "symbol_text": "MCO2,i", "description": "the measured CO2 emission for test i, g/km", "unit": "g/km"}, {"symbol": "C_RI", "symbol_text": "CRI", "description": "the slope of the logarithmic regression line", "unit": null}, {"symbol": "C_const", "symbol_text": "Cconst", "description": "the constant value of the logarithmic regression line", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{CO2,i}=C_RI*ln(D_i-D_s)+ C_const</data>
      <data key="d56">M_{CO2,i}=C_{RI} \cdot ln(D_{i}-D_{s})+ C_{const}</data>
      <data key="d69">M_CO2,i</data>
      <data key="d70">["M_CO2,i", "C_RI", "D_i-D_s", "C_const"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">𝑀𝐶𝑂2,𝑖= 𝐶𝑅𝐼∙𝑙𝑛(𝐷𝑖−𝐷𝑠) + 𝐶𝑐𝑜𝑛𝑠𝑡</data>
      <data key="d74">equations/REG154.04.APPENDIX-3.1.9.EQ-1.png</data>
    </node>
    <node id="REG154.04.APPENDIX-3.1.9.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p78-r1</data>
      <data key="d44">REG154.04.APPENDIX-3.1.9.1</data>
      <data key="d22">78</data>
      <data key="d60">[250.1, 132.3, 403.5, 239.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">be corrected downward with the standard errors of the slope:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "MCO2,i-fit", "symbol_text": "MCO2,i-fit", "description": "the result of the applying the equation for each of the distances Di.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">σ_fit=SE√(()^{2})/(sum (M^{CO2,i}N-2-M^{CO2,i-fit})C_RI)=√(sum (x^{fit}-x̅)^{2})/(i)σ</data>
      <data key="d56">\sigma _{fit}=SE√(\frac{)^{2}}{\sum (M^{CO2,i}N-2-M^{CO2,i-fit}}C_{RI})=√\frac{\sum (x^{fit}-x̅)^{2}}{i}\sigma</data>
      <data key="d69">σ_fit</data>
      <data key="d70">["σ_fit", "SE", "M", "CO2", "i", "N", "C_RI", "x", "σ"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">𝜎𝑓𝑖𝑡= √∑(𝑀𝐶𝑂2,𝑖−𝑀𝐶𝑂2,𝑖−𝑓𝑖𝑡) 2 𝑁−2 𝜎𝑓𝑖𝑡 𝑆𝐸(𝐶𝑅𝐼) = √∑(𝑥𝑖−𝑥̅)2</data>
      <data key="d74">equations/REG154.04.APPENDIX-3.1.9.1.EQ-1.png</data>
    </node>
