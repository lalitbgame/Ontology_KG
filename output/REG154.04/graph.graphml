      <data key="d62">is calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "H/W", "symbol_text": "H/W", "description": "the tyre’s aspect ratio, e.g. \"45\" for a 225/45 R17 tyre", "unit": null}, {"symbol": "W", "symbol_text": "W", "description": "the tyre width, mm; e.g. \"225\" for a 225/45 R17 tyre", "unit": null}, {"symbol": "R", "symbol_text": "R", "description": "the wheel diameter, inch; e.g. \"17\" for a 225/45 R17 tyre.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">U_dyn=3.05 * (2 (^{H/W}_100) * W + (R* 25.4))</data>
      <data key="d56">U_{dyn}=3.05 \cdot (2 (^{H/W}_{100}) \cdot W + (R \cdot 25.4))</data>
      <data key="d69">U_dyn</data>
      <data key="d70">["U_dyn", "H", "W", "R"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">100 ) × W + (R × 25.4)) Udyn = 3.05 × (2 (H/W</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.8.EQ-2.png</data>
    </node>
