      <data key="d95">annex</data>
      <data key="d92">Annex A2</data>
    </edge>
    <edge source="REG154.04.BODY.9.2" target="REG154.04/EXT:UNECE.AGREEMENT-1958" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">1958 Agreement</data>
      <data key="d93">If a Contracting Party to the 1958 Agreement which applies this Regulation withdraws an approval it has previously granted, it shall forthwith so notify the other Contracting Parties applying this Regulation, by means of a communication form conforming to the model in Annex A2 to this Regulation.</data>
      <data key="d94">direct</data>
    </edge>
    <edge source="REG154.04.BODY.10" target="REG154.04.ANNEX-A2" id="0">
      <data key="d90">REFERENCES</data>
      <data key="d95">annex</data>
      <data key="d92">Annex A2</data>
    </edge>
    <edge source="REG154.04.BODY.10" target="REG154.04/EXT:UNECE.AGREEMENT-1958" id="0">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">1958 Agreement</data>
      <data key="d93">Upon receiving the relevant communication, that authority shall inform thereof the other Contracting Parties to the 1958 Agreement applying this Regulation by means of copies of the communication form conforming to the model in Annex A2 to this Regulation.</data>
      <data key="d94">direct</data>
    </edge>
