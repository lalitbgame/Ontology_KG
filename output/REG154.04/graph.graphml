      <data key="d44">REG154.04.ANNEX-B7.3.2.5.1.1</data>
      <data key="d22">440</data>
      <data key="d60">[170.4, 66.4, 485.2, 175.6]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Ratio determination for each phase of VL and VH</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{CO2,p,L}, M_{CO2,c,L},M_{CO2,p,H}R R and M_{p,H}_{p,L}==M M_{CO2,c,H}^{CO2,p,L}_{CO2,p,H}are from step 9 in Table A7/1 in this⁄⁄M M_{CO2,c,L}_{CO2,c,H}</data>
      <data key="d56">M_{CO2,p,L}, M_{CO2,c,L},M_{CO2,p,H}R R and M_{p,H}_{p,L}==M M_{CO2,c,H}^{CO2,p,L}_{CO2,p,H}are from step 9 in Table A7/1 in this⁄⁄M M_{CO2,c,L}_{CO2,c,H}</data>
      <data key="d69">M_CO2,p,L,_M_CO2,c,L,M_CO2,p,HR_R_and_M_p,H_p,L</data>
      <data key="d70">["M_CO2,p,L", "M_CO2,c,L", "M_CO2,p,H", "R", "M_p,H_p,L", "M", "M_CO2,c,H", "CO2", "p", "L", "H", "in", "Table", "A7", "M_CO2,c,L_CO2,c,H", "M_M_CO2,c,H^CO2,p,L_CO2,p,Hare_from_step_9_in_Table_A7"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Rp,L = MCO2,p,L ⁄ MCO2,c,L Rp,H = MCO2,p,H ⁄ MCO2,c,H MCO2,p,L, MCO2,c,L,MCO2,p,H and MCO2,c,H are from step 9 in Table A7/1 in this</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.5.1.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.5.1.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p440-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.5.1.2</data>
      <data key="d22">440</data>
      <data key="d60">[211.8, 190.3, 443.2, 240.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Ratio determination for each phase for vehicle Vind</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "M_CO2,c,ind", "symbol_text": "M_CO2,c,ind", "description": "from step 10 in Table A7/1 in this annex and shall be rounded to the nearest whole number.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">R_{p,ind}=R_{p,L}+ (M(M^{CO2,c,ind}-M-M_{CO2,c,L})/(CO2,c,H CO2,c,L)) * (R_{p,H}-R_{p,L})</data>
      <data key="d56">R_{p,ind}=R_{p,L}+ (M\frac{M^{CO2,c,ind}-M-M_{CO2,c,L}}{CO2,c,H CO2,c,L}) \cdot (R_{p,H}-R_{p,L})</data>
      <data key="d69">R_p,ind</data>
      <data key="d70">["R_p,ind", "R_p,L", "M", "CO2", "c", "M_CO2,c,L", "H", "L", "R_p,H"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">Rp,ind = Rp,L + (MCO2,c,ind −MCO2,c,L ) × (Rp,H −Rp,L) MCO2,c,H −MCO2,c,L</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.5.1.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.5.1.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p440-r3</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.5.1.3</data>
      <data key="d22">440</data>
      <data key="d60">[262.1, 290.9, 392.9, 325.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">Phase per phase mass emission of vehicle Vind</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">M_{CO2,p,ind}=R_{p,ind}* M_{CO2,c,ind}</data>
      <data key="d56">M_{CO2,p,ind}=R_{p,ind} \cdot M_{CO2,c,ind}</data>
      <data key="d69">M_CO2,p,ind</data>
      <data key="d70">["M_CO2,p,ind", "R_p,ind", "M_CO2,c,ind"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">MCO2,p,ind = Rp,ind × MCO2,c,ind</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.5.1.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.5.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p440-r4</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.5.2</data>
      <data key="d22">440</data>
      <data key="d60">[259.1, 357.7, 395.9, 392.5]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">road load coefficients may be calculated as follows:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_i(v) = f_{0,i}^{*}+ f_{1,A}* v + f_{2,i}^{*}* v_2</data>
      <data key="d56">F_{i}(v) = f_{0,i}^{\cdot}+ f_{1,A} \cdot v + f_{2,i}^{\cdot} \cdot v_{2}</data>
      <data key="d69">F_i(v)</data>
      <data key="d70">["F_i(v)", "f_0,i", "f_1,A", "v", "f_2,i", "v_2"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">Fi(v) = f0,i ∗+ f1,A × v + f2,i ∗× v 2</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.5.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.5.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p440-r5</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.5.2</data>
      <data key="d22">440</data>
      <data key="d60">[232.8, 427.5, 419.2, 478.8]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">as follows:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "E", "symbol_text": "E", "description": "the cycle energy demand as defined in paragraph 5. of this annex, Ws", "unit": null}, {"symbol": "i", "symbol_text": "i", "description": "the subscript denoting vehicles L, H or ind", "unit": null}, {"symbol": "HR", "symbol_text": "HR", "description": "test vehicle H as described in paragraph 4.2.1.2.3.2. of Annex B4", "unit": null}, {"symbol": "LR", "symbol_text": "LR", "description": "test vehicle L as described in paragraph 4.2.1.2.3.2. of Annex B4.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f_{1,A}=(E(^{i}^{LR}(E^{1,HR}-E^{HR})^{i}^{1,LR})/(HR LR)-E) * f+ (E-E) * f</data>
      <data key="d56">f_{1,A}=(E\frac{^{i}^{LR}(E^{1,HR}-E^{HR})^{i}^{1,LR}}{HR LR}-E) \cdot f+ (E-E) \cdot f</data>
      <data key="d69">f_1,A</data>
      <data key="d70">["f_1,A", "E", "i", "LR", "HR", "f"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">(Ei −ELR) × f1,HR + (EHR −Ei) × f1,LR f1,A = (EHR −ELR)</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.5.2.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p440-r6</data>
      <data key="d44">REG154.04.ANNEX-B7.3.3.1</data>
      <data key="d22">440</data>
      <data key="d60">[276.4, 616.7, 375.4, 668.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">PM shall be calculated using the following two equations:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">PM=(V(^{mix}V* d^{ep}^{e})/(ep)+ V) * P</data>
      <data key="d56">PM=(V\frac{^{mix}V \cdot d^{ep}^{e}}{ep}+ V) \cdot P</data>
      <data key="d69">PM</data>
      <data key="d70">["PM", "V", "ep", "e", "P"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">(Vmix + Vep) × Pe PM = Vep × d</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.3.1.EQ-2">
