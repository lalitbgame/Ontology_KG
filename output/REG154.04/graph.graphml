    <edge source="REG154.04.ANNEX-B4.5.2.2" target="REG154.04/EXT:ISO.612" id="0">
      <data key="d90">CITES</data>
      <data key="d91">definition_source</data>
      <data key="d92">ISO 612:1978</data>
      <data key="d93">The default road load force shall be calculated using the following equation: [EQ:REG154.04.ANNEX-B4.5.2.2.EQ-1] [EQ:REG154.04.ANNEX-B4.5.2.2.EQ-2] [EQ:REG154.04.ANNEX-B4.5.2.2.EQ-3] is the first order road load coefficient, N/(km/h), and shall be set to zero; is the second order road load coefficient, N/(km/h), defined by the following equation: is vehicle velocity, km/h; test mass, kg; width veh</data>
      <data key="d97">1978</data>
      <data key="d94">direct</data>
    </edge>
