      <data key="d21">5</data>
      <data key="d22">347</data>
      <data key="d23">348</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Pumps and flow controller to ensure constant uniform flow of diluted exhaust gas and dilution air samples taken during the course of the test from sampling Dilution air sample to: Vehicle exhaust Vent probes and flow of the gas samples shall be such that, at the end of each test, the quantity of the samples is sufficient for analysis.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
    <node id="REG154.04.ANNEX-B5.4.1.5.2.4">
      <data key="d0">Clause</data>
