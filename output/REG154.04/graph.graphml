      <data key="d56">P_{required ,j}=((f^{0} \cdot v^{j})+ (f^{1}3600 \cdot v^{j}^{2})+ (f^{2} \cdot v^{j}^{3})) +(kr \cdot a^{j}3600 \cdot v^{j} \cdot TM)</data>
