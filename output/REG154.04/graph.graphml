      <data key="d22">296</data>
      <data key="d60">[295.9, 164.0, 353.6, 207.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">and:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "m_av", "symbol_text": "m_av", "description": "the arithmetic average of the test vehicle masses at the beginning and end of road load determination, kg", "unit": "kg"}, {"symbol": "m_r", "symbol_text": "m_r", "description": "the equivalent effective mass of rotating components according to paragraph 2.5.1. of this annex; The coefficients, f_0, f_1 and f_2, in the road load equation shall be calculated with a least squares regression analysis.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δt_jb=(sum n n 1)/(i=1 tjbi)</data>
      <data key="d56">\Delta t_{jb}=\frac{\sum n n 1}{i=1 tjbi}</data>
      <data key="d69">Delta_t_jb</data>
      <data key="d70">["Delta_t_jb", "n", "i"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∆tjb = n 1 ∑ n i=1 tjbi</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.4.EQ-5.png</data>
    </node>
