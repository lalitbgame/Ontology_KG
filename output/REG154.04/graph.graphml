      <data key="d62">the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "EC_AC,CD", "symbol_text": "EC_AC ,CD", "description": "the utility factor-weighted charge-depleting electric energy consumption based on the recharged electric energy from the mains, Wh/km", "unit": "Wh/km"}, {"symbol": "UF_j", "symbol_text": "UF_j", "description": "the utility factor of phase j according to Appendix 5 to this annex", "unit": null}, {"symbol": "EC_AC_,CD,j", "symbol_text": "EC_AC ,CD,j", "description": "the electric energy consumption based on the recharged electric energy from the mains of phase j, Wh/km", "unit": "Wh/km"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">EC_{AC,CD}=(sum k j =1sum^{(UF} k j* EC UF AC,CD,j))/(j =1 j)</data>
      <data key="d56">EC_{AC,CD}=\frac{\sum k j =1\sum^{(UF} k j \cdot EC UF AC,CD,j)}{j =1 j}</data>
      <data key="d69">EC_AC,CD</data>
