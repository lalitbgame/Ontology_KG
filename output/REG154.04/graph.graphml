      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">speed is lower than 80 km/h, calculated using the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "n", "symbol_text": "n", "description": "the rotational frequency of the driven tyre, s^-1", "unit": null}, {"symbol": "α_j", "symbol_text": "α_j", "description": "the arithmetic average acceleration, m/s, calculated using the following equation:", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">r_j=3.6*2 * πn v^{jm}</data>
      <data key="d56">r_{j}=3.6 \cdot 2 \cdot \pi n v^{jm}</data>
      <data key="d69">r_j</data>
      <data key="d70">["r_j", "πn", "v", "jm"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">vjm rj = 3.6 × 2 × πn</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.4.3.1.EQ-3.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.4.3.1.EQ-4">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p303-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.4.4.3.1</data>
      <data key="d22">303</data>
