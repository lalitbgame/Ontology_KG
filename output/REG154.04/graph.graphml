      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">and:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Delta_E_REESS_,CS,n", "symbol_text": "∆E_REESS ,CS,n", "description": "the charge-sustaining REESS electric energy change of test n according to paragraph 1.1.2. of this appendix, Wh", "unit": "Wh"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">EC FC_{DC ,CS,avg}_{CS,nb,avg}EC_{DC ,CS,n}==(n)/(CS)(n)/(CS)1 1=ΔE(^{REESS,CS,n}d)/(CS,n)sum_{*sum n =1 n} sum^{*n =1 n} ^{CS}_CS EC FC_{DC ,CS,n}_{CS,nb,n}</data>
      <data key="d56">EC FC_{DC ,CS,avg}_{CS,nb,avg}EC_{DC ,CS,n}==\frac{n}{CS}\frac{n}{CS}1 1=\Delta E\frac{^{REESS,CS,n}d}{CS,n}\sum_{\cdot \sum n =1 n} \sum^{\cdot n =1 n} ^{CS}_{CS}EC FC_{DC ,CS,n}_{CS,nb,n}</data>
      <data key="d69">EC_FC_DC_,CS,avg_CS,nb,avgEC_DC_,CS,n</data>
      <data key="d70">["EC", "FC_DC_,CS,avg_CS,nb,avg", "EC_DC_,CS,n", "n", "CS", "Delta_E", "REESS", "sum_*sum_n_=1_n", "FC_DC_,CS,n_CS,nb,n", "EC_FC_DC_,CS,avg_CS,nb,avgEC_DC_,CS,n"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">1 nCS × ∑ ECDC ,CS,n ECDC ,CS,avg = nCS n =1 1 nCS × ∑ FCCS,nb,n FCCS,nb,avg = nCS n =1 ∆EREESS,CS,n ECDC ,CS,n = dCS,n</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.APP2.2.3.1.EQ-2.png</data>
