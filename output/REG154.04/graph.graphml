      <data key="d22">295</data>
      <data key="d60">[250.8, 630.2, 402.2, 679.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">be used:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">F_j=3.6* (m_av+ m_r) *2 * Δv(Δt)/(j)</data>
