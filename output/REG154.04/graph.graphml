    <node id="REG154.04.ANNEX-B4.4.2.1.2.3.4.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p288-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.4.2.1.2.3.4</data>
      <data key="d22">288</data>
      <data key="d60">[286.9, 80.7, 368.9, 152.3]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">vehicle H of that new road load family.</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "N", "symbol_text": "N", "description": "refers to the road load coefficients of the new road load family", "unit": null}, {"symbol": "R", "symbol_text": "R", "description": "refers to the road load coefficients of the reference road load family; Delta refers to the delta road load coefficients determined in paragraph 6.8.1. of this annex.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">f f f_{0,N}_{1,N}_{2,N}= f= f= f_{0,R}_{1,R}_{2,R}+ f+ f+ f_{1,Delta}_{0,Delta}_{2,Delta}</data>
      <data key="d56">f f f_{0,N}_{1,N}_{2,N}= f= f= f_{0,R}_{1,R}_{2,R}+ f+ f+ f_{1,Delta}_{0,Delta}_{2,Delta}</data>
      <data key="d69" />
      <data key="d70">["f", "f_0,N_1,N", "N", "f_0,R_1,R", "R", "f_1,Delta_0,Delta", "Delta", "f_1,Delta_0,Delta_2,Delta"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">f0,N = f0,R + f0,Delta f1,N = f1,R + f1,Delta f2,N = f2,R + f2,Delta</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.2.1.2.3.4.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.2.2.3.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p292-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.4.2.2.3.1</data>
      <data key="d22">292</data>
      <data key="d60">[282.4, 325.4, 403.4, 361.7]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Delta_p_t", "symbol_text": "∆p_t", "description": "the tyre pressure adjustment added to the tyre pressure defined in paragraph 4.2.2.3. of this annex, kPa", "unit": null}, {"symbol": "0.8", "symbol_text": "0.8", "description": "the pressure adjustment factor, kPa/°C", "unit": null}, {"symbol": "T_soak", "symbol_text": "T_soak", "description": "the tyre soaking temperature, °C", "unit": "°C"}, {"symbol": "T_amb", "symbol_text": "T_amb", "description": "the test ambient temperature, °C.", "unit": "°C"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δp_t=0.8 *(T_soak-T_amb)</data>
      <data key="d56">\Delta p_{t}=0.8 \cdot (T_{soak}-T_{amb})</data>
      <data key="d69">Delta_p_t</data>
      <data key="d70">["Delta_p_t", "T_soak-T_amb"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">∆pt = 0.8 × (Tsoak −Tamb)</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.2.2.3.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.1.4.2.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p294-r1</data>
      <data key="d44">REG154.04.ANNEX-B4.4.3.1.4.2</data>
      <data key="d22">294</data>
      <data key="d60">[276.4, 422.3, 380.2, 472.9]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">statistical precision pj defined in the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "p_j", "symbol_text": "p_j", "description": "the statistical precision of the measurements made at reference speed vj", "unit": null}, {"symbol": "n", "symbol_text": "n", "description": "the number of pairs of measurements", "unit": null}, {"symbol": "Delta_t_pj", "symbol_text": "∆t_pj", "description": "the harmonic average of the coastdown time at reference speed v j in seconds given by the following equation:", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65">Table A4/4.</data>
      <data key="d66" />
      <data key="d67">inequality</data>
      <data key="d68">p_j=(√n * Δt^{j})/(pj)h * σ&lt;=0.030</data>
      <data key="d56">p_{j}=\frac{√n \cdot \Delta t^{j}}{pj}h \cdot \sigma \le 0.030</data>
      <data key="d69">p_j</data>
      <data key="d70">["p_j", "n", "Delta_t", "j", "pj", "h", "σ"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">h × σj pj = ≤0.030 √n × ∆tpj</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.2.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.1.4.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p294-r2</data>
      <data key="d44">REG154.04.ANNEX-B4.4.3.1.4.2</data>
      <data key="d22">294</data>
      <data key="d60">[294.4, 564.1, 358.9, 623.0]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">seconds given by the following equation:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "Delta_t_ji", "symbol_text": "∆t_ji", "description": "the harmonic average coastdown time of the i^th pair of measurements at velocity v_j, seconds, s, given by the following equation:", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65">Table A4/4.</data>
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">Δt_pj=(sum)/(n i=1(Δt 1)/(ji))n</data>
      <data key="d56">\Delta t_{pj}=\frac{\sum}{n i=1\frac{\Delta t 1}{ji}}n</data>
      <data key="d69">Delta_t_pj</data>
      <data key="d70">["Delta_t_pj", "n", "i", "Delta_t", "ji"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">n ∆tpj = 1 ∑ ∆tji n i=1</data>
      <data key="d74">equations/REG154.04.ANNEX-B4.4.3.1.4.2.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B4.4.3.1.4.2.EQ-3">
