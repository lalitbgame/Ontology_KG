      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∑ (UFj × ECAC,CD,j ECAC,CD = k ) j =1 ∑ k UFj j =1</data>
      <data key="d74">equations/REG154.04.ANNEX-B8.4.3.1.EQ-1.png</data>
    </node>
