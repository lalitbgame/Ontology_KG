      <data key="d94">table</data>
    </edge>
    <edge source="REG154.04.ANNEX-B3.3.7" target="REG154.04/EXT:EN-ISO.20884" id="1">
      <data key="d90">CITES</data>
      <data key="d91">cites</data>
      <data key="d92">EN ISO 20884</data>
      <data key="d93">(c) In cases of national dispute concerning sulphur content, either EN ISO 20846 or EN ISO 20884 shall be called up (similar to the reference in the national Annex of EN228). (d) The actual sulphur content of the fuel used for the Type 1 test shall be recorded.</data>
      <data key="d94">footnote</data>
    </edge>
