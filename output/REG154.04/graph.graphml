      <data key="d8">Measured range values for OVC-HEVs</data>
      <data key="d24">[TABLE:REG154.04.ANNEX-C1.APP3.3.2.1.TABLE-U1] [EQ:REG154.04.ANNEX-C1.APP3.3.2.1.EQ-1]</data>
      <data key="d25" />
