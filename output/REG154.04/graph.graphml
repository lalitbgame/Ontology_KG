      <data key="d21">4</data>
      <data key="d22">347</data>
      <data key="d23">347</data>
      <data key="d28">True</data>
      <data key="d8" />
      <data key="d24">Figure A5/9 is a schematic drawing of the gaseous emissions sampling system. [FIGURE:REG154.04.ANNEX-B5.FIG-A5/9]</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Provision", "Paragraph"]</data>
      <data key="d29">ANNEX-B5</data>
    </node>
