      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">P P P t t_0_end_{m,j}_{m,j}_mi=sum ^{t}_t^{end}_0 P_mi</data>
      <data key="d56">P P P t t_{0}_{end}_{m,j}_{m,j}_{mi}=\sum ^{t}_{t}^{end}_{0}P_{mi}</data>
      <data key="d69">P_P_P_t_t_0_end_m,j_m,j_mi</data>
      <data key="d70">["P", "t", "t_0_end", "m", "j", "P_mi", "sum_^t_t^end_0_P_mi"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">𝑃𝑚,𝑗 = ∑ 𝑃𝑚𝑖 𝑡𝑒𝑛𝑑 𝑡0 𝑃𝑚,𝑗 𝑃𝑚𝑖 𝑡0 𝑡𝑒𝑛𝑑</data>
      <data key="d74">equations/REG154.04.ANNEX-B6b.3.4.EQ-1.png</data>
