    </node>
    <node id="REG154.04.ANNEX-B7.3.2.1.2.EQ-2">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p431-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.1.2</data>
      <data key="d22">431</data>
      <data key="d60">[274.1, 48.4, 381.7, 98.2]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">where:</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "H", "symbol_text": "H", "description": "the specific humidity, grams of water vapour per kilogram dry air", "unit": null}, {"symbol": "R_a", "symbol_text": "R_a", "description": "the relative humidity of the ambient air, per cent", "unit": "per cent"}, {"symbol": "P_d", "symbol_text": "P_d", "description": "the saturation vapour pressure at ambient temperature, kPa", "unit": null}, {"symbol": "P_B", "symbol_text": "P_B", "description": "the atmospheric pressure in the room, kPa.", "unit": null}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">H=(P-P* R^{a}* 10^{d}^{-2})/(B d a)6.211 * R* P</data>
      <data key="d56">H=\frac{P-P \cdot R^{a} \cdot 10^{d}^{-2}}{B d a}6.211 \cdot R \cdot P</data>
      <data key="d69">H</data>
      <data key="d70">["H", "P", "R", "a", "B"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">6.211 × Ra × Pd H = PB −Pd × Ra × 10−2</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.1.2.EQ-2.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.2.1.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p431-r2</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.2.1</data>
      <data key="d22">431</data>
      <data key="d60">[170.4, 279.6, 357.7, 403.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">equation:</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">int_{C_e} _t_t_1_2 C_HC dt C_e=int (^{t}t^{1}-t^{HC})/(2 1)^{t}^{2}C dt</data>
      <data key="d56">\int_{C_{e}} _{t}_{t}_{1}_{2}C_{HC}dt C_{e}=\int \frac{^{t}t^{1}-t^{HC}}{2 1}^{t}^{2}C dt</data>
      <data key="d69">int_C_e__t_t_1_2_C_HC_dt_C_e</data>
      <data key="d70">["int_C_e", "C_HC", "C_e", "t", "HC", "C"]</data>
      <data key="d71" />
      <data key="d72">partial</data>
      <data key="d73">∫ CHC dt t2 Ce = t1 t2 −t1 ∫ CHCdt t2 t1 Ce</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.2.1.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.3.2.2.2.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
      <data key="d59">p432-r1</data>
      <data key="d44">REG154.04.ANNEX-B7.3.2.3.2.2.2.3</data>
      <data key="d22">432</data>
      <data key="d60">[170.4, 459.0, 442.5, 529.1]</data>
      <data key="d40">text_layer</data>
      <data key="d61">False</data>
      <data key="d62">3.2.3.2.2.2.3. Calculating the weighted mean of the rolling resistances</data>
      <data key="d63" />
      <data key="d64">[]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">x RR_x=(RR_{x,FA}* mp_{x,FA}) + (RR_{x,RA}* (1 -mp_{x,FA}))</data>
      <data key="d56">x RR_{x}=(RR_{x,FA} \cdot mp_{x,FA}) + (RR_{x,RA} \cdot (1 -mp_{x,FA}))</data>
      <data key="d69" />
      <data key="d70">["x", "RR_x", "RR_x,FA", "mp_x,FA", "RR_x,RA"]</data>
      <data key="d71" />
      <data key="d72">parsed</data>
      <data key="d73">RRx = (RRx,FA × mpx,FA) + (RRx,RA × (1 −mpx,FA)) x</data>
      <data key="d74">equations/REG154.04.ANNEX-B7.3.2.3.2.2.2.3.EQ-1.png</data>
    </node>
    <node id="REG154.04.ANNEX-B7.3.2.3.2.2.3.3.EQ-1">
      <data key="d0">Equation</data>
      <data key="d1">REG154.04</data>
