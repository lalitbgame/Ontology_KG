      <data key="d62">and</data>
      <data key="d63" />
      <data key="d64">[{"symbol": "U_REESS,i(t)", "symbol_text": "U_REESS,i(t)", "description": "the voltage of battery i, in V", "unit": null}, {"symbol": "I_REESS,i(t)", "symbol_text": "I_REESS,i(t)", "description": "the current of battery i, in A", "unit": null}, {"symbol": "t_start,CC", "symbol_text": "t_start,CC", "description": "the time at the beginning of the confirmation cycle of the chargedepleting test, s", "unit": "s"}]</data>
      <data key="d28">True</data>
      <data key="d65" />
      <data key="d66" />
      <data key="d67">equation</data>
      <data key="d68">ΔE_{REESS,avg,i,CC}=(3600)/(*int ^{t})1_t_{start,CC}(t-t)/(^{end,CC}^{end,CC}(int ^{t}^{start,CC}U)*_t_{start,CC}1_{REESS,i}(τ) * I_{REESS,i}(τ)dτ)dt</data>
      <data key="d56">\Delta E_{REESS,avg,i,CC}=\frac{3600}{\cdot \int ^{t}}1_{t}_{start,CC}\frac{t-t}{^{end,CC}^{end,CC}(\int ^{t}^{start,CC}U} \cdot _{t}_{start,CC}1_{REESS,i}(τ) \cdot I_{REESS,i}(τ)dτ)dt</data>
      <data key="d69">Delta_E_REESS,avg,i,CC</data>
