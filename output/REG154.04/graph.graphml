      <data key="d64">[{"symbol": "G_gas", "symbol_text": "Ggas", "description": "the gas energy ratio, per cent", "unit": "per cent"}, {"symbol": "Mgas", "symbol_text": "Mgas", "description": "the mass of the gaseous fuel consumed during the cycle, kg", "unit": "kg"}, {"symbol": "FCnorm", "symbol_text": "FCnorm", "description": "the fuel consumption (l/100km for LPG, m /100 km for NG/biomethane) calculated in accordance with paragraphs 6.6. and 6.7. of Annex B7", "unit": null}, {"symbol": "dist", "symbol_text": "dist", "description": "the distance recorded during the cycle, km", "unit": "km"}, {"symbol": "ρ", "symbol_text": "ρ", "description": "the gas density: ρ = 0.654 kg/m for NG/Biomethane; ρ = 0.538 kg/litre for LPG", "unit": null}, {"symbol": "cf", "symbol_text": "cf", "description": "the correction factor, assuming the following values: cf = 1 in the case of LPG or G20 reference fuel; cf = 0.78 in the case of G25 reference fuel.", "unit": null}]</data>
