      <data key="d56">M_{CO}_{2}_{-ind}= M_{CO}_{2}_{-L}+ (E\frac{E^{3}-E^{1}}{2 1}-E) \cdot (M_{CO}_{2}_{-H}-M_{CO}_{2}_{-L})</data>
