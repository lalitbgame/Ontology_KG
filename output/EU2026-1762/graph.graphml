      <data key="d69">(3) As defined in Article 4 of Regulation (EU) 2018/858.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ANNEX-II.APP-2" target="EU2026-1762/EXT:EU.REG.2018-858#ART-3.24" id="0">
