    <edge source="EU2026-1762.ANNEX-I.2.2" target="EU2026-1762/EXT:UNR-179#ANNEX-1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">Annex 1 to UN Regulation No 179</data>
      <data key="d69">The information specified in Annex 1 to UN Regulation No 179, shall be included at the various stages of the brake emission approval as described in Figure A1/1 thereof (‘Overview of the different reports during brake emission approval’).</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ANNEX-I.2.2" target="EU2026-1762/EXT:UNR-179#FIGURE-A1/1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">Figure A1/1 thereof</data>
      <data key="d69">The information specified in Annex 1 to UN Regulation No 179, shall be included at the various stages of the brake emission approval as described in Figure A1/1 thereof (‘Overview of the different reports during brake emission approval’).</data>
      <data key="d70">back_reference</data>
    </edge>
