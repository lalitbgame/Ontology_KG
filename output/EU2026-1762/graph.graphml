      <data key="d69">Appendix 2 of Annex 1 to UN Regulation No 179 shall apply to individual friction braking share coefficient (c-factor) test report.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ANNEX-I.APP-3" target="EU2026-1762/EXT:UNR-179#ANNEX-1.APP-3" id="0">
