    <node id="EU2026-1762.STANDARD">
      <data key="d0">Standard</data>
      <data key="d1">EU2026-1762</data>
      <data key="d2">Commission Implementing Regulation (EU) 2026/1762 (brake particle emissions)</data>
      <data key="d3">2026/1762</data>
      <data key="d4">European Union</data>
      <data key="d5">European Commission</data>
      <data key="d6">eu_oj_act</data>
