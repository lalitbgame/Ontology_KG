    <node id="EU2026-1762.ANNEX-I.APP-2">
      <data key="d0">Appendix</data>
      <data key="d1">EU2026-1762</data>
      <data key="d17">Appendix</data>
      <data key="d18">appendix</data>
      <data key="d19">EU2026-1762.ANNEX-I</data>
      <data key="d20">2</data>
      <data key="d21">1</data>
      <data key="d22">6</data>
      <data key="d23">6</data>
      <data key="d28">True</data>
      <data key="d8">Individual Friction Braking Share Coefficient (c-factor) Test Report</data>
      <data key="d24">Appendix 2 of Annex 1 to UN Regulation No 179 shall apply to individual friction braking share coefficient (c-factor) test report. The individual friction braking share coefficient (c-factor) test report shall be repeated as applicable for each individual vehicle measurement.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Appendix", "Paragraph"]</data>
      <data key="d27">2</data>
      <data key="d29">ANNEX-I</data>
    </node>
