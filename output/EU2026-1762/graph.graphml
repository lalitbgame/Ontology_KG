    <edge source="EU2026-1762.ART-4.1" target="EU2026-1762/EXT:EU.REG.2024-1257#ART-7.1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">requirement_source</data>
      <data key="d68">Articles 7(1) and 10(1) of Regulation (EU) 2024/1257</data>
      <data key="d69">For the purpose of testing in accordance with Articles 7(1) and 10(1) of Regulation (EU) 2024/1257, manufacturers, the technical services and the granting type-approval authorities shall use the templates and models, test procedures and test reports set out in Annexes I, II and III to this Regulation.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-4.1" target="EU2026-1762/EXT:EU.REG.2024-1257#ART-10.1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">requirement_source</data>
      <data key="d68">Articles 7(1) and 10(1) of Regulation (EU) 2024/1257</data>
      <data key="d69">For the purpose of testing in accordance with Articles 7(1) and 10(1) of Regulation (EU) 2024/1257, manufacturers, the technical services and the granting type-approval authorities shall use the templates and models, test procedures and test reports set out in Annexes I, II and III to this Regulation.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-4.2" target="EU2026-1762.ANNEX-II.APP-2" id="0">
      <data key="d66">REFERENCES</data>
      <data key="d71">appendix</data>
      <data key="d68">Appendix 2 to Annex II</data>
    </edge>
    <edge source="EU2026-1762.ART-4.2" target="EU2026-1762/EXT:EU.REG.2024-1257#ART-10.1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">requirement_source</data>
      <data key="d68">Article 10(1) of Regulation (EU) 2024/1257</data>
      <data key="d69">For the purpose of granting an emission type-approval in accordance with Article 10(1) of Regulation (EU) 2024/1257 and issuing the corresponding certificate, the approval authority shall use the model set out in Appendix 2 to Annex II to this Regulation.</data>
      <data key="d70">direct</data>
    </edge>
