    <edge source="EU2026-1762.ART-2.1" target="EU2026-1762/EXT:EU.REG.2024-1257#ART-4.2" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">Article 4(2) of Regulation (EU) 2024/1257</data>
      <data key="d69">For the purposes of emission type-approval under Article 4(2) of Regulation (EU) 2024/1257, the manufacturer shall demonstrate that the brake system complies with all of the following: (a) the combination of brake corner emission families on a front and rear axle forms part of the same vehicle type with regard to brake emissions, as defined in paragraph 3.0 of UN Regulation No 179;</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-2.1" target="EU2026-1762/EXT:UNR-179#3.0" id="0">
      <data key="d66">CITES</data>
      <data key="d67">definition_source</data>
      <data key="d68">paragraph 3.0 of UN Regulation No 179</data>
      <data key="d69">For the purposes of emission type-approval under Article 4(2) of Regulation (EU) 2024/1257, the manufacturer shall demonstrate that the brake system complies with all of the following: (a) the combination of brake corner emission families on a front and rear axle forms part of the same vehicle type with regard to brake emissions, as defined in paragraph 3.0 of UN Regulation No 179;</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-2.1" target="EU2026-1762/EXT:UNR-179#7" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">paragraphs 7 and 8 of UN Regulation No 179</data>
      <data key="d69">(ii) paragraphs 7 and 8 of UN Regulation No 179.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-2.1" target="EU2026-1762/EXT:UNR-179#8" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">paragraphs 7 and 8 of UN Regulation No 179</data>
      <data key="d69">(ii) paragraphs 7 and 8 of UN Regulation No 179.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-2.2" target="EU2026-1762.ANNEX-III" id="0">
      <data key="d66">REFERENCES</data>
      <data key="d71">annex</data>
      <data key="d68">Annex III</data>
    </edge>
    <edge source="EU2026-1762.ART-3" target="EU2026-1762.ANNEX-II.APP-1" id="0">
      <data key="d66">REFERENCES</data>
      <data key="d71">appendix</data>
      <data key="d68">Appendix 1 of Annex II</data>
    </edge>
    <edge source="EU2026-1762.ART-3" target="EU2026-1762/EXT:EU.REG.2024-1257#ART-14.1" id="0">
      <data key="d66">CITES</data>
      <data key="d67">cites</data>
      <data key="d68">Article 14(1) of Regulation (EU) 2024/1257</data>
      <data key="d69">The manufacturer shall submit to the granting type-approval authority an application for emission type-approval of a brake system under Article 14(1) of Regulation (EU) 2024/1257 and Table 11 of Annex V thereto, drawn up in accordance with the model information document set out in Appendix 1 of Annex II to this Regulation.</data>
      <data key="d70">direct</data>
    </edge>
    <edge source="EU2026-1762.ART-3" target="EU2026-1762/EXT:EU.REG.2024-1257#ANNEX-V.TABLE-11" id="0">
      <data key="d66">CITES</data>
      <data key="d67">requirement_source</data>
      <data key="d68">Table 11 of Annex V thereto</data>
      <data key="d69">The manufacturer shall submit to the granting type-approval authority an application for emission type-approval of a brake system under Article 14(1) of Regulation (EU) 2024/1257 and Table 11 of Annex V thereto, drawn up in accordance with the model information document set out in Appendix 1 of Annex II to this Regulation.</data>
      <data key="d70">back_reference</data>
    </edge>
