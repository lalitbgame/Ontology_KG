      <data key="d20">3</data>
      <data key="d21">1</data>
      <data key="d22">7</data>
      <data key="d23">7</data>
      <data key="d28">True</data>
      <data key="d8">Vehicle Type Compliance Demonstration Report</data>
      <data key="d24">Appendix 3 of Annex 1 to UN Regulation No 179 shall apply to vehicle type compliance demonstration report.</data>
      <data key="d25" />
      <data key="d26">True</data>
      <data key="d7">["Appendix", "Paragraph"]</data>
      <data key="d27">3</data>
      <data key="d29">ANNEX-I</data>
    </node>
